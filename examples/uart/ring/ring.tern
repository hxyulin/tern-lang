// A fixed-capacity byte queue. One slot always stays empty, so a full ring
// can be told apart from an empty one.

let capacity: usize = 64

pub type Ring (
    buf: [capacity]u8,
    head: usize,
    tail: usize,
)

// Global initializers must be constant, and Ring's fields are private, so
// another package cannot write Ring.(...) itself. It starts from this value.
pub let empty: Ring = Ring.(buf: fill[capacity](0), head: 0, tail: 0)

// Returns false when the ring is full; the byte is dropped.
pub fn push(r: inout Ring, b: u8) -> bool {
    let next: usize = (r.head + 1) % capacity
    if next == r.tail {
        return false
    }
    r.buf[r.head] = b
    r.head = next
    return true
}

pub fn pop(r: inout Ring) -> ?u8 {
    if r.tail == r.head {
        return none
    }
    let b: u8 = r.buf[r.tail]
    r.tail = (r.tail + 1) % capacity
    return some.(value: b)
}
