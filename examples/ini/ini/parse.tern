// Parses one line of an INI file. Every view in a Line points into the
// line that was passed in.
//
//   [section]
//   key = value
//   ; comment, or # comment

pub type Line enum {
    blank
    section(name: []u8)
    pair(key: []u8, value: []u8)
}

pub type ParseError enum {
    missing_equals
    empty_key
    unclosed_section
}

// Iterates over the lines of a text, without their '\n'.
pub type Lines (rest: []u8)

pub fn lines(text: []u8) -> Lines {
    return Lines.(rest: text)
}

pub fn next(it: inout Lines) -> ?[]u8 {
    if it.rest.len == 0 {
        return none
    }
    match index_of(it.rest, '\n') {
        some(value as end: usize) {
            let line: []u8 = it.rest[..end]
            it.rest = it.rest[end + 1..]
            return some.(value: line)
        }
        none {
            let line: []u8 = it.rest
            it.rest = it.rest[it.rest.len..]
            return some.(value: line)
        }
    }
}

pub fn parse_line(line: []u8) -> Line ! ParseError {
    let t: []u8 = trim(strip_comment(line))
    if t.len == 0 {
        return ok.(value: Line.blank)
    }
    if t[0] == '[' {
        if t[t.len - 1] != ']' {
            return err.(error: ParseError.unclosed_section)
        }
        let name: []u8 = trim(t[1..t.len - 1])
        return ok.(value: Line.section.(name: name))
    }
    match index_of(t, '=') {
        none {
            return err.(error: ParseError.missing_equals)
        }
        some(value as eq: usize) {
            let key: []u8 = trim(t[..eq])
            if key.len == 0 {
                return err.(error: ParseError.empty_key)
            }
            let rest: []u8 = trim(t[eq + 1..])
            return ok.(value: Line.pair.(key: key, value: rest))
        }
    }
}

fn strip_comment(s: []u8) -> []u8 {
    for let i: usize in 0..s.len {
        match s[i] {
            ';', '#' {
                return s[..i]
            }
            _ {
            }
        }
    }
    return s
}

fn trim(s: []u8) -> []u8 {
    var a: usize = 0
    var b: usize = s.len
    for a < b && is_space(s[a]) {
        a += 1
    }
    for b > a && is_space(s[b - 1]) {
        b -= 1
    }
    return s[a..b]
}

fn is_space(c: u8) -> bool {
    return c == ' ' || c == '\t' || c == '\r'
}

fn index_of(s: []u8, c: u8) -> ?usize {
    for let i: usize in 0..s.len {
        if s[i] == c {
            return some.(value: i)
        }
    }
    return none
}
