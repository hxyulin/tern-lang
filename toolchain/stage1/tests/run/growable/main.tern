// Growable arrays: make, push, append, views of them, and free.

import std.heap
import std.io

fn sum(v: []u32) -> u32 {
    var s: u32 = 0
    for let x: u32 in v {
        s += x
    }
    return s
}

fn build(alloc: Allocator, n: u32) -> [..]u32 ! OutOfMemory {
    var out: [..]u32 = make(alloc)
    for let i: u32 in 0..n {
        match push(inout out, i * i) {
            ok {
            }
            err(error: OutOfMemory) {
                free(inout out)
                return err.(error: error)
            }
        }
    }
    return ok.(value: out)
}

fn run() -> ! OutOfMemory {
    var squares: [..]u32 = try build(heap.c_allocator, 100)
    defer free(inout squares)
    io.print("{squares.len} {sum(squares)} {squares[99]}\n")
    var text: [..]u8 = make(heap.c_allocator)
    defer free(inout text)
    try append(inout text, "abc")
    try append(inout text, "defgh")
    try push(inout text, '!')
    let view: []u8 = text
    io.print("{view} {text.len} {view[2..5]}\n")
    try pops(heap.c_allocator)
    return ok
}

// pop, clear, take, repeated free, and locals that take built-in
// function names.
fn pops(alloc: Allocator) -> ! OutOfMemory {
    var stack: [..]u32 = make(alloc)
    defer free(inout stack)
    for let i: u32 in 1..4 {
        try push(inout stack, i * 10)
    }
    let push: u32 = 7
    var offset: u32 = 0
    for {
        match pop(inout stack) {
            some(value: u32) {
                offset += value + push
            }
            none {
                break
            }
        }
    }
    io.print("popped {offset} left {stack.len}\n")
    try push(inout stack, 5)
    try push(inout stack, 6)
    clear(inout stack)
    match pop(inout stack) {
        some(value: _) {
            io.print("not empty\n")
        }
        none {
            io.print("cleared {stack.len}\n")
        }
    }
    var words: [..][..]u8 = make(alloc)
    defer free(inout words)
    let sources: [2][]u8 = ["ab", "cde"]
    var owned: [..]u8 = make(alloc)
    defer free(inout owned)
    for let w: []u8 in sources {
        try append(inout owned, w)
        // take hands the buffer over and leaves owned empty, so it can
        // grow again and the deferred free has nothing to free.
        try push(inout words, take(inout owned))
    }
    for {
        match pop(inout words) {
            some(value as var word: [..]u8) {
                let view: []u8 = word
                io.print("word {view} ")
                free(inout word)
            }
            none {
                break
            }
        }
    }
    io.print("\n")
    // free leaves the array empty, so freeing it twice does nothing.
    try push(inout stack, 1)
    free(inout stack)
    free(inout stack)
    io.print("freed {stack.len}\n")
    return ok
}

fn main() -> u8 {
    match run() {
        ok {
            return 0
        }
        err(error: _) {
            return 1
        }
    }
}
