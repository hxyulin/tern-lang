// Branches, matches, loops and iterators.

import std.io

type Shape enum {
    circle(radius: u32)
    rect(w: u32, h: u32)
    empty
}

type Countdown (n: u32)

fn next(it: inout Countdown) -> ?u32 {
    if it.n == 0 {
        return none
    }
    it.n -= 1
    return some.(value: it.n)
}

fn area(s: Shape) -> u32 {
    return match s {
        circle(radius: u32) { 3 * radius * radius }
        rect(w: u32, h: u32) { w * h }
        empty { 0 }
    }
}

fn classify(n: i32) -> []u8 {
    match n {
        0 {
            return "zero"
        }
        1, 2, 3 {
            return "small"
        }
        -1 {
            return "minus one"
        }
        _ {
            return if n < 0 { "negative" } else { "large" }
        }
    }
}

fn main() -> u8 {
    let shapes: [3]Shape = [Shape.circle.(radius: 2), Shape.rect.(w: 3, h: 4), Shape.empty]
    var total: u32 = 0
    for let s: Shape in shapes {
        total += area(s)
    }
    io.print("total {total}\n")
    for let n: i32 in -2..5 {
        io.print("{n}:{classify(n)} ")
    }
    io.print("\n")
    var i: u32 = 0
    var odd: u32 = 0
    for {
        i += 1
        if i > 9 {
            break
        }
        if i % 2 == 0 {
            continue
        }
        odd += i
    }
    io.print("odd {odd}\n")
    for let k: u32 in Countdown.(n: 3) {
        io.print("{k} ")
    }
    io.print("\n")
    let word: []u8 = "hello"
    match word {
        "hello" {
            io.print("matched hello\n")
        }
        _ {
            io.print("no match\n")
        }
    }
    return 0
}
