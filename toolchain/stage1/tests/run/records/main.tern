// Records, newtypes, optionals and results, passed in and out of calls.

import std.io

type Point (x: i32, y: i32)
type Rect (min: Point, max: Point)
type Meters u32

type ParseError enum {
    empty
    bad_digit(at: usize)
}

fn width(r: Rect) -> i32 {
    return r.max.x - r.min.x
}

fn grow(r: inout Rect, by: i32) {
    r.min.x -= by
    r.min.y -= by
    r.max = Point.(x: r.max.x + by, y: r.max.y + by)
}

fn swap(p: Point) -> Point {
    let (x: i32, y: i32) = p
    return Point.(x: y, y: x)
}

fn parse(s: []u8) -> u32 ! ParseError {
    if s.len == 0 {
        return err.(error: ParseError.empty)
    }
    var n: u32 = 0
    for let i: usize in 0..s.len {
        let c: u8 = s[i]
        if c < '0' || c > '9' {
            return err.(error: ParseError.bad_digit.(at: i))
        }
        n = n * 10 + u32.(c - '0')
    }
    return ok.(value: n)
}

fn doubled(s: []u8) -> u32 ! ParseError {
    let n: u32 = try parse(s)
    return ok.(value: n * 2)
}

fn show(s: []u8) {
    match doubled(s) {
        ok(value: u32) {
            io.print("{s} -> {value}\n")
        }
        err(error: ParseError) {
            match error {
                empty {
                    io.print("empty\n")
                }
                bad_digit(at: usize) {
                    io.print("{s}: bad digit at {at}\n")
                }
            }
        }
    }
}

fn first_even(v: []u32) -> ?u32 {
    for let x: u32 in v {
        if x % 2 == 0 {
            return some.(value: x)
        }
    }
    return none
}

fn main() -> u8 {
    var r: Rect = Rect.(min: Point.(x: 1, y: 2), max: Point.(x: 4, y: 6))
    io.print("{width(r)}\n")
    grow(inout r, 2)
    io.print("{r.min.x} {r.min.y} {r.max.x} {r.max.y} {width(r)}\n")
    let p: Point = swap(r.max)
    io.print("{p.x} {p.y}\n")
    let d: Meters = 5
    io.print("{u32.(d) + 1}\n")
    show("21")
    show("")
    show("4x2")
    let odds: [3]u32 = [1, 3, 5]
    let mixed: [3]u32 = [1, 4, 6]
    match first_even(odds) {
        some(value: u32) {
            io.print("even {value}\n")
        }
        none {
            io.print("no even\n")
        }
    }
    match first_even(mixed) {
        some(value: u32) {
            io.print("even {value}\n")
        }
        none {
            io.print("no even\n")
        }
    }
    return 0
}
