// ternc, the tern compiler, written in tern:
//
//   ternc lex FILE               prints each token as stage 1 does
//   ternc parse FILE             prints the syntax tree as stage 1 does
//   ternc check DIR --std DIR    reports errors as stage 1 does
//   ternc build DIR --std DIR    builds an executable through keel's C API,
//                                with stage 1's options
//
// It links with keel's C API, keel-ffi's static library.

import std.fs
import std.heap
import std.io
import std.os
import check
import gen
import keel
import program
import resolve
import sexp
import std.utf8
import syntax

let usage_text: []u8 = "usage: ternc lex FILE\n       ternc parse FILE\n       ternc check DIR --std DIR\n       ternc build DIR --std DIR [FILE.a|FILE.o ...] [-l NAME] [-o OUT] [-O] [-S] [--ir]\n"

fn main() -> u8 {
    let args: [][]u8 = os.args()
    if args.len >= 2 {
        match args[1] {
            "build" {
                return build_command(args[2..])
            }
            _ {
            }
        }
    }
    if args.len == 5 {
        match args[1] {
            "check" {
                match args[3] {
                    "--std" {
                        return check_command(args[2], args[4])
                    }
                    _ {
                    }
                }
            }
            _ {
            }
        }
    }
    if args.len == 3 {
        match args[1] {
            "lex" {
                return run_file(args[2], Command.lex)
            }
            "parse" {
                return run_file(args[2], Command.parse)
            }
            _ {
            }
        }
    }
    io.eprint("{usage_text}")
    return 2
}

// Loads the package in root and everything it imports, and reports
// errors: parse, import, name and type errors.
fn check_command(root: []u8, std_dir: []u8) -> u8 {
    var arena: heap.Arena = heap.new_arena(heap.c_allocator)
    defer heap.free_arena(inout arena)
    match check_program(heap.arena_allocator(&arena), root, std_dir) {
        ok(value as code: u8) {
            return code
        }
        err(error: _) {
            io.eprint("ternc: out of memory\n")
            return 1
        }
    }
}

fn check_program(alloc: Allocator, root: []u8, std_dir: []u8) -> u8 ! OutOfMemory {
    let p: program.Program = try program.load(alloc, root, std_dir)
    if program.has_errors(p) {
        render_program(p)
        return ok.(value: 1)
    }
    let names: resolve.Resolution = try resolve.resolve(alloc, p)
    if names.diagnostics.len > 0 {
        render_diagnostics(p, names.diagnostics)
        return ok.(value: 1)
    }
    let checked: check.Checked = try check.check(alloc, p, names)
    if checked.diagnostics.len > 0 {
        render_diagnostics(p, checked.diagnostics)
        return ok.(value: 1)
    }
    io.print("{p.packages.len} packages, {p.files.len} files\n")
    return ok.(value: 0)
}

// What `ternc build` was asked for.
type BuildOptions (
    root: []u8,
    std_dir: []u8,
    out: ?[]u8,
    optimize: bool,
    assembly_only: bool,
    ir_only: bool,
    // Static archives and object files linked with the program.
    link: [..][]u8,
    // System libraries, as in `-l NAME`.
    libraries: [..][]u8,
)

fn ends_with(text: []u8, suffix: []u8) -> bool {
    if text.len < suffix.len {
        return false
    }
    return program.bytes_equal(text[text.len - suffix.len..], suffix)
}

fn is_link_input(arg: []u8) -> bool {
    return ends_with(arg, ".a") || ends_with(arg, ".A") || ends_with(arg, ".o") || ends_with(arg, ".O")
}

// Builds an executable, or the assembly or IR the options ask for.
fn build_command(args: [][]u8) -> u8 {
    var arena: heap.Arena = heap.new_arena(heap.c_allocator)
    defer heap.free_arena(inout arena)
    let alloc: Allocator = heap.arena_allocator(&arena)
    var o: BuildOptions = BuildOptions.(root: "", std_dir: "", out: none, optimize: false, assembly_only: false, ir_only: false, link: make(alloc), libraries: make(alloc))
    var has_root: bool = false
    var has_std: bool = false
    var i: usize = 0
    for i < args.len {
        let arg: []u8 = args[i]
        i += 1
        match arg {
            "-o", "--std", "-l" {
                if i >= args.len {
                    io.eprint("{usage_text}")
                    return 2
                }
                let value: []u8 = args[i]
                i += 1
                match arg {
                    "-o" {
                        o.out = some.(value: value)
                    }
                    "--std" {
                        o.std_dir = value
                        has_std = true
                    }
                    _ {
                        if !pushed(inout o.libraries, value) {
                            return out_of_memory()
                        }
                    }
                }
                continue
            }
            "-O" {
                o.optimize = true
                continue
            }
            "-S" {
                o.assembly_only = true
                continue
            }
            "--ir" {
                o.ir_only = true
                continue
            }
            _ {
            }
        }
        if arg.len > 2 && arg[0] == '-' && arg[1] == 'l' {
            if !pushed(inout o.libraries, arg[2..]) {
                return out_of_memory()
            }
        } else if is_link_input(arg) {
            if !pushed(inout o.link, arg) {
                return out_of_memory()
            }
        } else if !has_root {
            o.root = arg
            has_root = true
        } else {
            io.eprint("{usage_text}")
            return 2
        }
    }
    if !has_root || !has_std {
        io.eprint("{usage_text}")
        return 2
    }
    match build_program(alloc, o) {
        ok(value as code: u8) {
            return code
        }
        err(error: _) {
            return out_of_memory()
        }
    }
}

fn pushed(list: inout [..][]u8, item: []u8) -> bool {
    return match push(inout list, item) {
        ok { true }
        err(error: _) { false }
    }
}

fn out_of_memory() -> u8 {
    io.eprint("ternc: out of memory\n")
    return 1
}

// The last part of a path.
fn base_name(path: []u8) -> []u8 {
    var start: usize = path.len
    for start > 0 && path[start - 1] != '/' {
        start -= 1
    }
    return path[start..]
}

fn build_program(alloc: Allocator, o: BuildOptions) -> u8 ! OutOfMemory {
    let p: program.Program = try program.load_hosted(alloc, o.root, o.std_dir)
    if program.has_errors(p) {
        render_program(p)
        return ok.(value: 1)
    }
    let names: resolve.Resolution = try resolve.resolve(alloc, p)
    if names.diagnostics.len > 0 {
        render_diagnostics(p, names.diagnostics)
        return ok.(value: 1)
    }
    let checked: check.Checked = try check.check(alloc, p, names)
    if checked.diagnostics.len > 0 {
        render_diagnostics(p, checked.diagnostics)
        return ok.(value: 1)
    }
    // The root directory's name prefixes the root package's symbols and
    // names the executable.
    var root_name: ?[]u8 = none
    match fs.real_path(alloc, o.root) {
        ok(value as found: ?[..]u8) {
            match found {
                some(value as path: [..]u8) {
                    root_name = some.(value: base_name(path))
                }
                none {
                }
            }
        }
        err(error: _) {
        }
    }
    let symbol_prefix: []u8 = match root_name {
        some(value as n: []u8) { n }
        none { "main" }
    }
    var out: []u8 = match root_name {
        some(value as n: []u8) { n }
        none { "a.out" }
    }
    if o.assembly_only {
        out = try program.format_text(alloc, "{out}.s")
    }
    match o.out {
        some(value as given: []u8) {
            out = given
        }
        none {
        }
    }
    match try gen.generate(alloc, p, names, checked, symbol_prefix) {
        unsupported(message: []u8) {
            io.eprint("{message}\n")
            return ok.(value: 1)
        }
        module(m: keel.Module) {
            defer keel.destroy(m)
            return emit(alloc, m, o, out)
        }
    }
}

fn write_file(path: []u8, bytes: []u8) -> u8 {
    match io.create(path) {
        ok(value as var f: io.File) {
            defer io.close(inout f)
            match io.write_all(f, bytes) {
                ok {
                    return 0
                }
                err(error: io.Error) {
                    io.eprint("cannot write {path}: {io.describe(error)}\n")
                    return 1
                }
            }
        }
        err(error: io.Error) {
            io.eprint("cannot write {path}: {io.describe(error)}\n")
            return 1
        }
    }
}

// Writes the IR, the assembly or the executable.
fn emit(alloc: Allocator, m: keel.Module, o: BuildOptions, out: []u8) -> u8 ! OutOfMemory {
    keel.verify(m)
    if o.ir_only {
        let text: [..]u8 = try keel.emit_ir(alloc, m)
        return ok.(value: write_file(out, text))
    }
    var options: keel.CodegenOptions = keel.CodegenOptions.(selection: 0, allocation: 0, goal: 0, unwind: 0, x86_code_model: 0, flags: 0)
    if o.optimize {
        keel.optimize(m, 5)
        options.selection = 3
    }
    if o.assembly_only {
        let text: [..]u8 = try keel.emit_assembly(alloc, m, keel.aarch64_apple_darwin, options)
        return ok.(value: write_file(out, text))
    }
    let object: [..]u8 = try keel.emit_object(alloc, m, keel.aarch64_apple_darwin, options)
    return link(alloc, object, o, out)
}

// The macOS SDK: SDKROOT, or the Command Line Tools' SDK.
fn macos_sdk(alloc: Allocator) -> ?[]u8 ! OutOfMemory {
    match os.env("SDKROOT") {
        some(value as root: []u8) {
            if root.len > 0 {
                return ok.(value: some.(value: root))
            }
        }
        none {
        }
    }
    let tools: []u8 = "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk"
    match fs.real_path(alloc, tools) {
        ok(value as found: ?[..]u8) {
            match found {
                some(value: _) {
                    return ok.(value: some.(value: tools))
                }
                none {
                }
            }
        }
        err(error: _) {
        }
    }
    return ok.(value: none)
}

// Links the program's object, the extra archives and objects, libSystem
// and the `-l` libraries into the signed executable out.
fn link(alloc: Allocator, object: []u8, o: BuildOptions, out: []u8) -> u8 ! OutOfMemory {
    var sdk: []u8 = ""
    match try macos_sdk(alloc) {
        some(value as found: []u8) {
            sdk = found
        }
        none {
            io.eprint("cannot find the macOS SDK; set SDKROOT\n")
            return ok.(value: 1)
        }
    }
    var inputs: [..]keel.LinkInput = make(alloc)
    try push(inout inputs, keel.LinkInput.(name: "tern.o", bytes: object))
    for let path: []u8 in o.link {
        match read_all(alloc, path) {
            ok(value as bytes: [..]u8) {
                try push(inout inputs, keel.LinkInput.(name: path, bytes: bytes))
            }
            err(error: io.Error) {
                io.eprint("cannot read {path}: {io.describe(error)}\n")
                return ok.(value: 1)
            }
        }
    }
    // libc, libm and others are links to libSystem; load each stub once.
    var names: [..][]u8 = make(alloc)
    try push(inout names, "System")
    try append(inout names, o.libraries)
    var stubs: [..][]u8 = make(alloc)
    for let name: []u8 in names {
        let path: []u8 = try program.format_text(alloc, "{sdk}/usr/lib/lib{name}.tbd")
        var real: ?[..]u8 = none
        match fs.real_path(alloc, path) {
            ok(value as found: ?[..]u8) {
                real = found
            }
            err(error: _) {
            }
        }
        match real {
            some(value as stub: [..]u8) {
                var seen: bool = false
                for let s: []u8 in stubs {
                    if program.bytes_equal(s, stub) {
                        seen = true
                    }
                }
                if !seen {
                    try push(inout stubs, stub)
                }
            }
            none {
                io.eprint("cannot find library `{name}` in {sdk}\n")
                return ok.(value: 1)
            }
        }
    }
    match try keel.link_signed(alloc, inputs, stubs, sdk, out) {
        failed(message: [..]u8) {
            let text: []u8 = message
            io.eprint("cannot link {out}: {text}\n")
            return ok.(value: 1)
        }
        done(warnings: [..]u8) {
            var start: usize = 0
            for let i: usize in 0..warnings.len {
                if warnings[i] == '\n' {
                    if i > start {
                        let line: []u8 = warnings[start..i]
                        io.eprint("warning: {line}\n")
                    }
                    start = i + 1
                }
            }
            if warnings.len > start {
                let line: []u8 = warnings[start..]
                io.eprint("warning: {line}\n")
            }
            return ok.(value: 0)
        }
    }
}

// Every error, rendered with its source line where it has one.
fn render_program(p: program.Program) {
    for let e: []u8 in p.errors {
        io.eprint("error: {e}\n")
    }
    render_diagnostics(p, p.diagnostics)
}

fn render_diagnostics(p: program.Program, diagnostics: []program.Diagnostic) {
    for let diag: program.Diagnostic in diagnostics {
        let f: program.File = p.files[usize.(diag.file)]
        match diag.message {
            lex(d: syntax.Diagnostic) {
                render(f.path, f.text, f.starts, d)
            }
            parse(d: syntax.ParseDiagnostic) {
                render_head(f.path, f.starts, d.start)
                print_parse_problem(f.text, d)
                render_tail(f.text, f.starts, d.start)
            }
            text(start: u32, message: []u8) {
                render_head(f.path, f.starts, start)
                io.eprint("{message}")
                render_tail(f.text, f.starts, start)
            }
        }
    }
}

type Command enum {
    lex
    parse
}

fn run_file(path: []u8, command: Command) -> u8 {
    match read_all(heap.c_allocator, path) {
        ok(value as var text: [..]u8) {
            defer free(inout text)
            match run_text(path, text, command) {
                ok(value as code: u8) {
                    return code
                }
                err(error: _) {
                    io.eprint("ternc: out of memory\n")
                    return 1
                }
            }
        }
        err(error: io.Error) {
            io.eprint("ternc: cannot read {path}: {io.describe(error)}\n")
            return 1
        }
    }
}

fn read_all(alloc: Allocator, path: []u8) -> [..]u8 ! io.Error {
    var f: io.File = try io.open(path)
    defer io.close(inout f)
    return io.read_to_end(alloc, inout f)
}

// Runs the command on text that has been read. The status is 1 if there
// are problems.
fn run_text(path: []u8, text: []u8, command: Command) -> u8 ! OutOfMemory {
    let valid: usize = utf8.valid_up_to(text)
    if valid < text.len {
        // Report the encoding alone, against the text before it.
        let before: []u8 = text[..valid]
        var starts: [..]u32 = try syntax.line_starts(heap.c_allocator, before)
        defer free(inout starts)
        render_head(path, starts, u32.(valid))
        io.eprint("the file is not UTF-8 from here on; source files are UTF-8")
        render_tail(before, starts, u32.(valid))
        return ok.(value: 1)
    }
    var starts: [..]u32 = try syntax.line_starts(heap.c_allocator, text)
    defer free(inout starts)
    match command {
        lex {
            return lex_text(path, text, starts)
        }
        parse {
            return parse_text(path, text, starts)
        }
    }
}

// Prints the tokens to stdout and the problems to stderr.
fn lex_text(path: []u8, text: []u8, starts: []u32) -> u8 ! OutOfMemory {
    var arena: heap.Arena = heap.new_arena(heap.c_allocator)
    defer heap.free_arena(inout arena)
    let lexed: syntax.Lexed = try syntax.lex(heap.arena_allocator(&arena), text)
    for let t: syntax.Token in lexed.tokens {
        let pos: syntax.Position = syntax.position(starts, t.start)
        let bytes: []u8 = text[usize.(t.start)..usize.(t.end)]
        let name: []u8 = syntax.kind_name(t.kind)
        if bytes.len == 0 && t.kind == syntax.TokenKind.semicolon {
            io.print("{pos.line}:{pos.column}\tSemicolon\t(inserted)\n")
        } else {
            io.print("{pos.line}:{pos.column}\t{name}\t{bytes}\n")
        }
    }
    for let d: syntax.Diagnostic in lexed.diagnostics {
        render(path, text, starts, d)
    }
    return ok.(value: status(lexed.diagnostics.len))
}

// Prints the syntax tree to stdout if there are no problems, and the
// problems to stderr, the lexer's first.
fn parse_text(path: []u8, text: []u8, starts: []u32) -> u8 ! OutOfMemory {
    var arena: heap.Arena = heap.new_arena(heap.c_allocator)
    defer heap.free_arena(inout arena)
    let alloc: Allocator = heap.arena_allocator(&arena)
    let parsed: syntax.Parsed = try syntax.parse(alloc, text)
    let problems: usize = parsed.lex_diagnostics.len + parsed.diagnostics.len
    if problems == 0 {
        let tree: [..]u8 = try sexp.print(alloc, parsed.ast, text)
        let view: []u8 = tree
        io.print("{view}\n")
    }
    for let d: syntax.Diagnostic in parsed.lex_diagnostics {
        render(path, text, starts, d)
    }
    for let d: syntax.ParseDiagnostic in parsed.diagnostics {
        render_head(path, starts, d.start)
        print_parse_problem(text, d)
        render_tail(text, starts, d.start)
    }
    return ok.(value: status(problems))
}

fn status(problems: usize) -> u8 {
    if problems > 0 {
        return 1
    }
    return 0
}

// Prints path:line:column: error: message, then the source line with a
// caret under the start of the problem.
fn render(path: []u8, text: []u8, starts: []u32, d: syntax.Diagnostic) {
    render_head(path, starts, d.start)
    print_problem(d.problem)
    render_tail(text, starts, d.start)
}

fn render_head(path: []u8, starts: []u32, at: u32) {
    let pos: syntax.Position = syntax.position(starts, at)
    io.eprint("{path}:{pos.line}:{pos.column}: error: ")
}

fn render_tail(text: []u8, starts: []u32, at: u32) {
    let pos: syntax.Position = syntax.position(starts, at)
    let line: []u8 = syntax.line_text(text, starts, pos.line)
    io.eprint("\n    {line}\n    ")
    var pad: usize = usize.(pos.column) - 1
    if pad > line.len {
        pad = line.len
    }
    for let i: usize in 0..pad {
        if line[i] == '\t' {
            io.eprint("\t")
        } else {
            io.eprint(" ")
        }
    }
    io.eprint("^\n")
}

fn print_problem(p: syntax.Problem) {
    var buf: [8]u8 = fill[8](0)
    match p {
        line_ends_in_interpolation {
            io.eprint("the line ends inside a string interpolation")
        }
        comment_not_closed {
            io.eprint("block comment is not closed")
        }
        attribute_name_missing {
            io.eprint("expected an attribute name after `@`")
        }
        non_ascii_code(code: u32) {
            let hex: []u8 = code_point(inout buf, code)
            io.eprint("unexpected character U+{hex}; code outside strings and comments is ASCII")
        }
        number_suffix {
            io.eprint("a number literal cannot be followed by a letter or `_`; tern has no type suffixes")
        }
        digits_missing {
            io.eprint("expected digits after the number prefix")
        }
        bad_digit(digit: u8, base: u32) {
            let one: [1]u8 = [digit]
            let s: []u8 = one
            io.eprint("`{s}` is not a digit in base {base}")
        }
        misplaced_underscore {
            io.eprint("`_` in a number must stand between two digits")
        }
        string_not_closed {
            io.eprint("string literal is not closed on this line")
        }
        bad_hex_escape {
            io.eprint("`\\x` takes two hex digits from 00 to 7F")
        }
        unknown_escape {
            io.eprint("unknown escape")
        }
        unprintable(what: syntax.Literal, code: u32) {
            let hex: []u8 = code_point(inout buf, code)
            io.eprint("a {literal_name(what)} holds printable ASCII; write U+{hex} as an escape")
        }
        non_ascii_text(what: syntax.Literal, code: u32) {
            let hex: []u8 = code_point(inout buf, code)
            io.eprint("a {literal_name(what)} holds ASCII only, found U+{hex}")
        }
        empty_char {
            io.eprint("empty character literal")
        }
        char_not_closed {
            io.eprint("character literal is not closed")
        }
        unexpected_char(c: u8) {
            let one: [1]u8 = [c]
            let s: []u8 = one
            io.eprint("unexpected character `{s}`")
        }
        unexpected_control(c: u8) {
            let hex: []u8 = code_point(inout buf, u32.(c))
            io.eprint("unexpected control character U+{hex}")
        }
    }
}

fn literal_name(what: syntax.Literal) -> []u8 {
    return match what {
        string { "string literal" }
        character { "character literal" }
    }
}

// Upper-case hexadecimal with at least four digits, as in U+00E9.
fn code_point(buf: inout [8]u8, code: u32) -> []u8 {
    let symbols: []u8 = "0123456789ABCDEF"
    var i: usize = buf.len
    var v: u32 = code
    for {
        i -= 1
        buf[i] = symbols[usize.(v % 16)]
        v = v / 16
        if v == 0 && buf.len - i >= 4 {
            break
        }
    }
    return buf[i..]
}

fn print_parse_problem(text: []u8, d: syntax.ParseDiagnostic) {
    match d.problem {
        expected(what: []u8, found: syntax.Found) {
            match found {
                end_of_file {
                    io.eprint("expected {what}, found the end of the file")
                }
                end_of_line {
                    io.eprint("expected {what}, found the end of the line")
                }
                token {
                    let bytes: []u8 = text[usize.(d.start)..usize.(d.end)]
                    io.eprint("expected {what}, found `{bytes}`")
                }
            }
        }
        imports_first {
            io.eprint("imports come before all declarations")
        }
        variadic_first {
            io.eprint("`...` follows at least one parameter")
        }
        empty_tuple_type {
            io.eprint("a tuple type has at least one field")
        }
        empty_destructuring {
            io.eprint("a pattern has at least one field")
        }
        list_spans_lines {
            io.eprint("a list that spans lines ends each line with a comma")
        }
        defer_needs_call {
            io.eprint("`defer` takes a call")
        }
        not_a_statement {
            io.eprint("only a call or an assignment can stand as a statement")
        }
        range_bound {
            io.eprint("a range bound is an arithmetic expression; add parentheses")
        }
        logic_mix {
            io.eprint("`&&` and `||` do not mix; add parentheses")
        }
        comparison_chain {
            io.eprint("comparisons do not chain; add parentheses")
        }
        shift_chain {
            io.eprint("shifts do not chain; add parentheses")
        }
        operator_mix(first: syntax.BinaryOp, next: syntax.BinaryOp) {
            let a: []u8 = syntax.op_text(first)
            let b: []u8 = syntax.op_text(next)
            io.eprint("`{a}` and `{b}` do not mix; add parentheses")
        }
    }
}
