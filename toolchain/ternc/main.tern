// ternc, the tern compiler, written in tern. So far it lexes and parses:
//
//   ternc lex FILE      prints each token as stage 1 does
//   ternc parse FILE    prints the syntax tree as stage 1 does

import std.heap
import std.io
import std.os
import sexp
import std.utf8
import syntax

fn main() -> u8 {
    let args: [][]u8 = os.args()
    if args.len == 3 {
        match args[1] {
            "lex" {
                return run_file(args[2], Command.lex)
            }
            "parse" {
                return run_file(args[2], Command.parse)
            }
            _ {
            }
        }
    }
    io.eprint("usage: ternc lex FILE\n       ternc parse FILE\n")
    return 2
}

type Command enum {
    lex
    parse
}

fn run_file(path: []u8, command: Command) -> u8 {
    match read_all(heap.c_allocator, path) {
        ok(value as var text: [..]u8) {
            defer free(inout text)
            match run_text(path, text, command) {
                ok(value as code: u8) {
                    return code
                }
                err(error: _) {
                    io.eprint("ternc: out of memory\n")
                    return 1
                }
            }
        }
        err(error: io.Error) {
            io.eprint("ternc: cannot read {path}: {io.describe(error)}\n")
            return 1
        }
    }
}

fn read_all(alloc: Allocator, path: []u8) -> [..]u8 ! io.Error {
    var f: io.File = try io.open(path)
    defer io.close(inout f)
    return io.read_to_end(alloc, inout f)
}

// Runs the command on text that has been read. The status is 1 if there
// are problems.
fn run_text(path: []u8, text: []u8, command: Command) -> u8 ! OutOfMemory {
    let valid: usize = utf8.valid_up_to(text)
    if valid < text.len {
        // Report the encoding alone, against the text before it.
        let before: []u8 = text[..valid]
        var starts: [..]u32 = try syntax.line_starts(heap.c_allocator, before)
        defer free(inout starts)
        render_head(path, starts, u32.(valid))
        io.eprint("the file is not UTF-8 from here on; source files are UTF-8")
        render_tail(before, starts, u32.(valid))
        return ok.(value: 1)
    }
    var starts: [..]u32 = try syntax.line_starts(heap.c_allocator, text)
    defer free(inout starts)
    match command {
        lex {
            return lex_text(path, text, starts)
        }
        parse {
            return parse_text(path, text, starts)
        }
    }
}

// Prints the tokens to stdout and the problems to stderr.
fn lex_text(path: []u8, text: []u8, starts: []u32) -> u8 ! OutOfMemory {
    var arena: heap.Arena = heap.new_arena(heap.c_allocator)
    defer heap.free_arena(inout arena)
    let lexed: syntax.Lexed = try syntax.lex(heap.arena_allocator(&arena), text)
    for let t: syntax.Token in lexed.tokens {
        let pos: syntax.Position = syntax.position(starts, t.start)
        let bytes: []u8 = text[usize.(t.start)..usize.(t.end)]
        let name: []u8 = syntax.kind_name(t.kind)
        if bytes.len == 0 && t.kind == syntax.TokenKind.semicolon {
            io.print("{pos.line}:{pos.column}\tSemicolon\t(inserted)\n")
        } else {
            io.print("{pos.line}:{pos.column}\t{name}\t{bytes}\n")
        }
    }
    for let d: syntax.Diagnostic in lexed.diagnostics {
        render(path, text, starts, d)
    }
    return ok.(value: status(lexed.diagnostics.len))
}

// Prints the syntax tree to stdout if there are no problems, and the
// problems to stderr, the lexer's first.
fn parse_text(path: []u8, text: []u8, starts: []u32) -> u8 ! OutOfMemory {
    var arena: heap.Arena = heap.new_arena(heap.c_allocator)
    defer heap.free_arena(inout arena)
    let alloc: Allocator = heap.arena_allocator(&arena)
    let parsed: syntax.Parsed = try syntax.parse(alloc, text)
    let problems: usize = parsed.lex_diagnostics.len + parsed.diagnostics.len
    if problems == 0 {
        let tree: [..]u8 = try sexp.print(alloc, parsed.ast, text)
        let view: []u8 = tree
        io.print("{view}\n")
    }
    for let d: syntax.Diagnostic in parsed.lex_diagnostics {
        render(path, text, starts, d)
    }
    for let d: syntax.ParseDiagnostic in parsed.diagnostics {
        render_head(path, starts, d.start)
        print_parse_problem(text, d)
        render_tail(text, starts, d.start)
    }
    return ok.(value: status(problems))
}

fn status(problems: usize) -> u8 {
    if problems > 0 {
        return 1
    }
    return 0
}

// Prints path:line:column: error: message, then the source line with a
// caret under the start of the problem.
fn render(path: []u8, text: []u8, starts: []u32, d: syntax.Diagnostic) {
    render_head(path, starts, d.start)
    print_problem(d.problem)
    render_tail(text, starts, d.start)
}

fn render_head(path: []u8, starts: []u32, at: u32) {
    let pos: syntax.Position = syntax.position(starts, at)
    io.eprint("{path}:{pos.line}:{pos.column}: error: ")
}

fn render_tail(text: []u8, starts: []u32, at: u32) {
    let pos: syntax.Position = syntax.position(starts, at)
    let line: []u8 = syntax.line_text(text, starts, pos.line)
    io.eprint("\n    {line}\n    ")
    var pad: usize = usize.(pos.column) - 1
    if pad > line.len {
        pad = line.len
    }
    for let i: usize in 0..pad {
        if line[i] == '\t' {
            io.eprint("\t")
        } else {
            io.eprint(" ")
        }
    }
    io.eprint("^\n")
}

fn print_problem(p: syntax.Problem) {
    var buf: [8]u8 = fill[8](0)
    match p {
        line_ends_in_interpolation {
            io.eprint("the line ends inside a string interpolation")
        }
        comment_not_closed {
            io.eprint("block comment is not closed")
        }
        attribute_name_missing {
            io.eprint("expected an attribute name after `@`")
        }
        non_ascii_code(code: u32) {
            let hex: []u8 = code_point(inout buf, code)
            io.eprint("unexpected character U+{hex}; code outside strings and comments is ASCII")
        }
        number_suffix {
            io.eprint("a number literal cannot be followed by a letter or `_`; tern has no type suffixes")
        }
        digits_missing {
            io.eprint("expected digits after the number prefix")
        }
        bad_digit(digit: u8, base: u32) {
            let one: [1]u8 = [digit]
            let s: []u8 = one
            io.eprint("`{s}` is not a digit in base {base}")
        }
        misplaced_underscore {
            io.eprint("`_` in a number must stand between two digits")
        }
        string_not_closed {
            io.eprint("string literal is not closed on this line")
        }
        bad_hex_escape {
            io.eprint("`\\x` takes two hex digits from 00 to 7F")
        }
        unknown_escape {
            io.eprint("unknown escape")
        }
        unprintable(what: syntax.Literal, code: u32) {
            let hex: []u8 = code_point(inout buf, code)
            io.eprint("a {literal_name(what)} holds printable ASCII; write U+{hex} as an escape")
        }
        non_ascii_text(what: syntax.Literal, code: u32) {
            let hex: []u8 = code_point(inout buf, code)
            io.eprint("a {literal_name(what)} holds ASCII only, found U+{hex}")
        }
        empty_char {
            io.eprint("empty character literal")
        }
        char_not_closed {
            io.eprint("character literal is not closed")
        }
        unexpected_char(c: u8) {
            let one: [1]u8 = [c]
            let s: []u8 = one
            io.eprint("unexpected character `{s}`")
        }
        unexpected_control(c: u8) {
            let hex: []u8 = code_point(inout buf, u32.(c))
            io.eprint("unexpected control character U+{hex}")
        }
    }
}

fn literal_name(what: syntax.Literal) -> []u8 {
    return match what {
        string { "string literal" }
        character { "character literal" }
    }
}

// Upper-case hexadecimal with at least four digits, as in U+00E9.
fn code_point(buf: inout [8]u8, code: u32) -> []u8 {
    let symbols: []u8 = "0123456789ABCDEF"
    var i: usize = buf.len
    var v: u32 = code
    for {
        i -= 1
        buf[i] = symbols[usize.(v % 16)]
        v = v / 16
        if v == 0 && buf.len - i >= 4 {
            break
        }
    }
    return buf[i..]
}

fn print_parse_problem(text: []u8, d: syntax.ParseDiagnostic) {
    match d.problem {
        expected(what: []u8, found: syntax.Found) {
            match found {
                end_of_file {
                    io.eprint("expected {what}, found the end of the file")
                }
                end_of_line {
                    io.eprint("expected {what}, found the end of the line")
                }
                token {
                    let bytes: []u8 = text[usize.(d.start)..usize.(d.end)]
                    io.eprint("expected {what}, found `{bytes}`")
                }
            }
        }
        imports_first {
            io.eprint("imports come before all declarations")
        }
        variadic_first {
            io.eprint("`...` follows at least one parameter")
        }
        empty_tuple_type {
            io.eprint("a tuple type has at least one field")
        }
        empty_destructuring {
            io.eprint("a pattern has at least one field")
        }
        list_spans_lines {
            io.eprint("a list that spans lines ends each line with a comma")
        }
        defer_needs_call {
            io.eprint("`defer` takes a call")
        }
        not_a_statement {
            io.eprint("only a call or an assignment can stand as a statement")
        }
        range_bound {
            io.eprint("a range bound is an arithmetic expression; add parentheses")
        }
        logic_mix {
            io.eprint("`&&` and `||` do not mix; add parentheses")
        }
        comparison_chain {
            io.eprint("comparisons do not chain; add parentheses")
        }
        shift_chain {
            io.eprint("shifts do not chain; add parentheses")
        }
        operator_mix(first: syntax.BinaryOp, next: syntax.BinaryOp) {
            let a: []u8 = syntax.op_text(first)
            let b: []u8 = syntax.op_text(next)
            io.eprint("`{a}` and `{b}` do not mix; add parentheses")
        }
    }
}
