// Name resolution: connects every name to what it refers to. Ported from
// stage 1's resolver.
//
// A name is looked up in this order: the enclosing locals, innermost
// first; the package's top-level declarations; the file's imports; the
// built-in names. Rules checked here:
//
// - A top-level name is declared once per package.
// - A local never reuses a name already in scope: another local, a
//   top-level declaration, an import or a built-in. Top-level
//   declarations may reuse a built-in name.
// - Unused locals, parameters and imports are errors; `_` discards.
// - Another package's declarations are reachable only if `pub`.
// - A type position names a type.
//
// Field names after `.` on a value, and variant names in patterns, need
// types; the type checker resolves those.

import maps
import program
import syntax

pub fn is_builtin_type(name: []u8) -> bool {
    return match name {
        "i8", "i16", "i32", "i64", "isize", "u8", "u16", "u32", "u64", "usize" { true }
        "f32", "f64", "bool", "Allocator", "Format", "PanicInfo", "OutOfMemory" { true }
        _ { false }
    }
}

// The built-in values. Like the types, no local may take their names.
pub fn is_builtin_value(name: []u8) -> bool {
    return match name {
        "true", "false", "none", "some", "ok", "err" { true }
        _ { false }
    }
}

// The built-in functions. They are only ever called, so a local may take
// one of their names: a bare name means the local, and a call means the
// built-in unless the package declares that name.
pub fn is_builtin_function(name: []u8) -> bool {
    return match name {
        "panic", "make", "push", "pop", "append", "clear", "free", "take", "copy", "fill" { true }
        "from_address", "from_pointer", "offset", "cast", "truncate", "c_string" { true }
        "volatile_load", "volatile_store" { true }
        "wrapping_add", "wrapping_sub", "wrapping_mul" { true }
        "saturating_add", "saturating_sub", "saturating_mul" { true }
        "unchecked_add", "unchecked_sub", "unchecked_mul" { true }
        _ { false }
    }
}

fn is_builtin(name: []u8) -> bool {
    return is_builtin_type(name) || is_builtin_value(name) || is_builtin_function(name)
}

// Every built-in name, so a resolution names one by its index instead
// of holding a view of the source.
let builtin_names: [50][]u8 = [
    "i8", "i16", "i32", "i64", "isize", "u8", "u16", "u32",
    "u64", "usize", "f32", "f64", "bool", "Allocator", "Format", "PanicInfo",
    "OutOfMemory", "true", "false", "none", "some", "ok", "err", "panic",
    "make", "push", "pop", "append", "clear", "free", "take", "copy",
    "fill", "from_address", "from_pointer", "offset", "cast", "truncate", "c_string", "volatile_load",
    "volatile_store", "wrapping_add", "wrapping_sub", "wrapping_mul", "saturating_add", "saturating_sub", "saturating_mul", "unchecked_add",
    "unchecked_sub", "unchecked_mul",
]

// The built-in name with this index.
pub fn builtin_name(id: u32) -> []u8 {
    return builtin_names[usize.(id)]
}

// The index of a built-in name.
pub fn builtin_id(name: []u8) -> u32 {
    for let i: usize in 0..builtin_names.len {
        if program.bytes_equal(builtin_names[i], name) {
            return u32.(i)
        }
    }
    panic("not a built-in name")
}

// What a name refers to.
pub type Res enum {
    local(id: u32)
    decl(decl: maps.DeclRef)
    package(id: u32)
    builtin(id: u32)
}

// A `shared` global a name in a `lock` takes, keyed by the start of the
// name.
pub type Lock (pub start: u32, pub decl: maps.DeclRef)

// The resolution of one file, indexed like its syntax tree.
pub type FileNames (
    // For a name expression, or a field expression that names a member
    // of an imported package.
    pub exprs: [..]?Res,
    // For a named type.
    pub types: [..]?Res,
    // Where each local was declared.
    pub locals: [..]syntax.Span,
    // The local each binding declares, keyed by the start of its name.
    pub bindings: maps.IntMap,
    pub locks: [..]Lock,
    // A call to a built-in function made while a local has its name,
    // keyed by the start of the callee's name. The checker rejects the
    // call if that local is a function value, which the reader might take
    // it to call.
    pub hidden_locals: maps.IntMap,
)

pub type Resolution (
    pub files: [..]FileNames,
    // Each package's top-level names.
    pub scopes: [..]maps.NameMap,
    pub diagnostics: [..]program.Diagnostic,
)

// Resolves every file of p, which it borrows for the duration and gives
// back unchanged.
pub fn resolve(alloc: Allocator, p: inout program.Program) -> Resolution ! OutOfMemory {
    var out: Resolution = Resolution.(
        files: make(alloc),
        scopes: make(alloc),
        diagnostics: make(alloc),
    )
    for let package: program.Package in p.packages {
        var scope: maps.NameMap = maps.new_names(alloc)
        for let file: u32 in package.files {
            try declare_top_level(alloc, p, file, inout scope, inout out.diagnostics)
        }
        try push(inout out.scopes, take(inout scope))
    }
    var input: Input = Input.(program: take(inout p), scopes: take(inout out.scopes))
    for let i: usize in 0..input.program.files.len {
        let f: program.File = input.program.files[i]
        var r: Resolver = Resolver.(
            alloc: alloc,
            file: u32.(i),
            package: f.package,
            imports: make(alloc),
            locals: make(alloc),
            marks: make(alloc),
            names: FileNames.(
                exprs: make(alloc),
                types: make(alloc),
                locals: make(alloc),
                bindings: maps.new_ints(alloc),
                locks: make(alloc),
                hidden_locals: maps.new_ints(alloc),
            ),
            found: make(alloc),
        )
        for let _: usize in 0..f.ast.exprs.len {
            try push(inout r.names.exprs, none)
        }
        for let _: usize in 0..f.ast.types.len {
            try push(inout r.names.types, none)
        }
        try resolve_file(input, inout r)
        // Stable: problems at one place keep the order they were found.
        for let a: usize in 1..r.found.len {
            var b: usize = a
            for b > 0 && r.found[b].start < r.found[b - 1].start {
                var t: Found = take(inout r.found[b])
                r.found[b] = take(inout r.found[b - 1])
                r.found[b - 1] = take(inout t)
                b -= 1
            }
        }
        for let k: usize in 0..r.found.len {
            let start: u32 = r.found[k].start
            try push(inout out.diagnostics, program.Diagnostic.(file: u32.(i), message: program.Message.text.(start: start, message: take(inout r.found[k].message))))
        }
        try push(inout out.files, take(inout r.names))
    }
    out.scopes = take(inout input.scopes)
    p = take(inout input.program)
    return ok.(value: out)
}

fn span_text(f: program.File, s: syntax.Span) -> []u8 {
    return f.text[usize.(s.start)..usize.(s.end)]
}

// The names a declaration puts in its package's scope, added to out.
fn declared_names(ast: syntax.Ast, d: syntax.Decl, out: inout [..]syntax.Span) -> ! OutOfMemory {
    match d.kind {
        function(is_unsafe: _, name: syntax.Span, params: _, result: _, body: _) {
            try push(inout out, name)
        }
        extern_fn(name: syntax.Span, params: _, variadic: _, result: _) {
            try push(inout out, name)
        }
        extern_var(mutable: _, name: syntax.Span, ty: _) {
            try push(inout out, name)
        }
        type_decl(name: syntax.Span, def: _) {
            try push(inout out, name)
        }
        global(is_shared: _, local: syntax.Local) {
            match local.binding {
                single(name: ?syntax.Span, ty: _) {
                    match name {
                        none {
                        }
                        some(value as n: syntax.Span) {
                            try push(inout out, n)
                        }
                    }
                }
                destructure(fields: syntax.List) {
                    for let i: u32 in syntax.items(ast.extra, fields) {
                        let field: syntax.DestructField = ast.destructs[usize.(i)]
                        match field.ty {
                            none {
                            }
                            some(value: _) {
                                match field.rename {
                                    none {
                                        try push(inout out, field.field)
                                    }
                                    some(value as rename: syntax.Span) {
                                        try push(inout out, rename)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return ok
}

fn declare_top_level(
    alloc: Allocator,
    p: program.Program,
    file: u32,
    scope: inout maps.NameMap,
    diagnostics: inout [..]program.Diagnostic,
) -> ! OutOfMemory {
    let f: program.File = p.files[usize.(file)]
    var names: [..]syntax.Span = make(alloc)
    for let index: usize in 0..f.ast.decls.len {
        clear(inout names)
        try declared_names(f.ast, f.ast.decls[index], inout names)
        for let name: syntax.Span in names {
            let text: []u8 = span_text(f, name)
            match maps.get_name(scope, text) {
                some(value as previous: maps.DeclRef) {
                    let at: [..]u8 = try describe_decl(alloc, p, previous)
                    try push(inout diagnostics, program.Diagnostic.(
                        file: file,
                        message: program.Message.text.(start: name.start, message: try program.format_text(alloc, "`{text}` is already declared in this package, at {at}")),
                    ))
                }
                none {
                    try maps.put_name(inout scope, text, maps.DeclRef.(file: file, index: u32.(index)))
                }
            }
        }
    }
    return ok
}

// `path:line` of a declaration, for messages.
pub fn describe_decl(alloc: Allocator, p: program.Program, decl: maps.DeclRef) -> [..]u8 ! OutOfMemory {
    let f: program.File = p.files[usize.(decl.file)]
    let start: u32 = f.ast.decls[usize.(decl.index)].span.start
    let pos: syntax.Position = syntax.position(f.starts, start)
    return program.format_text(alloc, "{f.path}:{pos.line}")
}

type Import (
    // The name it binds.
    name: syntax.Span,
    // None when the package failed to load; the loader reported it.
    package: ?u32,
    span: syntax.Span,
    used: bool,
)

type LocalBinding (
    id: u32,
    // The name.
    span: syntax.Span,
    used: bool,
    // The field name, for a binding from a destructured field.
    field: ?syntax.Span,
)

// A problem found in the file, before sorting.
type Found (start: u32, message: [..]u8)

// What resolving a file reads: the program, and each package's
// top-level names.
type Input (program: program.Program, scopes: [..]maps.NameMap)

// What resolving a file changes.
type Resolver (
    alloc: Allocator,
    file: u32,
    package: u32,
    imports: [..]Import,
    // The locals in scope, outermost first, and where each enclosing
    // block's locals start.
    locals: [..]LocalBinding,
    marks: [..]usize,
    names: FileNames,
    found: [..]Found,
)

fn text_of(input: Input, file: u32, s: syntax.Span) -> []u8 {
    return input.program.files[usize.(file)].text[usize.(s.start)..usize.(s.end)]
}

fn problem(r: inout Resolver, start: u32, message: Format) -> ! OutOfMemory {
    try push(inout r.found, Found.(start: start, message: try program.format_text(r.alloc, message)))
    return ok
}

fn line_of(input: Input, r: Resolver, s: syntax.Span) -> u32 {
    let f: program.File = input.program.files[usize.(r.file)]
    return syntax.position(f.starts, s.start).line
}

fn package_lookup(input: Input, r: Resolver, name: []u8) -> ?maps.DeclRef {
    return maps.get_name(input.scopes[usize.(r.package)], name)
}

fn resolve_file(input: Input, r: inout Resolver) -> ! OutOfMemory {
    let ast: syntax.Ast = input.program.files[usize.(r.file)].ast
    for let imp: syntax.Import in ast.imports {
        let segments: []u32 = syntax.items(ast.extra, imp.path)
        var path: [..]u8 = make(r.alloc)
        for let i: usize in 0..segments.len {
            if i > 0 {
                try push(inout path, '.')
            }
            try append(inout path, text_of(input, r.file, ast.names[usize.(segments[i])]))
        }
        var local: syntax.Span = ast.names[usize.(segments[segments.len - 1])]
        match imp.alias {
            none {
            }
            some(value as alias: syntax.Span) {
                local = alias
            }
        }
        let local_text: []u8 = text_of(input, r.file, local)
        match package_lookup(input, r, local_text) {
            none {
            }
            some(value as decl: maps.DeclRef) {
                let at: [..]u8 = try describe_decl(r.alloc, input.program, decl)
                try problem(inout r, local.start, "`{local_text}` is both imported and declared at {at}; rename the import with `as`")
            }
        }
        // The loader reports a name imported twice.
        var known: bool = false
        for let other: Import in r.imports {
            if program.bytes_equal(text_of(input, r.file, other.name), local_text) {
                known = true
            }
        }
        if !known {
            let entry: Import = Import.(
                name: local,
                package: program.find_package(input.program, path),
                span: imp.span,
                used: false,
            )
            try push(inout r.imports, entry)
        }
    }
    for let d: syntax.Decl in ast.decls {
        try resolve_decl(input, inout r, d)
    }
    // The imports are in source order already.
    for let n: usize in 0..r.imports.len {
        let imp: Import = r.imports[n]
        match imp.package {
            none {
            }
            some(value: _) {
                if !imp.used {
                    let name: []u8 = text_of(input, r.file, imp.name)
                    try problem(inout r, imp.span.start, "`{name}` is imported but never used")
                }
            }
        }
    }
    return ok
}

// Scopes.

fn push_scope(r: inout Resolver) -> ! OutOfMemory {
    try push(inout r.marks, r.locals.len)
    return ok
}

fn pop_scope(input: Input, r: inout Resolver) -> ! OutOfMemory {
    let mark: usize = r.marks[r.marks.len - 1]
    let _: ?usize = pop(inout r.marks)
    for let i: usize in mark..r.locals.len {
        let l: LocalBinding = r.locals[i]
        if !l.used {
            let name: []u8 = text_of(input, r.file, l.span)
            match l.field {
                some(value as f: syntax.Span) {
                    let field: []u8 = text_of(input, r.file, f)
                    try problem(inout r, l.span.start, "`{name}` is never used; skip the field with `{field}: _`")
                }
                none {
                    try problem(inout r, l.span.start, "`{name}` is never used; name it `_` to discard it")
                }
            }
        }
    }
    for r.locals.len > mark {
        let _: ?LocalBinding = pop(inout r.locals)
    }
    return ok
}

// Declares a local in the innermost scope; field is the field it comes
// from, if any.
fn bind(input: Input, r: inout Resolver, name: syntax.Span, field: ?syntax.Span) -> ! OutOfMemory {
    let text: []u8 = text_of(input, r.file, name)
    var earlier: ?syntax.Span = none
    for let l: LocalBinding in r.locals {
        if program.bytes_equal(text_of(input, r.file, l.span), text) {
            earlier = some.(value: l.span)
            break
        }
    }
    match earlier {
        some(value as e: syntax.Span) {
            let line: u32 = line_of(input, r, e)
            try problem(inout r, name.start, "`{text}` is already a local, declared on line {line}; pick another name")
        }
        none {
            match package_lookup(input, r, text) {
                some(value as decl: maps.DeclRef) {
                    let at: [..]u8 = try describe_decl(r.alloc, input.program, decl)
                    try problem(inout r, name.start, "`{text}` is already declared at {at}; pick another name")
                }
                none {
                    if is_import(input, r, text) {
                        try problem(inout r, name.start, "`{text}` is an imported package; pick another name")
                    } else if is_builtin_type(text) || is_builtin_value(text) {
                        try problem(inout r, name.start, "`{text}` is a built-in name; pick another name")
                    }
                }
            }
        }
    }
    let id: u32 = u32.(r.names.locals.len)
    try push(inout r.names.locals, name)
    try maps.put_int(inout r.names.bindings, name.start, id)
    try push(inout r.locals, LocalBinding.(id: id, span: name, used: false, field: field))
    return ok
}

fn is_import(input: Input, r: Resolver, text: []u8) -> bool {
    for let imp: Import in r.imports {
        if program.bytes_equal(text_of(input, r.file, imp.name), text) {
            return true
        }
    }
    return false
}

// Looks a name up, marking a local or import as used.
fn lookup(input: Input, r: inout Resolver, name: syntax.Span) -> ?Res {
    let text: []u8 = text_of(input, r.file, name)
    var i: usize = r.locals.len
    for i > 0 {
        i -= 1
        if program.bytes_equal(text_of(input, r.file, r.locals[i].span), text) {
            r.locals[i].used = true
            return some.(value: Res.local.(id: r.locals[i].id))
        }
    }
    match package_lookup(input, r, text) {
        some(value as decl: maps.DeclRef) {
            return some.(value: Res.decl.(decl: decl))
        }
        none {
        }
    }
    for let j: usize in 0..r.imports.len {
        if program.bytes_equal(text_of(input, r.file, r.imports[j].name), text) {
            r.imports[j].used = true
            match r.imports[j].package {
                none {
                    return none
                }
                some(value as p: u32) {
                    return some.(value: Res.package.(id: p))
                }
            }
        }
    }
    if is_builtin(text) {
        return some.(value: Res.builtin.(id: builtin_id(text)))
    }
    return none
}

fn set_expr(r: inout Resolver, id: syntax.ExprId, res: ?Res) {
    r.names.exprs[usize.(id)] = res
}

// A call's callee. A built-in function's name, bare or with an argument
// in brackets as in `fill[4](0)`, skips the locals: a local of that name
// does not hide the built-in.
fn callee(input: Input, r: inout Resolver, id: syntax.ExprId) -> ! OutOfMemory {
    let ast: syntax.Ast = input.program.files[usize.(r.file)].ast
    var name: syntax.Span = syntax.Span.(start: 0, end: 0)
    // The name expression and the bracketed index, for `fill[4]`.
    var bracketed: ?syntax.ExprId = none
    var index: ?syntax.Index = none
    match ast.exprs[usize.(id)].kind {
        name(name as n: syntax.Span) {
            name = n
        }
        index(value: syntax.ExprId, index as i: syntax.Index) {
            match i {
                slice(start: _, end: _) {
                    return expr(input, inout r, id)
                }
                value(value: _) {
                }
                ty(ty: _) {
                }
            }
            match ast.exprs[usize.(value)].kind {
                name(name as n: syntax.Span) {
                    name = n
                    bracketed = some.(value: value)
                    index = some.(value: i)
                }
                _ {
                    return expr(input, inout r, id)
                }
            }
        }
        _ {
            return expr(input, inout r, id)
        }
    }
    let text: []u8 = text_of(input, r.file, name)
    if !is_builtin_function(text) {
        return expr(input, inout r, id)
    }
    var res: Res = Res.builtin.(id: builtin_id(text))
    match package_lookup(input, r, text) {
        some(value as decl: maps.DeclRef) {
            res = Res.decl.(decl: decl)
        }
        none {
            for let l: LocalBinding in r.locals {
                if program.bytes_equal(text_of(input, r.file, l.span), text) {
                    try maps.put_int(inout r.names.hidden_locals, name.start, l.id)
                    break
                }
            }
        }
    }
    match bracketed {
        none {
            set_expr(inout r, id, some.(value: res))
        }
        some(value as v: syntax.ExprId) {
            set_expr(inout r, v, some.(value: res))
            match index {
                none {
                }
                some(value as i: syntax.Index) {
                    match i {
                        ty(ty as t: syntax.TypeId) {
                            try ty(input, inout r, t)
                        }
                        value(value as e: syntax.ExprId) {
                            try expr(input, inout r, e)
                        }
                        slice(start: _, end: _) {
                        }
                    }
                }
            }
        }
    }
    return ok
}

// `pkg.name`: a member of an imported package.
fn member(input: Input, r: inout Resolver, package: u32, name: syntax.Span) -> ?maps.DeclRef ! OutOfMemory {
    let text: []u8 = text_of(input, r.file, name)
    let path: []u8 = input.program.packages[usize.(package)].path
    match maps.get_name(input.scopes[usize.(package)], text) {
        none {
            try problem(inout r, name.start, "package `{path}` has no `{text}`")
            return ok.(value: none)
        }
        some(value as decl: maps.DeclRef) {
            let target: program.File = input.program.files[usize.(decl.file)]
            if !target.ast.decls[usize.(decl.index)].public {
                try problem(inout r, name.start, "`{text}` is private to package `{path}`; it needs `pub`")
            }
            return ok.(value: some.(value: decl))
        }
    }
}

fn is_type_decl(input: Input, decl: maps.DeclRef) -> bool {
    return match input.program.files[usize.(decl.file)].ast.decls[usize.(decl.index)].kind {
        type_decl(name: _, def: _) { true }
        _ { false }
    }
}

// Declarations.

fn resolve_decl(input: Input, r: inout Resolver, d: syntax.Decl) -> ! OutOfMemory {
    let ast: syntax.Ast = input.program.files[usize.(r.file)].ast
    match d.kind {
        function(is_unsafe: _, name: _, params: syntax.List, result: ?syntax.TypeId, body: syntax.Block) {
            try push_scope(inout r)
            let list: []u32 = syntax.items(ast.extra, params)
            for let i: u32 in list {
                let item: syntax.TypeId = ast.params[usize.(i)].ty
                try ty(input, inout r, item)
            }
            try opt_ty(input, inout r, result)
            for let i: u32 in list {
                match ast.params[usize.(i)].name {
                    none {
                    }
                    some(value as n: syntax.Span) {
                        try bind(input, inout r, n, none)
                    }
                }
            }
            try block(input, inout r, body)
            try pop_scope(input, inout r)
        }
        extern_fn(name: _, params: syntax.List, variadic: _, result: ?syntax.TypeId) {
            for let i: u32 in syntax.items(ast.extra, params) {
                let item: syntax.TypeId = ast.params[usize.(i)].ty
                try ty(input, inout r, item)
            }
            try opt_ty(input, inout r, result)
        }
        extern_var(mutable: _, name: _, ty as t: syntax.TypeId) {
            try ty(input, inout r, t)
        }
        type_decl(name: _, def: syntax.TypeDef) {
            match def {
                plain(ty as t: syntax.TypeId) {
                    try ty(input, inout r, t)
                }
                enum_type(int_type: ?syntax.TypeId, variants: syntax.List) {
                    try opt_ty(input, inout r, int_type)
                    for let i: u32 in syntax.items(ast.extra, variants) {
                        match ast.variants[usize.(i)] {
                            named(name: _, payload: ?syntax.TypeId, value: ?syntax.ExprId) {
                                try opt_ty(input, inout r, payload)
                                match value {
                                    none {
                                    }
                                    some(value as e: syntax.ExprId) {
                                        try expr(input, inout r, e)
                                    }
                                }
                            }
                            open(span: _) {
                            }
                        }
                    }
                }
                union_type(fields: syntax.List) {
                    for let i: u32 in syntax.items(ast.extra, fields) {
                        let item: syntax.TypeId = ast.fields[usize.(i)].ty
                        try ty(input, inout r, item)
                    }
                }
            }
        }
        global(is_shared: _, local: syntax.Local) {
            // The names are already in the package scope.
            match local.binding {
                single(name: _, ty as t: syntax.TypeId) {
                    try ty(input, inout r, t)
                }
                destructure(fields: syntax.List) {
                    for let i: u32 in syntax.items(ast.extra, fields) {
                        let field: syntax.DestructField = ast.destructs[usize.(i)]
                        try check_rename(inout r, field)
                        try opt_ty(input, inout r, field.ty)
                    }
                }
            }
            try expr(input, inout r, local.value)
        }
    }
    return ok
}

fn check_rename(r: inout Resolver, field: syntax.DestructField) -> ! OutOfMemory {
    match field.rename {
        some(value as rename: syntax.Span) {
            match field.ty {
                none {
                    try problem(inout r, rename.start, "a skipped field has no name to rename; drop the `as`")
                }
                some(value: _) {
                }
            }
        }
        none {
        }
    }
    return ok
}

// Types.

fn opt_ty(input: Input, r: inout Resolver, t: ?syntax.TypeId) -> ! OutOfMemory {
    match t {
        none {
        }
        some(value as id: syntax.TypeId) {
            try ty(input, inout r, id)
        }
    }
    return ok
}

fn ty(input: Input, r: inout Resolver, id: syntax.TypeId) -> ! OutOfMemory {
    let ast: syntax.Ast = input.program.files[usize.(r.file)].ast
    match ast.types[usize.(id)].kind {
        name(package: ?syntax.Span, name: syntax.Span) {
            var res: ?Res = none
            match package {
                some(value as pkg: syntax.Span) {
                    match lookup(input, inout r, pkg) {
                        some(value as found: Res) {
                            match found {
                                package(id as p: u32) {
                                    match try member(input, inout r, p, name) {
                                        some(value as decl: maps.DeclRef) {
                                            res = some.(value: Res.decl.(decl: decl))
                                        }
                                        none {
                                        }
                                    }
                                }
                                _ {
                                    let text: []u8 = text_of(input, r.file, pkg)
                                    try problem(inout r, pkg.start, "`{text}` is not a package")
                                }
                            }
                        }
                        none {
                            try undefined(input, inout r, pkg)
                        }
                    }
                }
                none {
                    res = lookup(input, inout r, name)
                    match res {
                        none {
                            try undefined(input, inout r, name)
                        }
                        some(value: _) {
                        }
                    }
                }
            }
            var is_type: bool = true
            match res {
                some(value as found: Res) {
                    match found {
                        decl(decl as d: maps.DeclRef) {
                            is_type = is_type_decl(input, d)
                        }
                        builtin(id as builtin_index: u32) {
                            let b: []u8 = builtin_name(builtin_index)
                            is_type = is_builtin_type(b)
                        }
                        local(id: _) {
                            is_type = false
                        }
                        package(id: _) {
                            is_type = false
                        }
                    }
                }
                none {
                }
            }
            if !is_type {
                let text: []u8 = text_of(input, r.file, name)
                try problem(inout r, name.start, "`{text}` is not a type")
            }
            r.names.types[usize.(id)] = res
        }
        tuple(fields: syntax.List) {
            for let i: u32 in syntax.items(ast.extra, fields) {
                let item: syntax.TypeId = ast.fields[usize.(i)].ty
                try ty(input, inout r, item)
            }
        }
        view(elem: syntax.TypeId) {
            try ty(input, inout r, elem)
        }
        growable(elem: syntax.TypeId) {
            try ty(input, inout r, elem)
        }
        pointer(elem: syntax.TypeId) {
            try ty(input, inout r, elem)
        }
        optional(elem: syntax.TypeId) {
            try ty(input, inout r, elem)
        }
        array(len: syntax.ExprId, elem: syntax.TypeId) {
            try expr(input, inout r, len)
            try ty(input, inout r, elem)
        }
        result(value: ?syntax.TypeId, error: syntax.TypeId) {
            try opt_ty(input, inout r, value)
            try ty(input, inout r, error)
        }
        function(params: syntax.List, result: ?syntax.TypeId) {
            for let i: u32 in syntax.items(ast.extra, params) {
                let item: syntax.TypeId = ast.params[usize.(i)].ty
                try ty(input, inout r, item)
            }
            try opt_ty(input, inout r, result)
        }
    }
    return ok
}

fn undefined(input: Input, r: inout Resolver, name: syntax.Span) -> ! OutOfMemory {
    let text: []u8 = text_of(input, r.file, name)
    return problem(inout r, name.start, "`{text}` is not defined")
}

// Statements.

fn block(input: Input, r: inout Resolver, b: syntax.Block) -> ! OutOfMemory {
    let ast: syntax.Ast = input.program.files[usize.(r.file)].ast
    try push_scope(inout r)
    for let s: u32 in syntax.items(ast.extra, b.stmts) {
        try stmt(input, inout r, syntax.StmtId.(s))
    }
    return pop_scope(input, inout r)
}

// Resolves a binding's types and declares its names.
fn binding(input: Input, r: inout Resolver, b: syntax.Binding) -> ! OutOfMemory {
    match b {
        single(name: ?syntax.Span, ty as t: syntax.TypeId) {
            try ty(input, inout r, t)
            match name {
                none {
                }
                some(value as n: syntax.Span) {
                    try bind(input, inout r, n, none)
                }
            }
        }
        destructure(fields: syntax.List) {
            try destructure(input, inout r, fields)
        }
    }
    return ok
}

fn destructure(input: Input, r: inout Resolver, fields: syntax.List) -> ! OutOfMemory {
    let ast: syntax.Ast = input.program.files[usize.(r.file)].ast
    for let i: u32 in syntax.items(ast.extra, fields) {
        let field: syntax.DestructField = ast.destructs[usize.(i)]
        try check_rename(inout r, field)
        match field.ty {
            none {
            }
            some(value as t: syntax.TypeId) {
                try ty(input, inout r, t)
                var name: syntax.Span = field.field
                match field.rename {
                    none {
                    }
                    some(value as rename: syntax.Span) {
                        name = rename
                    }
                }
                try bind(input, inout r, name, some.(value: field.field))
            }
        }
    }
    return ok
}

fn stmt(input: Input, r: inout Resolver, id: syntax.StmtId) -> ! OutOfMemory {
    let ast: syntax.Ast = input.program.files[usize.(r.file)].ast
    match ast.stmts[usize.(id)].kind {
        local(local: syntax.Local) {
            // The value cannot see the names it initializes.
            try expr(input, inout r, local.value)
            try binding(input, inout r, local.binding)
        }
        return_stmt(value: ?syntax.ExprId) {
            try opt_expr(input, inout r, value)
        }
        if_stmt(cond: syntax.ExprId, then: syntax.Block, otherwise: ?syntax.Else) {
            try expr(input, inout r, cond)
            try block(input, inout r, then)
            match otherwise {
                none {
                }
                some(value as e: syntax.Else) {
                    match e {
                        block(body: syntax.Block) {
                            try block(input, inout r, body)
                        }
                        if_stmt(stmt as s: syntax.StmtId) {
                            try stmt(input, inout r, s)
                        }
                    }
                }
            }
        }
        match_stmt(value: syntax.ExprId, arms as list: syntax.List) {
            try expr(input, inout r, value)
            try arms(input, inout r, list)
        }
        for_stmt(kind: syntax.ForKind, body: syntax.Block) {
            try push_scope(inout r)
            match kind {
                forever {
                }
                while_loop(cond: syntax.ExprId) {
                    try expr(input, inout r, cond)
                }
                for_in(mutable: _, binding as b: syntax.Binding, iterable: syntax.Iterable) {
                    match iterable {
                        value(value as e: syntax.ExprId) {
                            try expr(input, inout r, e)
                        }
                        range(start: syntax.ExprId, end: syntax.ExprId) {
                            try expr(input, inout r, start)
                            try expr(input, inout r, end)
                        }
                    }
                    try binding(input, inout r, b)
                }
            }
            try block(input, inout r, body)
            try pop_scope(input, inout r)
        }
        break_stmt, continue_stmt {
        }
        defer_stmt(call: syntax.ExprId) {
            try expr(input, inout r, call)
        }
        expr(value: syntax.ExprId) {
            try expr(input, inout r, value)
        }
        unsafe_stmt(body: syntax.Block) {
            try block(input, inout r, body)
        }
        lock_stmt(globals: syntax.List, body: syntax.Block) {
            for let i: u32 in syntax.items(ast.extra, globals) {
                let item: syntax.GlobalName = ast.globals[usize.(i)]
                try lock_name(input, inout r, item)
            }
            try block(input, inout r, body)
        }
        assign(left: syntax.ExprId, op: _, right: syntax.ExprId) {
            try expr(input, inout r, left)
            try expr(input, inout r, right)
        }
    }
    return ok
}

fn lock_name(input: Input, r: inout Resolver, g: syntax.GlobalName) -> ! OutOfMemory {
    var decl: ?maps.DeclRef = none
    match g.package {
        some(value as pkg: syntax.Span) {
            var is_package: bool = false
            match lookup(input, inout r, pkg) {
                some(value as found: Res) {
                    match found {
                        package(id as p: u32) {
                            is_package = true
                            decl = try member(input, inout r, p, g.name)
                        }
                        _ {
                        }
                    }
                }
                none {
                }
            }
            if !is_package {
                let text: []u8 = text_of(input, r.file, pkg)
                try problem(inout r, pkg.start, "`{text}` is not a package")
            }
        }
        none {
            match lookup(input, inout r, g.name) {
                some(value as found: Res) {
                    match found {
                        decl(decl as d: maps.DeclRef) {
                            decl = some.(value: d)
                        }
                        _ {
                            try not_shared(input, inout r, g.name)
                        }
                    }
                }
                none {
                    try undefined(input, inout r, g.name)
                }
            }
        }
    }
    match decl {
        none {
        }
        some(value as d: maps.DeclRef) {
            let takes_lock: bool = match input.program.files[usize.(d.file)].ast.decls[usize.(d.index)].kind {
                global(is_shared as s: bool, local: _) { s }
                _ { false }
            }
            if takes_lock {
                try push(inout r.names.locks, Lock.(start: g.name.start, decl: d))
            } else {
                try not_shared(input, inout r, g.name)
            }
        }
    }
    return ok
}

fn not_shared(input: Input, r: inout Resolver, name: syntax.Span) -> ! OutOfMemory {
    let text: []u8 = text_of(input, r.file, name)
    return problem(inout r, name.start, "`lock` takes a `shared` global; `{text}` is not one")
}

fn arms(input: Input, r: inout Resolver, list: syntax.List) -> ! OutOfMemory {
    let ast: syntax.Ast = input.program.files[usize.(r.file)].ast
    for let i: u32 in syntax.items(ast.extra, list) {
        let arm: syntax.Arm = ast.arms[usize.(i)]
        try push_scope(inout r)
        try patterns(input, inout r, arm.patterns)
        match arm.body {
            block(body: syntax.Block) {
                try block(input, inout r, body)
            }
            branch(value: syntax.ExprId) {
                try expr(input, inout r, value)
            }
        }
        try pop_scope(input, inout r)
    }
    return ok
}

fn patterns(input: Input, r: inout Resolver, list: syntax.List) -> ! OutOfMemory {
    let ast: syntax.Ast = input.program.files[usize.(r.file)].ast
    let pats: []u32 = syntax.items(ast.extra, list)
    let several: bool = pats.len > 1
    for let p: u32 in pats {
        let pat: syntax.Pattern = ast.pats[usize.(p)]
        match pat.kind {
            variant(name: _, payload: ?syntax.List) {
                match payload {
                    none {
                    }
                    some(value as fields: syntax.List) {
                        if several && binds_any(input, r, fields) {
                            try problem(inout r, pat.span.start, "an arm with several patterns cannot bind payloads")
                        }
                        try destructure(input, inout r, fields)
                    }
                }
            }
            literal(value: syntax.ExprId) {
                try expr(input, inout r, value)
            }
            negative(value: syntax.ExprId) {
                try expr(input, inout r, value)
            }
            discard {
            }
        }
    }
    return ok
}

fn binds_any(input: Input, r: Resolver, fields: syntax.List) -> bool {
    let ast: syntax.Ast = input.program.files[usize.(r.file)].ast
    for let i: u32 in syntax.items(ast.extra, fields) {
        match ast.destructs[usize.(i)].ty {
            some(value: _) {
                return true
            }
            none {
            }
        }
    }
    return false
}

// Expressions.

fn opt_expr(input: Input, r: inout Resolver, e: ?syntax.ExprId) -> ! OutOfMemory {
    match e {
        none {
        }
        some(value as id: syntax.ExprId) {
            try expr(input, inout r, id)
        }
    }
    return ok
}

fn expr(input: Input, r: inout Resolver, id: syntax.ExprId) -> ! OutOfMemory {
    let ast: syntax.Ast = input.program.files[usize.(r.file)].ast
    match ast.exprs[usize.(id)].kind {
        name(name: syntax.Span) {
            let res: ?Res = lookup(input, inout r, name)
            match res {
                none {
                    try undefined(input, inout r, name)
                }
                some(value as found: Res) {
                    match found {
                        package(id: _) {
                            let text: []u8 = text_of(input, r.file, name)
                            try problem(inout r, name.start, "`{text}` is a package; use one of its names, as in `{text}.name`")
                        }
                        _ {
                        }
                    }
                }
            }
            set_expr(inout r, id, res)
        }
        int, float, char {
        }
        str(parts: syntax.List) {
            for let i: u32 in syntax.items(ast.extra, parts) {
                match ast.str_parts[usize.(i)] {
                    interpolation(value: syntax.ExprId) {
                        try expr(input, inout r, value)
                    }
                    text(span: _) {
                    }
                }
            }
        }
        paren(inner: syntax.ExprId) {
            try expr(input, inout r, inner)
        }
        deref(inner: syntax.ExprId) {
            try expr(input, inout r, inner)
        }
        try_expr(operand: syntax.ExprId) {
            try expr(input, inout r, operand)
        }
        unary(op: _, operand: syntax.ExprId) {
            try expr(input, inout r, operand)
        }
        unsafe_expr(body: syntax.ExprId) {
            try expr(input, inout r, body)
        }
        tuple(items: syntax.List) {
            for let i: u32 in syntax.items(ast.extra, items) {
                let item: syntax.ExprId = ast.tuple_items[usize.(i)].value
                try expr(input, inout r, item)
            }
        }
        call(callee as c: syntax.ExprId, args: syntax.List) {
            try callee(input, inout r, c)
            for let i: u32 in syntax.items(ast.extra, args) {
                let item: syntax.ExprId = ast.args[usize.(i)].value
                try expr(input, inout r, item)
            }
        }
        field(value: syntax.ExprId, name: syntax.Span) {
            var package: ?u32 = none
            match ast.exprs[usize.(value)].kind {
                name(name as package_name: syntax.Span) {
                    match lookup(input, inout r, package_name) {
                        some(value as found: Res) {
                            match found {
                                package(id as p: u32) {
                                    package = some.(value: p)
                                }
                                _ {
                                }
                            }
                        }
                        none {
                        }
                    }
                }
                _ {
                }
            }
            match package {
                some(value as p: u32) {
                    set_expr(inout r, value, some.(value: Res.package.(id: p)))
                    match try member(input, inout r, p, name) {
                        some(value as decl: maps.DeclRef) {
                            set_expr(inout r, id, some.(value: Res.decl.(decl: decl)))
                        }
                        none {
                        }
                    }
                }
                none {
                    try expr(input, inout r, value)
                }
            }
        }
        construct(ty as t: syntax.ExprId, value: syntax.ExprId) {
            try expr(input, inout r, t)
            try expr(input, inout r, value)
        }
        index(value: syntax.ExprId, index as i: syntax.Index) {
            try expr(input, inout r, value)
            match i {
                value(value as e: syntax.ExprId) {
                    try expr(input, inout r, e)
                }
                ty(ty as t: syntax.TypeId) {
                    try ty(input, inout r, t)
                }
                slice(start: ?syntax.ExprId, end: ?syntax.ExprId) {
                    try opt_expr(input, inout r, start)
                    try opt_expr(input, inout r, end)
                }
            }
        }
        binary(op: _, left: syntax.ExprId, right: syntax.ExprId) {
            try expr(input, inout r, left)
            try expr(input, inout r, right)
        }
        if_expr(cond: syntax.ExprId, then: syntax.ExprId, otherwise: syntax.IfElse) {
            try expr(input, inout r, cond)
            try expr(input, inout r, then)
            match otherwise {
                branch(value: syntax.ExprId) {
                    try expr(input, inout r, value)
                }
                if_expr(value: syntax.ExprId) {
                    try expr(input, inout r, value)
                }
            }
        }
        match_expr(value: syntax.ExprId, arms as list: syntax.List) {
            try expr(input, inout r, value)
            try arms(input, inout r, list)
        }
        array(elems: syntax.List) {
            for let e: u32 in syntax.items(ast.extra, elems) {
                try expr(input, inout r, syntax.ExprId.(e))
            }
        }
    }
    return ok
}
