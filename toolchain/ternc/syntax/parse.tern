// A recursive descent parser, one function per rule of
// tree-sitter/grammar.js, ported from stage 1's parser.
//
// Every choice is made from the next token, with two exceptions: after
// `(`, an identifier followed by `:` starts a tuple literal; and in an
// index, `[e]` is an array literal when `]` follows it and an array type
// otherwise.
//
// On an error, the parser records a diagnostic and skips to the end of the
// statement or declaration, then continues.
//
// A list is gathered on the scratch stack, then copied into the tree's
// `extra` once it is complete, since the items of a nested list are
// gathered in the middle of it.

pub type ParseProblem enum {
    expected(what: []u8, found: Found)
    imports_first
    variadic_first
    empty_tuple_type
    empty_destructuring
    list_spans_lines
    defer_needs_call
    not_a_statement
    range_bound
    logic_mix
    comparison_chain
    shift_chain
    operator_mix(first: BinaryOp, next: BinaryOp)
}

// The token an `expected` problem found, which its span covers.
pub type Found enum {
    end_of_file
    end_of_line
    token
}

pub type ParseDiagnostic (pub start: u32, pub end: u32, pub problem: ParseProblem)

pub type Parsed (
    pub ast: Ast,
    pub lex_diagnostics: [..]Diagnostic,
    pub diagnostics: [..]ParseDiagnostic,
)

// Why a parse function returned without a node. On `failed` the problem
// is recorded and the caller recovers.
type Stop enum {
    failed
    out_of_memory
}

type Parser (
    text: []u8,
    tokens: [..]Token,
    pos: usize,
    ast: Ast,
    scratch: [..]u32,
    diagnostics: [..]ParseDiagnostic,
)

// Parses one item of a list and returns its index in its arena.
type Item fn(inout Parser) -> u32 ! Stop

// Lexes and parses one file.
pub fn parse(alloc: Allocator, text: []u8) -> Parsed ! OutOfMemory {
    var lexed: Lexed = try lex(alloc, text)
    var p: Parser = Parser.(
        text: text,
        tokens: lexed.tokens,
        pos: 0,
        ast: new_ast(alloc),
        scratch: make(alloc),
        diagnostics: make(alloc),
    )
    let result: ! Stop = file(inout p)
    free(inout p.tokens)
    free(inout p.scratch)
    match result {
        ok {
            let parsed: Parsed = Parsed.(
                ast: p.ast,
                lex_diagnostics: lexed.diagnostics,
                diagnostics: p.diagnostics,
            )
            return ok.(value: parsed)
        }
        err(error: _) {
            free_ast(inout p.ast)
            free(inout p.diagnostics)
            free(inout lexed.diagnostics)
            return err.(error: OutOfMemory.out_of_memory)
        }
    }
}

pub fn free_parsed(parsed: inout Parsed) {
    free_ast(inout parsed.ast)
    free(inout parsed.lex_diagnostics)
    free(inout parsed.diagnostics)
}

fn memory(result: ! OutOfMemory) -> ! Stop {
    match result {
        ok {
            return ok
        }
        err(error: _) {
            return err.(error: Stop.out_of_memory)
        }
    }
}

// Token access.

fn next_kind(p: Parser) -> TokenKind {
    return kind_at(p, 0)
}

fn kind_at(p: Parser, ahead: usize) -> TokenKind {
    let at: usize = p.pos + ahead
    if at >= p.tokens.len {
        return TokenKind.eof
    }
    return p.tokens[at].kind
}

fn current(p: Parser) -> Token {
    if p.pos < p.tokens.len {
        return p.tokens[p.pos]
    }
    return p.tokens[p.tokens.len - 1]
}

fn current_span(p: Parser) -> Span {
    let t: Token = current(p)
    return Span.(start: t.start, end: t.end)
}

// Moves past the current token, unless it is the end of the file.
fn advance(p: inout Parser) {
    if next_kind(p) != TokenKind.eof {
        p.pos += 1
    }
}

fn eat(p: inout Parser, k: TokenKind) -> bool {
    if next_kind(p) == k {
        advance(inout p)
        return true
    }
    return false
}

// The end of the last token moved past.
fn prev_end(p: Parser) -> u32 {
    if p.pos == 0 {
        return 0
    }
    return p.tokens[p.pos - 1].end
}

fn token_start(p: Parser) -> u32 {
    return current(p).start
}

fn span_from(p: Parser, from: u32) -> Span {
    var end: u32 = prev_end(p)
    if end < from {
        end = from
    }
    return Span.(start: from, end: end)
}

// Errors. Each returns the Stop to return with.

// Records a problem. Problems at or before the last one are dropped,
// since they usually follow from it.
fn fail_at(p: inout Parser, span: Span, problem: ParseProblem) -> Stop {
    let n: usize = p.diagnostics.len
    if n > 0 && span.start <= p.diagnostics[n - 1].start {
        return Stop.failed
    }
    let d: ParseDiagnostic = ParseDiagnostic.(start: span.start, end: span.end, problem: problem)
    match push(inout p.diagnostics, d) {
        ok {
            return Stop.failed
        }
        err(error: _) {
            return Stop.out_of_memory
        }
    }
}

fn fail_here(p: inout Parser, problem: ParseProblem) -> Stop {
    let span: Span = current_span(p)
    return fail_at(inout p, span, problem)
}

fn expected(p: inout Parser, what: []u8) -> Stop {
    let t: Token = current(p)
    var found: Found = Found.token
    if t.kind == TokenKind.eof {
        found = Found.end_of_file
    } else if t.kind == TokenKind.semicolon && t.start == t.end {
        found = Found.end_of_line
    }
    return fail_here(inout p, ParseProblem.expected.(what: what, found: found))
}

fn expect(p: inout Parser, k: TokenKind, what: []u8) -> ! Stop {
    if eat(inout p, k) {
        return ok
    }
    return err.(error: expected(inout p, what))
}

fn name(p: inout Parser) -> Span ! Stop {
    if next_kind(p) != TokenKind.ident {
        return err.(error: expected(inout p, "a name"))
    }
    let span: Span = current_span(p)
    advance(inout p)
    return ok.(value: span)
}

// Skips to the end of the current line item: past a `;`, or up to a `}`
// that closes the enclosing braces. Brackets opened while skipping are
// skipped whole.
fn recover(p: inout Parser) {
    var depth: u32 = 0
    for {
        match next_kind(p) {
            eof {
                return
            }
            semicolon {
                if depth == 0 {
                    advance(inout p)
                    return
                }
            }
            r_brace {
                if depth == 0 {
                    return
                }
                depth -= 1
            }
            l_paren, l_bracket, l_brace, str_start {
                depth += 1
            }
            r_paren, r_bracket, str_end {
                if depth > 0 {
                    depth -= 1
                }
            }
            _ {
            }
        }
        advance(inout p)
    }
}

// Lists.

// Copies the scratch items from `mark` up into `extra`.
fn finish(p: inout Parser, mark: usize) -> List ! Stop {
    let start: usize = p.ast.extra.len
    try memory(append(inout p.ast.extra, p.scratch[mark..]))
    drop_scratch(inout p, mark)
    return ok.(value: List.(start: u32.(start), len: u32.(p.ast.extra.len - start)))
}

fn drop_scratch(p: inout Parser, mark: usize) {
    for p.scratch.len > mark {
        let _: ?u32 = pop(inout p.scratch)
    }
}

fn gather(p: inout Parser, index: u32) -> ! Stop {
    return memory(push(inout p.scratch, index))
}

// Items between braces, separated by line ends or `;`. The `{` is
// consumed already; this consumes the `}`.
fn lines(p: inout Parser, item: Item) -> List ! Stop {
    let mark: usize = p.scratch.len
    for {
        if eat(inout p, TokenKind.r_brace) {
            return finish(inout p, mark)
        }
        if next_kind(p) == TokenKind.eof {
            return err.(error: expected(inout p, "`}`"))
        }
        let before: usize = p.scratch.len
        match item(inout p) {
            ok(value as index: u32) {
                try gather(inout p, index)
                match next_kind(p) {
                    semicolon {
                        advance(inout p)
                    }
                    r_brace {
                    }
                    _ {
                        let stop: Stop = expected(inout p, "the end of the line or `;`")
                        if stop == Stop.out_of_memory {
                            return err.(error: stop)
                        }
                        recover(inout p)
                    }
                }
            }
            err(error: Stop) {
                if error == Stop.out_of_memory {
                    return err.(error: error)
                }
                drop_scratch(inout p, before)
                recover(inout p)
            }
        }
    }
}

// Items between parentheses, separated by commas, with an optional
// trailing comma. The `(` is consumed already; this consumes the `)`.
fn comma_list(p: inout Parser, item: Item) -> List ! Stop {
    let mark: usize = p.scratch.len
    for {
        if eat(inout p, TokenKind.r_paren) {
            return finish(inout p, mark)
        }
        let index: u32 = try item(inout p)
        try gather(inout p, index)
        let t: Token = current(p)
        if t.kind == TokenKind.semicolon && t.start == t.end {
            return err.(error: fail_here(inout p, ParseProblem.list_spans_lines))
        }
        if !eat(inout p, TokenKind.comma) {
            try expect(inout p, TokenKind.r_paren, "`,` or `)`")
            return finish(inout p, mark)
        }
    }
}

// Arenas.

fn add_type(p: inout Parser, k: TypeKind, from: u32) -> TypeId ! Stop {
    let t: Type = Type.(kind: k, span: span_from(p, from))
    try memory(push(inout p.ast.types, t))
    return ok.(value: TypeId.(u32.(p.ast.types.len - 1)))
}

fn add_name(p: inout Parser, span: Span) -> u32 ! Stop {
    try memory(push(inout p.ast.names, span))
    return ok.(value: u32.(p.ast.names.len - 1))
}

// Declarations.

fn file(p: inout Parser) -> ! Stop {
    for next_kind(p) == TokenKind.kw_import {
        match import_decl(inout p) {
            ok(value as i: Import) {
                try memory(push(inout p.ast.imports, i))
                try end_top_level_item(inout p)
            }
            err(error: Stop) {
                try recovered(inout p, error)
                recover(inout p)
            }
        }
    }
    for next_kind(p) != TokenKind.eof {
        if next_kind(p) == TokenKind.kw_import {
            let stop: Stop = fail_here(inout p, ParseProblem.imports_first)
            try recovered(inout p, stop)
            recover(inout p)
            continue
        }
        match declaration(inout p) {
            ok(value as d: Decl) {
                try memory(push(inout p.ast.decls, d))
                try end_top_level_item(inout p)
            }
            err(error: Stop) {
                try recovered(inout p, error)
                recover_top_level(inout p)
            }
        }
    }
    return ok
}

// Passes out_of_memory on, and clears the scratch items a failed
// top-level item left.
fn recovered(p: inout Parser, stop: Stop) -> ! Stop {
    if stop == Stop.out_of_memory {
        return err.(error: stop)
    }
    drop_scratch(inout p, 0)
    return ok
}

fn end_top_level_item(p: inout Parser) -> ! Stop {
    if !eat(inout p, TokenKind.semicolon) && next_kind(p) != TokenKind.eof {
        let stop: Stop = expected(inout p, "the end of the line or `;`")
        try recovered(inout p, stop)
        recover_top_level(inout p)
    }
    return ok
}

fn recover_top_level(p: inout Parser) {
    recover(inout p)
    // A stray `}` at the top level would stop recovery forever.
    for eat(inout p, TokenKind.r_brace) {
        recover(inout p)
    }
}

fn import_decl(p: inout Parser) -> Import ! Stop {
    let from: u32 = token_start(p)
    advance(inout p)
    let mark: usize = p.scratch.len
    for {
        let n: Span = try name(inout p)
        let index: u32 = try add_name(inout p, n)
        try gather(inout p, index)
        if !eat(inout p, TokenKind.dot) {
            break
        }
    }
    let path: List = try finish(inout p, mark)
    var alias: ?Span = none
    if eat(inout p, TokenKind.kw_as) {
        alias = some.(value: try name(inout p))
    }
    return ok.(value: Import.(path: path, alias: alias, span: span_from(p, from)))
}

fn declaration(p: inout Parser) -> Decl ! Stop {
    let from: u32 = token_start(p)
    let mark: usize = p.scratch.len
    for next_kind(p) == TokenKind.attribute {
        let index: u32 = try attribute(inout p)
        try gather(inout p, index)
        // An attribute on its own line ends with an inserted `;`.
        let _: bool = eat(inout p, TokenKind.semicolon)
    }
    let attributes: List = try finish(inout p, mark)
    let public: bool = eat(inout p, TokenKind.kw_pub)
    let k: DeclKind = try declaration_kind(inout p)
    let d: Decl = Decl.(attributes: attributes, public: public, kind: k, span: span_from(p, from))
    return ok.(value: d)
}

fn declaration_kind(p: inout Parser) -> DeclKind ! Stop {
    match next_kind(p) {
        kw_fn {
            return function(inout p, false)
        }
        kw_unsafe {
            advance(inout p)
            if next_kind(p) != TokenKind.kw_fn {
                return err.(error: expected(inout p, "`fn` after `unsafe`"))
            }
            return function(inout p, true)
        }
        kw_extern {
            advance(inout p)
            match next_kind(p) {
                kw_fn {
                    return extern_function(inout p)
                }
                kw_let, kw_var {
                    let mutable: bool = next_kind(p) == TokenKind.kw_var
                    advance(inout p)
                    let n: Span = try name(inout p)
                    try expect(inout p, TokenKind.colon, "`:`")
                    let ty: TypeId = try type_expr(inout p)
                    return ok.(value: DeclKind.extern_var.(mutable: mutable, name: n, ty: ty))
                }
                _ {
                    return err.(error: expected(inout p, "`fn`, `let` or `var` after `extern`"))
                }
            }
        }
        kw_type {
            return type_declaration(inout p)
        }
        kw_let, kw_var {
            let l: Local = try local(inout p)
            return ok.(value: DeclKind.global.(is_shared: false, local: l))
        }
        kw_shared {
            advance(inout p)
            if next_kind(p) != TokenKind.kw_var {
                return err.(error: expected(inout p, "`var` after `shared`"))
            }
            let l: Local = try local(inout p)
            return ok.(value: DeclKind.global.(is_shared: true, local: l))
        }
        _ {
            return err.(error: expected(inout p, "a declaration"))
        }
    }
}

// `@name` or `@name(args)`, with the `(` written right after the name.
fn attribute(p: inout Parser) -> u32 ! Stop {
    let n: Span = current_span(p)
    advance(inout p)
    var args: List = List.(start: 0, len: 0)
    if next_kind(p) == TokenKind.l_paren && token_start(p) == n.end {
        advance(inout p)
        args = try comma_list(inout p, attribute_arg)
    }
    try memory(push(inout p.ast.attributes, Attribute.(name: n, args: args)))
    return ok.(value: u32.(p.ast.attributes.len - 1))
}

fn attribute_arg(p: inout Parser) -> u32 ! Stop {
    match next_kind(p) {
        int, str, str_start {
            return ok.(value: u32.(try primary(inout p)))
        }
        _ {
            return err.(error: expected(inout p, "an integer or string literal"))
        }
    }
}

fn function(p: inout Parser, is_unsafe: bool) -> DeclKind ! Stop {
    advance(inout p)
    let n: Span = try name(inout p)
    try expect(inout p, TokenKind.l_paren, "`(`")
    let params: List = try comma_list(inout p, parameter)
    let result: ?TypeId = try result_type(inout p)
    let body: Block = try block(inout p)
    return ok.(value: DeclKind.function.(
        is_unsafe: is_unsafe,
        name: n,
        params: params,
        result: result,
        body: body,
    ))
}

fn result_type(p: inout Parser) -> ?TypeId ! Stop {
    if eat(inout p, TokenKind.arrow) {
        return ok.(value: some.(value: try type_expr(inout p)))
    }
    return ok.(value: none)
}

fn extern_function(p: inout Parser) -> DeclKind ! Stop {
    advance(inout p)
    let n: Span = try name(inout p)
    try expect(inout p, TokenKind.l_paren, "`(`")
    let mark: usize = p.scratch.len
    var variadic: bool = false
    for {
        if eat(inout p, TokenKind.r_paren) {
            break
        }
        if next_kind(p) == TokenKind.dot_dot_dot {
            if p.scratch.len == mark {
                return err.(error: fail_here(inout p, ParseProblem.variadic_first))
            }
            advance(inout p)
            variadic = true
            let _: bool = eat(inout p, TokenKind.comma)
            try expect(inout p, TokenKind.r_paren, "`)` after `...`")
            break
        }
        let index: u32 = try parameter(inout p)
        try gather(inout p, index)
        if !eat(inout p, TokenKind.comma) {
            try expect(inout p, TokenKind.r_paren, "`,` or `)`")
            break
        }
    }
    let params: List = try finish(inout p, mark)
    let result: ?TypeId = try result_type(inout p)
    return ok.(value: DeclKind.extern_fn.(name: n, params: params, variadic: variadic, result: result))
}

fn mode(p: inout Parser) -> Mode {
    if eat(inout p, TokenKind.kw_inout) {
        return Mode.inout_mode
    }
    return Mode.let_mode
}

fn parameter(p: inout Parser) -> u32 ! Stop {
    var n: ?Span = none
    if !eat(inout p, TokenKind.underscore) {
        n = some.(value: try name(inout p))
    }
    try expect(inout p, TokenKind.colon, "`:` and a type")
    let m: Mode = mode(inout p)
    let ty: TypeId = try type_expr(inout p)
    try memory(push(inout p.ast.params, Param.(name: n, mode: m, ty: ty)))
    return ok.(value: u32.(p.ast.params.len - 1))
}

fn type_declaration(p: inout Parser) -> DeclKind ! Stop {
    advance(inout p)
    let n: Span = try name(inout p)
    let def: TypeDef = try type_def(inout p)
    return ok.(value: DeclKind.type_decl.(name: n, def: def))
}

fn type_def(p: inout Parser) -> TypeDef ! Stop {
    match next_kind(p) {
        kw_enum {
            return enum_type(inout p)
        }
        kw_union {
            advance(inout p)
            try expect(inout p, TokenKind.l_paren, "`(`")
            let fs: List = try fields(inout p)
            return ok.(value: TypeDef.union_type.(fields: fs))
        }
        _ {
            let ty: TypeId = try type_expr(inout p)
            return ok.(value: TypeDef.plain.(ty: ty))
        }
    }
}

fn enum_type(p: inout Parser) -> TypeDef ! Stop {
    advance(inout p)
    var int_type: ?TypeId = none
    if next_kind(p) == TokenKind.ident {
        int_type = some.(value: try type_name(inout p))
    }
    try expect(inout p, TokenKind.l_brace, "`\{`")
    let variants: List = try lines(inout p, variant)
    return ok.(value: TypeDef.enum_type.(int_type: int_type, variants: variants))
}

fn variant(p: inout Parser) -> u32 ! Stop {
    let underscore: Span = current_span(p)
    var v: Variant = Variant.open.(span: underscore)
    if !eat(inout p, TokenKind.underscore) {
        let n: Span = try name(inout p)
        var payload: ?TypeId = none
        if next_kind(p) == TokenKind.l_paren {
            payload = some.(value: try simple_type(inout p))
        }
        var value: ?ExprId = none
        if eat(inout p, TokenKind.eq) {
            value = some.(value: try expression(inout p))
        }
        v = Variant.named.(name: n, payload: payload, value: value)
    }
    try memory(push(inout p.ast.variants, v))
    return ok.(value: u32.(p.ast.variants.len - 1))
}

// Fields of a tuple type, after the `(`. At least one.
fn fields(p: inout Parser) -> List ! Stop {
    let list: List = try comma_list(inout p, field)
    if list.len == 0 {
        let end: u32 = prev_end(p)
        let span: Span = Span.(start: end - 1, end: end)
        return err.(error: fail_at(inout p, span, ParseProblem.empty_tuple_type))
    }
    return ok.(value: list)
}

fn field(p: inout Parser) -> u32 ! Stop {
    let public: bool = eat(inout p, TokenKind.kw_pub)
    let n: Span = try name(inout p)
    try expect(inout p, TokenKind.colon, "`:` and a type")
    let ty: TypeId = try type_expr(inout p)
    try memory(push(inout p.ast.fields, Field.(public: public, name: n, ty: ty)))
    return ok.(value: u32.(p.ast.fields.len - 1))
}

// Types.

// A type: a simple type, a result type or a function type.
fn type_expr(p: inout Parser) -> TypeId ! Stop {
    let from: u32 = token_start(p)
    match next_kind(p) {
        kw_fn {
            advance(inout p)
            try expect(inout p, TokenKind.l_paren, "`(`")
            let params: List = try comma_list(inout p, function_type_param)
            let result: ?TypeId = try result_type(inout p)
            return add_type(inout p, TypeKind.function.(params: params, result: result), from)
        }
        bang {
            advance(inout p)
            let error: TypeId = try simple_type(inout p)
            return add_type(inout p, TypeKind.result.(value: none, error: error), from)
        }
        _ {
            let value: TypeId = try simple_type(inout p)
            if !eat(inout p, TokenKind.bang) {
                return ok.(value: value)
            }
            let error: TypeId = try simple_type(inout p)
            let k: TypeKind = TypeKind.result.(value: some.(value: value), error: error)
            return add_type(inout p, k, from)
        }
    }
}

fn function_type_param(p: inout Parser) -> u32 ! Stop {
    let m: Mode = mode(inout p)
    let ty: TypeId = try type_expr(inout p)
    try memory(push(inout p.ast.params, Param.(name: none, mode: m, ty: ty)))
    return ok.(value: u32.(p.ast.params.len - 1))
}

fn type_name(p: inout Parser) -> TypeId ! Stop {
    let from: u32 = token_start(p)
    let first: Span = try name(inout p)
    if eat(inout p, TokenKind.dot) {
        let second: Span = try name(inout p)
        return add_type(inout p, TypeKind.name.(package: some.(value: first), name: second), from)
    }
    return add_type(inout p, TypeKind.name.(package: none, name: first), from)
}

fn simple_type(p: inout Parser) -> TypeId ! Stop {
    let from: u32 = token_start(p)
    match next_kind(p) {
        ident {
            return type_name(inout p)
        }
        l_paren {
            advance(inout p)
            let fs: List = try fields(inout p)
            return add_type(inout p, TypeKind.tuple.(fields: fs), from)
        }
        star {
            advance(inout p)
            let elem: TypeId = try simple_type(inout p)
            return add_type(inout p, TypeKind.pointer.(elem: elem), from)
        }
        question {
            advance(inout p)
            let elem: TypeId = try simple_type(inout p)
            return add_type(inout p, TypeKind.optional.(elem: elem), from)
        }
        l_bracket {
            advance(inout p)
            if eat(inout p, TokenKind.r_bracket) {
                let elem: TypeId = try simple_type(inout p)
                return add_type(inout p, TypeKind.view.(elem: elem), from)
            }
            if eat(inout p, TokenKind.dot_dot) {
                try expect(inout p, TokenKind.r_bracket, "`]` after `[..`")
                let elem: TypeId = try simple_type(inout p)
                return add_type(inout p, TypeKind.growable.(elem: elem), from)
            }
            let len: ExprId = try expression(inout p)
            try expect(inout p, TokenKind.r_bracket, "`]`")
            let elem: TypeId = try simple_type(inout p)
            return add_type(inout p, TypeKind.array.(len: len, elem: elem), from)
        }
        _ {
            return err.(error: expected(inout p, "a type"))
        }
    }
}

// Bindings.

// `let` or `var`, a binding, `=` and a value.
fn local(p: inout Parser) -> Local ! Stop {
    let mutable: bool = next_kind(p) == TokenKind.kw_var
    advance(inout p)
    let b: Binding = try binding(inout p)
    if !eat(inout p, TokenKind.eq) {
        return err.(error: expected(inout p, "`=` and a value; every binding is initialized"))
    }
    let value: ExprId = try expression(inout p)
    return ok.(value: Local.(mutable: mutable, binding: b, value: value))
}

fn binding(p: inout Parser) -> Binding ! Stop {
    if eat(inout p, TokenKind.l_paren) {
        return ok.(value: Binding.destructure.(fields: try destructuring(inout p)))
    }
    var n: ?Span = none
    if !eat(inout p, TokenKind.underscore) {
        n = some.(value: try name(inout p))
    }
    if !eat(inout p, TokenKind.colon) {
        return err.(error: expected(inout p, "`:` and a type; every binding states its type"))
    }
    let ty: TypeId = try type_expr(inout p)
    return ok.(value: Binding.single.(name: n, ty: ty))
}

// `(q: u32, r as rest: _)`, after the `(`. At least one field.
fn destructuring(p: inout Parser) -> List ! Stop {
    let list: List = try comma_list(inout p, destruct_field)
    if list.len == 0 {
        let end: u32 = prev_end(p)
        let span: Span = span_from(p, end - 1)
        return err.(error: fail_at(inout p, span, ParseProblem.empty_destructuring))
    }
    return ok.(value: list)
}

fn destruct_field(p: inout Parser) -> u32 ! Stop {
    let f: Span = try name(inout p)
    var rename: ?Span = none
    if eat(inout p, TokenKind.kw_as) {
        rename = some.(value: try name(inout p))
    }
    try expect(inout p, TokenKind.colon, "`:` and a type")
    var ty: ?TypeId = none
    if !eat(inout p, TokenKind.underscore) {
        ty = some.(value: try type_expr(inout p))
    }
    try memory(push(inout p.ast.destructs, DestructField.(field: f, rename: rename, ty: ty)))
    return ok.(value: u32.(p.ast.destructs.len - 1))
}

// Statements.

fn block(p: inout Parser) -> Block ! Stop {
    let from: u32 = token_start(p)
    try expect(inout p, TokenKind.l_brace, "`\{`")
    let stmts: List = try lines(inout p, statement_item)
    return ok.(value: Block.(stmts: stmts, span: span_from(p, from)))
}

fn statement_item(p: inout Parser) -> u32 ! Stop {
    return ok.(value: u32.(try statement(inout p)))
}

fn add_stmt(p: inout Parser, k: StmtKind, from: u32) -> StmtId ! Stop {
    let s: Stmt = Stmt.(kind: k, span: span_from(p, from))
    try memory(push(inout p.ast.stmts, s))
    return ok.(value: StmtId.(u32.(p.ast.stmts.len - 1)))
}

fn statement(p: inout Parser) -> StmtId ! Stop {
    let from: u32 = token_start(p)
    if next_kind(p) == TokenKind.kw_if {
        return if_statement(inout p)
    }
    let k: StmtKind = try statement_kind(inout p)
    return add_stmt(inout p, k, from)
}

fn statement_kind(p: inout Parser) -> StmtKind ! Stop {
    match next_kind(p) {
        kw_let, kw_var {
            let l: Local = try local(inout p)
            return ok.(value: StmtKind.local.(local: l))
        }
        kw_return {
            advance(inout p)
            match next_kind(p) {
                semicolon, r_brace, eof {
                    return ok.(value: StmtKind.return_stmt.(value: none))
                }
                _ {
                    let value: ExprId = try expression(inout p)
                    return ok.(value: StmtKind.return_stmt.(value: some.(value: value)))
                }
            }
        }
        kw_match {
            advance(inout p)
            let value: ExprId = try expression(inout p)
            try expect(inout p, TokenKind.l_brace, "`\{`")
            let arms: List = try lines(inout p, statement_arm)
            return ok.(value: StmtKind.match_stmt.(value: value, arms: arms))
        }
        kw_for {
            return for_statement(inout p)
        }
        kw_break {
            advance(inout p)
            return ok.(value: StmtKind.break_stmt)
        }
        kw_continue {
            advance(inout p)
            return ok.(value: StmtKind.continue_stmt)
        }
        kw_defer {
            advance(inout p)
            let call: ExprId = try postfix(inout p)
            try require_call(inout p, call, ParseProblem.defer_needs_call)
            return ok.(value: StmtKind.defer_stmt.(call: call))
        }
        kw_unsafe {
            advance(inout p)
            let body: Block = try block(inout p)
            return ok.(value: StmtKind.unsafe_stmt.(body: body))
        }
        kw_lock {
            advance(inout p)
            let mark: usize = p.scratch.len
            for {
                let index: u32 = try global_name(inout p)
                try gather(inout p, index)
                if !eat(inout p, TokenKind.comma) {
                    break
                }
            }
            let globals: List = try finish(inout p, mark)
            let body: Block = try block(inout p)
            return ok.(value: StmtKind.lock_stmt.(globals: globals, body: body))
        }
        kw_try {
            let value: ExprId = try unary(inout p)
            return ok.(value: StmtKind.expr.(value: value))
        }
        ident, int, float, char, str, str_start, l_paren {
            let left: ExprId = try postfix(inout p)
            match assign_op(next_kind(p)) {
                some(value as op: AssignOp) {
                    advance(inout p)
                    let right: ExprId = try expression(inout p)
                    return ok.(value: StmtKind.assign.(left: left, op: op, right: right))
                }
                none {
                    try require_call(inout p, left, ParseProblem.not_a_statement)
                    return ok.(value: StmtKind.expr.(value: left))
                }
            }
        }
        _ {
            return err.(error: expected(inout p, "a statement"))
        }
    }
}

fn require_call(p: inout Parser, e: ExprId, problem: ParseProblem) -> ! Stop {
    let node: Expr = p.ast.exprs[usize.(e)]
    match node.kind {
        call(callee: _, args: _) {
            return ok
        }
        _ {
            return err.(error: fail_at(inout p, node.span, problem))
        }
    }
}

fn statement_arm(p: inout Parser) -> u32 ! Stop {
    let pats: List = try patterns(inout p)
    let body: Block = try block(inout p)
    try memory(push(inout p.ast.arms, Arm.(patterns: pats, body: ArmBody.block.(body: body))))
    return ok.(value: u32.(p.ast.arms.len - 1))
}

fn global_name(p: inout Parser) -> u32 ! Stop {
    let first: Span = try name(inout p)
    var g: GlobalName = GlobalName.(package: none, name: first)
    if eat(inout p, TokenKind.dot) {
        let second: Span = try name(inout p)
        g = GlobalName.(package: some.(value: first), name: second)
    }
    try memory(push(inout p.ast.globals, g))
    return ok.(value: u32.(p.ast.globals.len - 1))
}

fn if_statement(p: inout Parser) -> StmtId ! Stop {
    let from: u32 = token_start(p)
    advance(inout p)
    let cond: ExprId = try expression(inout p)
    let then: Block = try block(inout p)
    var otherwise: ?Else = none
    if eat(inout p, TokenKind.kw_else) {
        if next_kind(p) == TokenKind.kw_if {
            let nested: StmtId = try if_statement(inout p)
            otherwise = some.(value: Else.if_stmt.(stmt: nested))
        } else {
            let body: Block = try block(inout p)
            otherwise = some.(value: Else.block.(body: body))
        }
    }
    let k: StmtKind = StmtKind.if_stmt.(cond: cond, then: then, otherwise: otherwise)
    return add_stmt(inout p, k, from)
}

fn for_statement(p: inout Parser) -> StmtKind ! Stop {
    advance(inout p)
    let k: ForKind = try for_kind(inout p)
    let body: Block = try block(inout p)
    return ok.(value: StmtKind.for_stmt.(kind: k, body: body))
}

fn for_kind(p: inout Parser) -> ForKind ! Stop {
    match next_kind(p) {
        l_brace {
            return ok.(value: ForKind.forever)
        }
        kw_let, kw_var {
            let mutable: bool = next_kind(p) == TokenKind.kw_var
            advance(inout p)
            let b: Binding = try binding(inout p)
            try expect(inout p, TokenKind.kw_in, "`in`")
            let first: ExprId = try expression(inout p)
            var iterable: Iterable = Iterable.value.(value: first)
            if eat(inout p, TokenKind.dot_dot) {
                try require_additive(inout p, first)
                let end: ExprId = try expression(inout p)
                try require_additive(inout p, end)
                iterable = Iterable.range.(start: first, end: end)
            }
            return ok.(value: ForKind.for_in.(mutable: mutable, binding: b, iterable: iterable))
        }
        _ {
            let cond: ExprId = try expression(inout p)
            return ok.(value: ForKind.while_loop.(cond: cond))
        }
    }
}

// Range and slice bounds are arithmetic: anything that binds tighter than
// comparison, except bitwise operators.
fn require_additive(p: inout Parser, e: ExprId) -> ! Stop {
    let node: Expr = p.ast.exprs[usize.(e)]
    var arithmetic: bool = true
    match node.kind {
        binary(op: BinaryOp, left: _, right: _) {
            let group: OpGroup = op_group(op)
            arithmetic = group == OpGroup.additive || group == OpGroup.multiplicative
        }
        if_expr(cond: _, then: _, otherwise: _), match_expr(value: _, arms: _), unsafe_expr(body: _), array(elems: _) {
            arithmetic = false
        }
        _ {
        }
    }
    if arithmetic {
        return ok
    }
    return err.(error: fail_at(inout p, node.span, ParseProblem.range_bound))
}

fn assign_op(k: TokenKind) -> ?AssignOp {
    return match k {
        eq { some.(value: AssignOp.set) }
        plus_eq { some.(value: AssignOp.add) }
        minus_eq { some.(value: AssignOp.sub) }
        star_eq { some.(value: AssignOp.mul) }
        slash_eq { some.(value: AssignOp.div) }
        percent_eq { some.(value: AssignOp.rem) }
        amp_eq { some.(value: AssignOp.bit_and) }
        pipe_eq { some.(value: AssignOp.bit_or) }
        caret_eq { some.(value: AssignOp.bit_xor) }
        shl_eq { some.(value: AssignOp.shl) }
        shr_eq { some.(value: AssignOp.shr) }
        _ { none }
    }
}

// Patterns.

// One or more patterns separated by commas.
fn patterns(p: inout Parser) -> List ! Stop {
    let mark: usize = p.scratch.len
    for {
        let index: u32 = try pattern(inout p)
        try gather(inout p, index)
        if !eat(inout p, TokenKind.comma) {
            return finish(inout p, mark)
        }
    }
}

fn pattern(p: inout Parser) -> u32 ! Stop {
    let from: u32 = token_start(p)
    let k: PatternKind = try pattern_kind(inout p)
    let pat: Pattern = Pattern.(kind: k, span: span_from(p, from))
    try memory(push(inout p.ast.pats, pat))
    return ok.(value: u32.(p.ast.pats.len - 1))
}

fn pattern_kind(p: inout Parser) -> PatternKind ! Stop {
    match next_kind(p) {
        ident {
            let n: Span = try name(inout p)
            if eat(inout p, TokenKind.l_paren) {
                let payload: List = try destructuring(inout p)
                return ok.(value: PatternKind.variant.(name: n, payload: some.(value: payload)))
            }
            return ok.(value: PatternKind.variant.(name: n, payload: none))
        }
        int, char, str, str_start {
            let value: ExprId = try primary(inout p)
            return ok.(value: PatternKind.literal.(value: value))
        }
        minus {
            advance(inout p)
            if next_kind(p) != TokenKind.int {
                return err.(error: expected(inout p, "an integer after `-` in a pattern"))
            }
            let value: ExprId = try primary(inout p)
            return ok.(value: PatternKind.negative.(value: value))
        }
        underscore {
            advance(inout p)
            return ok.(value: PatternKind.discard)
        }
        _ {
            return err.(error: expected(inout p, "a pattern"))
        }
    }
}

// Expressions, from loosest to tightest.

fn add_expr(p: inout Parser, k: ExprKind, from: u32) -> ExprId ! Stop {
    let e: Expr = Expr.(kind: k, span: span_from(p, from))
    try memory(push(inout p.ast.exprs, e))
    return ok.(value: ExprId.(u32.(p.ast.exprs.len - 1)))
}

// A full expression. `if`, `match`, `unsafe` and array literals appear
// only here, never as operands.
fn expression(p: inout Parser) -> ExprId ! Stop {
    let from: u32 = token_start(p)
    match next_kind(p) {
        kw_if {
            return if_expression(inout p)
        }
        kw_match {
            advance(inout p)
            let value: ExprId = try expression(inout p)
            try expect(inout p, TokenKind.l_brace, "`\{`")
            let arms: List = try lines(inout p, expression_arm)
            return add_expr(inout p, ExprKind.match_expr.(value: value, arms: arms), from)
        }
        kw_unsafe {
            advance(inout p)
            let body: ExprId = try branch(inout p)
            return add_expr(inout p, ExprKind.unsafe_expr.(body: body), from)
        }
        l_bracket {
            advance(inout p)
            let first: ExprId = try expression(inout p)
            return array_literal(inout p, first, from)
        }
        _ {
            return logical(inout p)
        }
    }
}

fn expression_arm(p: inout Parser) -> u32 ! Stop {
    let pats: List = try patterns(inout p)
    let value: ExprId = try branch(inout p)
    try memory(push(inout p.ast.arms, Arm.(patterns: pats, body: ArmBody.branch.(value: value))))
    return ok.(value: u32.(p.ast.arms.len - 1))
}

// The rest of an array literal after its first element.
fn array_literal(p: inout Parser, first: ExprId, from: u32) -> ExprId ! Stop {
    let mark: usize = p.scratch.len
    try gather(inout p, u32.(first))
    for eat(inout p, TokenKind.comma) {
        if next_kind(p) == TokenKind.r_bracket {
            break
        }
        let elem: ExprId = try expression(inout p)
        try gather(inout p, u32.(elem))
    }
    try expect(inout p, TokenKind.r_bracket, "`,` or `]`")
    let elems: List = try finish(inout p, mark)
    return add_expr(inout p, ExprKind.array.(elems: elems), from)
}

fn if_expression(p: inout Parser) -> ExprId ! Stop {
    let from: u32 = token_start(p)
    advance(inout p)
    let cond: ExprId = try expression(inout p)
    let then: ExprId = try branch(inout p)
    if !eat(inout p, TokenKind.kw_else) {
        return err.(error: expected(inout p, "`else`; an `if` expression needs both branches"))
    }
    var otherwise: IfElse = IfElse.branch.(value: then)
    if next_kind(p) == TokenKind.kw_if {
        let nested: ExprId = try if_expression(inout p)
        otherwise = IfElse.if_expr.(value: nested)
    } else {
        let value: ExprId = try branch(inout p)
        otherwise = IfElse.branch.(value: value)
    }
    let k: ExprKind = ExprKind.if_expr.(cond: cond, then: then, otherwise: otherwise)
    return add_expr(inout p, k, from)
}

// `{ expr }`: one expression in braces.
fn branch(p: inout Parser) -> ExprId ! Stop {
    try expect(inout p, TokenKind.l_brace, "`\{`")
    let value: ExprId = try expression(inout p)
    let _: bool = eat(inout p, TokenKind.semicolon)
    try expect(inout p, TokenKind.r_brace, "`}`; a branch holds one expression")
    return ok.(value: value)
}

fn binary(p: inout Parser, op: BinaryOp, left: ExprId, right: ExprId) -> ExprId ! Stop {
    let from: u32 = p.ast.exprs[usize.(left)].span.start
    return add_expr(inout p, ExprKind.binary.(op: op, left: left, right: right), from)
}

// The operator group of the next token, if it is a binary operator.
fn next_group(p: Parser) -> ?OpGroup {
    match binary_op(next_kind(p)) {
        some(value as op: BinaryOp) {
            return some.(value: op_group(op))
        }
        none {
            return none
        }
    }
}

fn next_is(p: Parser, group: OpGroup) -> bool {
    match next_group(p) {
        some(value: OpGroup) {
            return value == group
        }
        none {
            return false
        }
    }
}

fn next_is_op(p: Parser, op: BinaryOp) -> bool {
    match binary_op(next_kind(p)) {
        some(value: BinaryOp) {
            return value == op
        }
        none {
            return false
        }
    }
}

// The next token's binary operator. The caller has checked it is one.
fn next_op(p: Parser) -> BinaryOp {
    match binary_op(next_kind(p)) {
        some(value: BinaryOp) {
            return value
        }
        none {
            panic("no binary operator next")
        }
    }
}

// `a && b && c` or `a || b || c`. The two do not mix.
fn logical(p: inout Parser) -> ExprId ! Stop {
    var left: ExprId = try comparison(inout p)
    var group: OpGroup = OpGroup.and
    if next_is(p, OpGroup.or) {
        group = OpGroup.or
    } else if !next_is(p, OpGroup.and) {
        return ok.(value: left)
    }
    let op: BinaryOp = next_op(p)
    for next_is(p, group) {
        advance(inout p)
        let right: ExprId = try comparison(inout p)
        left = try binary(inout p, op, left, right)
    }
    if next_is(p, OpGroup.and) || next_is(p, OpGroup.or) {
        return err.(error: fail_here(inout p, ParseProblem.logic_mix))
    }
    return ok.(value: left)
}

// `a < b`. Comparisons do not chain.
fn comparison(p: inout Parser) -> ExprId ! Stop {
    let left: ExprId = try comparison_operand(inout p)
    if !next_is(p, OpGroup.comparison) {
        return ok.(value: left)
    }
    let op: BinaryOp = next_op(p)
    advance(inout p)
    let right: ExprId = try comparison_operand(inout p)
    let e: ExprId = try binary(inout p, op, left, right)
    if next_is(p, OpGroup.comparison) {
        return err.(error: fail_here(inout p, ParseProblem.comparison_chain))
    }
    return ok.(value: e)
}

// An operand of a comparison: arithmetic, or one kind of bitwise
// operator, or one shift.
fn comparison_operand(p: inout Parser) -> ExprId ! Stop {
    var left: ExprId = try unary(inout p)
    var group: OpGroup = OpGroup.or
    match next_group(p) {
        some(value: OpGroup) {
            group = value
        }
        none {
            return ok.(value: left)
        }
    }
    let first: BinaryOp = next_op(p)
    match group {
        additive, multiplicative {
            left = try multiplicative_tail(inout p, left)
            for next_is(p, OpGroup.additive) {
                let op: BinaryOp = next_op(p)
                advance(inout p)
                var right: ExprId = try unary(inout p)
                right = try multiplicative_tail(inout p, right)
                left = try binary(inout p, op, left, right)
            }
        }
        bit_and, bit_or, bit_xor {
            for next_is_op(p, first) {
                advance(inout p)
                let right: ExprId = try unary(inout p)
                left = try binary(inout p, first, left, right)
            }
        }
        shift {
            advance(inout p)
            let right: ExprId = try unary(inout p)
            left = try binary(inout p, first, left, right)
            if next_is(p, OpGroup.shift) {
                return err.(error: fail_here(inout p, ParseProblem.shift_chain))
            }
        }
        or, and, comparison {
            return ok.(value: left)
        }
    }
    match next_group(p) {
        some(value: OpGroup) {
            if value != OpGroup.or && value != OpGroup.and && value != OpGroup.comparison {
                let problem: ParseProblem = ParseProblem.operator_mix.(first: first, next: next_op(p))
                return err.(error: fail_here(inout p, problem))
            }
        }
        none {
        }
    }
    return ok.(value: left)
}

fn multiplicative_tail(p: inout Parser, start_with: ExprId) -> ExprId ! Stop {
    var left: ExprId = start_with
    for next_is(p, OpGroup.multiplicative) {
        let op: BinaryOp = next_op(p)
        advance(inout p)
        let right: ExprId = try unary(inout p)
        left = try binary(inout p, op, left, right)
    }
    return ok.(value: left)
}

fn unary(p: inout Parser) -> ExprId ! Stop {
    let from: u32 = token_start(p)
    var op: UnaryOp = UnaryOp.neg
    match next_kind(p) {
        minus {
            op = UnaryOp.neg
        }
        bang {
            op = UnaryOp.not
        }
        tilde {
            op = UnaryOp.bit_not
        }
        amp {
            op = UnaryOp.address_of
        }
        kw_try {
            advance(inout p)
            let inner: ExprId = try unary(inout p)
            return add_expr(inout p, ExprKind.try_expr.(operand: inner), from)
        }
        _ {
            return postfix(inout p)
        }
    }
    advance(inout p)
    let inner: ExprId = try unary(inout p)
    return add_expr(inout p, ExprKind.unary.(op: op, operand: inner), from)
}

fn postfix(p: inout Parser) -> ExprId ! Stop {
    let from: u32 = token_start(p)
    var e: ExprId = try primary(inout p)
    for {
        match next_kind(p) {
            l_paren {
                advance(inout p)
                let args: List = try comma_list(inout p, argument)
                e = try add_expr(inout p, ExprKind.call.(callee: e, args: args), from)
            }
            dot {
                advance(inout p)
                match next_kind(p) {
                    ident {
                        let n: Span = try name(inout p)
                        e = try add_expr(inout p, ExprKind.field.(value: e, name: n), from)
                    }
                    l_paren {
                        let value: ExprId = try paren_or_tuple(inout p)
                        e = try add_expr(inout p, ExprKind.construct.(ty: e, value: value), from)
                    }
                    _ {
                        return err.(error: expected(inout p, "a field name or `(` after `.`"))
                    }
                }
            }
            dot_star {
                advance(inout p)
                e = try add_expr(inout p, ExprKind.deref.(inner: e), from)
            }
            l_bracket {
                advance(inout p)
                let i: Index = try subscript(inout p)
                try expect(inout p, TokenKind.r_bracket, "`]`")
                e = try add_expr(inout p, ExprKind.index.(value: e, index: i), from)
            }
            _ {
                return ok.(value: e)
            }
        }
    }
}

fn argument(p: inout Parser) -> u32 ! Stop {
    let m: Mode = mode(inout p)
    let value: ExprId = try expression(inout p)
    try memory(push(inout p.ast.args, Arg.(mode: m, value: value)))
    return ok.(value: u32.(p.ast.args.len - 1))
}

// What goes between `[` and `]` after a value: an index, a slice, or a
// type argument.
fn subscript(p: inout Parser) -> Index ! Stop {
    match next_kind(p) {
        star, question, kw_fn {
            let t: TypeId = try type_expr(inout p)
            return ok.(value: Index.ty.(ty: t))
        }
        dot_dot {
            advance(inout p)
            let end: ExprId = try expression(inout p)
            try require_additive(inout p, end)
            return ok.(value: Index.slice.(start: none, end: some.(value: end)))
        }
        l_bracket {
            let after: TokenKind = kind_at(p, 1)
            if after == TokenKind.r_bracket || after == TokenKind.dot_dot {
                let t: TypeId = try type_expr(inout p)
                return ok.(value: Index.ty.(ty: t))
            }
            let from: u32 = token_start(p)
            advance(inout p)
            let first: ExprId = try expression(inout p)
            if next_kind(p) == TokenKind.r_bracket && kind_at(p, 1) != TokenKind.r_bracket {
                // `[n]T`: an array type.
                advance(inout p)
                let elem: TypeId = try simple_type(inout p)
                let t: TypeId = try add_type(inout p, TypeKind.array.(len: first, elem: elem), from)
                return ok.(value: Index.ty.(ty: t))
            }
            let array: ExprId = try array_literal(inout p, first, from)
            return ok.(value: Index.value.(value: array))
        }
        _ {
        }
    }
    let first: ExprId = try expression(inout p)
    if !eat(inout p, TokenKind.dot_dot) {
        return ok.(value: Index.value.(value: first))
    }
    try require_additive(inout p, first)
    var end: ?ExprId = none
    if next_kind(p) != TokenKind.r_bracket {
        let e: ExprId = try expression(inout p)
        try require_additive(inout p, e)
        end = some.(value: e)
    }
    return ok.(value: Index.slice.(start: some.(value: first), end: end))
}

fn primary(p: inout Parser) -> ExprId ! Stop {
    let from: u32 = token_start(p)
    match next_kind(p) {
        ident {
            let n: Span = try name(inout p)
            return add_expr(inout p, ExprKind.name.(name: n), from)
        }
        int {
            advance(inout p)
            return add_expr(inout p, ExprKind.int, from)
        }
        float {
            advance(inout p)
            return add_expr(inout p, ExprKind.float, from)
        }
        char {
            advance(inout p)
            return add_expr(inout p, ExprKind.char, from)
        }
        str, str_start {
            let parts: List = try string(inout p)
            return add_expr(inout p, ExprKind.str.(parts: parts), from)
        }
        l_paren {
            return paren_or_tuple(inout p)
        }
        _ {
            return err.(error: expected(inout p, "an expression"))
        }
    }
}

// A string literal: one `str` token, or `str_start`, then expressions
// separated by `str_mid`, then `str_end`.
fn string(p: inout Parser) -> List ! Stop {
    let mark: usize = p.scratch.len
    for {
        let t: Token = current(p)
        advance(inout p)
        try text_part(inout p, t)
        if t.kind == TokenKind.str || t.kind == TokenKind.str_end {
            return finish(inout p, mark)
        }
        let value: ExprId = try expression(inout p)
        try add_part(inout p, StrPart.interpolation.(value: value))
        let k: TokenKind = next_kind(p)
        if k != TokenKind.str_mid && k != TokenKind.str_end {
            return err.(error: expected(inout p, "`}` to close the interpolation"))
        }
    }
}

// The text of a string token without its delimiters, if there is any.
fn text_part(p: inout Parser, t: Token) -> ! Stop {
    let bytes: []u8 = p.text[usize.(t.start)..usize.(t.end)]
    let from: u32 = t.start + 1
    var to: u32 = t.end
    let last: u8 = bytes[bytes.len - 1]
    if bytes.len >= 2 && (last == '"' || last == '{') {
        to -= 1
    }
    if to > from {
        try add_part(inout p, StrPart.text.(span: Span.(start: from, end: to)))
    }
    return ok
}

fn add_part(p: inout Parser, part: StrPart) -> ! Stop {
    try memory(push(inout p.ast.str_parts, part))
    return gather(inout p, u32.(p.ast.str_parts.len - 1))
}

// `(expr)`, or a tuple literal `(name: expr, ...)`.
fn paren_or_tuple(p: inout Parser) -> ExprId ! Stop {
    let from: u32 = token_start(p)
    advance(inout p)
    if next_kind(p) == TokenKind.ident && kind_at(p, 1) == TokenKind.colon {
        let list: List = try comma_list(inout p, tuple_item)
        return add_expr(inout p, ExprKind.tuple.(items: list), from)
    }
    let inner: ExprId = try expression(inout p)
    try expect(inout p, TokenKind.r_paren, "`)`")
    return add_expr(inout p, ExprKind.paren.(inner: inner), from)
}

fn tuple_item(p: inout Parser) -> u32 ! Stop {
    let n: Span = try name(inout p)
    try expect(inout p, TokenKind.colon, "`:`")
    let value: ExprId = try expression(inout p)
    try memory(push(inout p.ast.tuple_items, TupleItem.(name: n, value: value)))
    return ok.(value: u32.(p.ast.tuple_items.len - 1))
}

fn binary_op(k: TokenKind) -> ?BinaryOp {
    return match k {
        pipe_pipe { some.(value: BinaryOp.or) }
        amp_amp { some.(value: BinaryOp.and) }
        eq_eq { some.(value: BinaryOp.eq) }
        bang_eq { some.(value: BinaryOp.ne) }
        lt { some.(value: BinaryOp.lt) }
        lt_eq { some.(value: BinaryOp.le) }
        gt { some.(value: BinaryOp.gt) }
        gt_eq { some.(value: BinaryOp.ge) }
        plus { some.(value: BinaryOp.add) }
        minus { some.(value: BinaryOp.sub) }
        star { some.(value: BinaryOp.mul) }
        slash { some.(value: BinaryOp.div) }
        percent { some.(value: BinaryOp.rem) }
        amp { some.(value: BinaryOp.bit_and) }
        pipe { some.(value: BinaryOp.bit_or) }
        caret { some.(value: BinaryOp.bit_xor) }
        shl { some.(value: BinaryOp.shl) }
        shr { some.(value: BinaryOp.shr) }
        _ { none }
    }
}
