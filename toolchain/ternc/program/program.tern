// A program: every package it uses, starting from the root, each file
// parsed. Ported from stage 1's package loader.
//
// A package is a directory, and its files are the `.tern` files directly
// inside it. `import std.io` resolves to `<std>/io/`; any other path to a
// directory under the root, so `import board.uart` is `<root>/board/uart/`.
//
// Everything lives in one allocator, meant to be an arena that lives as
// long as the program is checked.

import std.fmt
import std.fs
import std.io
import std.utf8
import syntax

pub type File (
    pub path: [..]u8,
    pub text: [..]u8,
    pub starts: [..]u32,
    pub ast: syntax.Ast,
    pub package: u32,
)

pub type Package (
    // The dotted import path, such as `std.io`. Empty for the root.
    pub path: [..]u8,
    pub dir: [..]u8,
    pub files: [..]u32,
    // The packages this one imports, each once.
    pub imports: [..]u32,
)

// An error in a source file. The lexer's and parser's keep their
// problems, which the driver turns into text; the rest are text.
pub type Message enum {
    lex(d: syntax.Diagnostic)
    parse(d: syntax.ParseDiagnostic)
    text(start: u32, message: [..]u8)
}

pub type Diagnostic (pub file: u32, pub message: Message)

pub type Program (
    pub files: [..]File,
    pub packages: [..]Package,
    // Errors in a source file, in the order they were found.
    pub diagnostics: [..]Diagnostic,
    // Errors with no source location, such as an unreadable root.
    pub errors: [..][..]u8,
)

pub fn has_errors(p: Program) -> bool {
    return p.diagnostics.len > 0 || p.errors.len > 0
}

// The bytes of a file a span covers.
pub fn slice(f: File, start: u32, end: u32) -> []u8 {
    return f.text[usize.(start)..usize.(end)]
}

// The text of a Format, allocated from alloc.
pub fn format_text(alloc: Allocator, f: Format) -> [..]u8 ! OutOfMemory {
    var out: [..]u8 = make(alloc)
    for let chunk: []u8 in fmt.chunks(f) {
        try append(inout out, chunk)
    }
    return ok.(value: out)
}

// An owned copy of s, allocated from alloc.
pub fn own(alloc: Allocator, s: []u8) -> [..]u8 ! OutOfMemory {
    var out: [..]u8 = make(alloc)
    try append(inout out, s)
    return ok.(value: out)
}

type Loader (
    alloc: Allocator,
    root: []u8,
    std_dir: []u8,
    program: Program,
    // The packages being loaded, outermost first, to report cycles.
    loading: [..][..]u8,
)

// Loads the package in root and everything it imports. Standard library
// packages are looked up in std_dir.
pub fn load(alloc: Allocator, root: []u8, std_dir: []u8) -> Program ! OutOfMemory {
    let l: Loader = try new_loader(alloc, root, std_dir)
    return ok.(value: l.program)
}

// Loads a program for a hosted target: as `load`, plus `std.rt`, the
// runtime with C's entry point, which every hosted program links.
pub fn load_hosted(alloc: Allocator, root: []u8, std_dir: []u8) -> Program ! OutOfMemory {
    var l: Loader = try new_loader(alloc, root, std_dir)
    let missing: bool = match find_package(l.program, "std.rt") {
        some(value: _) { false }
        none { true }
    }
    if !has_errors(l.program) && missing {
        let dir: [..]u8 = try join(alloc, std_dir, "rt")
        match try read_package(inout l, "std.rt", dir) {
            loaded(id: _), empty {
            }
            unreadable {
                let shown: []u8 = dir
                try push(inout l.program.errors, try format_text(alloc, "cannot read {shown}"))
            }
        }
    }
    return ok.(value: l.program)
}

fn new_loader(alloc: Allocator, root: []u8, std_dir: []u8) -> Loader ! OutOfMemory {
    var l: Loader = Loader.(
        alloc: alloc,
        root: root,
        std_dir: std_dir,
        program: Program.(
            files: make(alloc),
            packages: make(alloc),
            diagnostics: make(alloc),
            errors: make(alloc),
        ),
        loading: make(alloc),
    )
    match try read_package(inout l, "", root) {
        loaded(id: _) {
        }
        empty {
            try push(inout l.program.errors, try format_text(alloc, "{root} holds no .tern files"))
        }
        unreadable {
            // Without errno there is no reason to give.
            try push(inout l.program.errors, try format_text(alloc, "cannot read {root}"))
        }
    }
    return ok.(value: l)
}

type Read enum {
    loaded(id: u32)
    // The directory holds no .tern files.
    empty
    unreadable
}

// dir/name, as Rust's Path::join writes it.
fn join(alloc: Allocator, dir: []u8, name: []u8) -> [..]u8 ! OutOfMemory {
    var out: [..]u8 = make(alloc)
    try append(inout out, dir)
    if dir.len > 0 && dir[dir.len - 1] != '/' {
        try push(inout out, '/')
    }
    try append(inout out, name)
    return ok.(value: out)
}

fn is_tern_file(e: fs.Entry) -> bool {
    let suffix: []u8 = ".tern"
    if !e.is_file || e.name.len <= suffix.len {
        return false
    }
    let tail: []u8 = e.name[e.name.len - suffix.len..]
    return bytes_equal(tail, suffix)
}

pub fn bytes_equal(a: []u8, b: []u8) -> bool {
    if a.len != b.len {
        return false
    }
    for let i: usize in 0..a.len {
        if a[i] != b[i] {
            return false
        }
    }
    return true
}

// Whether a sorts before b, byte by byte.
pub fn bytes_less(a: []u8, b: []u8) -> bool {
    var i: usize = 0
    for i < a.len && i < b.len {
        if a[i] != b[i] {
            return a[i] < b[i]
        }
        i += 1
    }
    return a.len < b.len
}

fn starts_with(s: []u8, prefix: []u8) -> bool {
    return s.len >= prefix.len && bytes_equal(s[..prefix.len], prefix)
}

// Parses the package at dir and loads its imports.
fn read_package(l: inout Loader, path: []u8, dir: []u8) -> Read ! OutOfMemory {
    var names: [..][..]u8 = make(l.alloc)
    match fs.list(l.alloc, dir) {
        ok(value as var entries: [..]fs.Entry) {
            for let i: usize in 0..entries.len {
                if is_tern_file(entries[i]) {
                    try push(inout names, take(inout entries[i].name))
                }
            }
        }
        err(error: fs.Error) {
            match error {
                out_of_memory {
                    return err.(error: OutOfMemory.out_of_memory)
                }
                open_failed, path_too_long {
                    return ok.(value: Read.unreadable)
                }
            }
        }
    }
    if names.len == 0 {
        return ok.(value: Read.empty)
    }
    // Insertion sort: a package has few files.
    for let i: usize in 1..names.len {
        var j: usize = i
        for j > 0 && bytes_less(names[j], names[j - 1]) {
            var t: [..]u8 = take(inout names[j])
            names[j] = take(inout names[j - 1])
            names[j - 1] = take(inout t)
            j -= 1
        }
    }
    let id: u32 = u32.(l.program.packages.len)
    try push(inout l.program.packages, Package.(
        path: try own(l.alloc, path),
        dir: try own(l.alloc, dir),
        files: make(l.alloc),
        imports: make(l.alloc),
    ))
    try push(inout l.loading, try own(l.alloc, path))
    for let name: []u8 in names {
        var file_path: [..]u8 = try join(l.alloc, dir, name)
        let file: u32 = try parse_file(inout l, inout file_path, id)
        try push(inout l.program.packages[usize.(id)].files, file)
        try load_imports(inout l, file, id)
    }
    let _: ?[..]u8 = pop(inout l.loading)
    return ok.(value: Read.loaded.(id: id))
}

// Parses the file at path, taking path.
fn parse_file(l: inout Loader, path: inout [..]u8, package: u32) -> u32 ! OutOfMemory {
    let id: u32 = u32.(l.program.files.len)
    var text: [..]u8 = make(l.alloc)
    match io.open(path) {
        ok(value as var f: io.File) {
            defer io.close(inout f)
            match io.read_to_end(l.alloc, inout f) {
                ok(value as var bytes: [..]u8) {
                    text = take(inout bytes)
                }
                err(error: io.Error) {
                    try read_error(inout l, path, error)
                }
            }
        }
        err(error: io.Error) {
            try read_error(inout l, path, error)
        }
    }
    let valid: usize = utf8.valid_up_to(text)
    if valid < text.len {
        // Report the encoding alone, and parse nothing.
        for text.len > valid {
            let _: ?u8 = pop(inout text)
        }
        try push(inout l.program.diagnostics, Diagnostic.(file: id, message: Message.text.(
            start: u32.(valid),
            message: try own(l.alloc, "the file is not UTF-8 from here on; source files are UTF-8"),
        )))
        var empty: syntax.Parsed = try syntax.parse(l.alloc, "")
        try add_file(inout l, inout path, inout text, inout empty.ast, package)
        return ok.(value: id)
    }
    var parsed: syntax.Parsed = try syntax.parse(l.alloc, text)
    for let d: syntax.Diagnostic in parsed.lex_diagnostics {
        try push(inout l.program.diagnostics, Diagnostic.(file: id, message: Message.lex.(d: d)))
    }
    for let d: syntax.ParseDiagnostic in parsed.diagnostics {
        try push(inout l.program.diagnostics, Diagnostic.(file: id, message: Message.parse.(d: d)))
    }
    try add_file(inout l, inout path, inout text, inout parsed.ast, package)
    return ok.(value: id)
}

fn read_error(l: inout Loader, path: []u8, error: io.Error) -> ! OutOfMemory {
    try push(inout l.program.errors, try format_text(l.alloc, "cannot read {path}: {io.describe(error)}"))
    return ok
}

// Adds a file, taking its path, text and tree.
fn add_file(l: inout Loader, path: inout [..]u8, text: inout [..]u8, ast: inout syntax.Ast, package: u32) -> ! OutOfMemory {
    var starts: [..]u32 = try syntax.line_starts(l.alloc, text)
    try push(inout l.program.files, File.(
        path: take(inout path),
        text: take(inout text),
        starts: take(inout starts),
        ast: take(inout ast),
        package: package,
    ))
    return ok
}

// An import: the names of its dotted path, the name it binds, and where
// it starts. Copied out of the file, since loading an import adds files.
type ImportName (segments: [..]u32, named: syntax.Span, start: u32)

fn load_imports(l: inout Loader, file: u32, package: u32) -> ! OutOfMemory {
    var imports: [..]ImportName = make(l.alloc)
    let f: File = l.program.files[usize.(file)]
    for let imp: syntax.Import in f.ast.imports {
        var segments: [..]u32 = make(l.alloc)
        try append(inout segments, syntax.items(f.ast.extra, imp.path))
        var named: syntax.Span = f.ast.names[usize.(segments[segments.len - 1])]
        match imp.alias {
            none {
            }
            some(value as alias: syntax.Span) {
                named = alias
            }
        }
        try push(inout imports, ImportName.(segments: take(inout segments), named: named, start: imp.span.start))
    }
    // The local names so far, to report one imported twice.
    var locals: [..]syntax.Span = make(l.alloc)
    for let k: usize in 0..imports.len {
        let named: syntax.Span = imports[k].named
        let start: u32 = imports[k].start
        let local: [..]u8 = try own(l.alloc, slice(l.program.files[usize.(file)], named.start, named.end))
        var twice: bool = false
        for let seen: syntax.Span in locals {
            if bytes_equal(slice(l.program.files[usize.(file)], seen.start, seen.end), local) {
                twice = true
            }
        }
        if twice {
            try report(inout l, file, start, "`{local}` is imported twice; rename one with `as`")
        } else {
            try push(inout locals, named)
        }
        match try resolve_import(inout l, file, imports[k].segments, start) {
            none {
            }
            some(value as imported: u32) {
                var known: bool = false
                for let p: u32 in l.program.packages[usize.(package)].imports {
                    if p == imported {
                        known = true
                    }
                }
                if !known {
                    try push(inout l.program.packages[usize.(package)].imports, imported)
                }
            }
        }
    }
    return ok
}

fn report(l: inout Loader, file: u32, start: u32, message: Format) -> ! OutOfMemory {
    try push(inout l.program.diagnostics, Diagnostic.(file: file, message: Message.text.(start: start, message: try format_text(l.alloc, message))))
    return ok
}

// The package with this id's path, or none.
pub fn find_package(p: Program, path: []u8) -> ?u32 {
    for let i: usize in 0..p.packages.len {
        if bytes_equal(p.packages[i].path, path) {
            return some.(value: u32.(i))
        }
    }
    return none
}

fn resolve_import(l: inout Loader, file: u32, segments: []u32, start: u32) -> ?u32 ! OutOfMemory {
    let f: File = l.program.files[usize.(file)]
    var path: [..]u8 = make(l.alloc)
    for let i: usize in 0..segments.len {
        if i > 0 {
            try push(inout path, '.')
        }
        let s: syntax.Span = f.ast.names[usize.(segments[i])]
        try append(inout path, slice(f, s.start, s.end))
    }
    let first_span: syntax.Span = f.ast.names[usize.(segments[0])]
    let first: []u8 = slice(f, first_span.start, first_span.end)
    let is_std: bool = bytes_equal(first, "std")
    // The directory, worked out before anything changes the loader.
    var dir: [..]u8 = try own(l.alloc, l.root)
    var rest: usize = 0
    if is_std {
        dir = try own(l.alloc, l.std_dir)
        rest = 1
    }
    for let i: usize in rest..segments.len {
        let s: syntax.Span = f.ast.names[usize.(segments[i])]
        dir = try join(l.alloc, dir, slice(f, s.start, s.end))
    }
    let importer: []u8 = l.program.packages[usize.(f.package)].path
    if starts_with(importer, "std.") && !is_std {
        try report(inout l, file, start, "a standard library package imports only `std` packages")
        return ok.(value: none)
    }
    for let i: usize in 0..l.loading.len {
        if bytes_equal(l.loading[i], path) {
            var cycle: [..]u8 = make(l.alloc)
            try append(inout cycle, "import cycle: ")
            for let j: usize in i..l.loading.len {
                try append(inout cycle, l.loading[j])
                try append(inout cycle, " -> ")
            }
            try append(inout cycle, path)
            let shown: []u8 = cycle
            try report(inout l, file, start, "{shown}")
            return ok.(value: none)
        }
    }
    match find_package(l.program, path) {
        none {
        }
        some(value as id: u32) {
            return ok.(value: some.(value: id))
        }
    }
    if is_std && segments.len == 1 {
        try report(inout l, file, start, "name a package inside `std`, such as `std.io`")
        return ok.(value: none)
    }
    match try read_package(inout l, path, dir) {
        loaded(id: u32) {
            return ok.(value: some.(value: id))
        }
        empty {
            let path_view: []u8 = path
            let dir_view: []u8 = dir
            try report(inout l, file, start, "package `{path_view}` has no .tern files in {dir_view}")
        }
        unreadable {
            let path_view: []u8 = path
            let dir_view: []u8 = dir
            try report(inout l, file, start, "no package `{path_view}`: {dir_view} does not exist")
        }
    }
    return ok.(value: none)
}
