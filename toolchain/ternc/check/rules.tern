// The local rules that need no flow: `unsafe`, `shared` globals,
// exclusivity of `inout` arguments, one owner per buffer, the `Format`
// rule and constant global initializers.

import maps
import program
import resolve
import syntax

// The place expressions e is built from: e, then its base, through fields,
// indexing and parentheses. Assigning to e or taking its address does not
// read any of them.
fn spine(alloc: Allocator, input: Input, fx: Fx, e: syntax.ExprId) -> [..]syntax.ExprId ! OutOfMemory {
    let ast: syntax.Ast = input.program.files[usize.(fx.file)].ast
    var out: [..]syntax.ExprId = make(alloc)
    var current: syntax.ExprId = e
    for {
        try push(inout out, current)
        match ast.exprs[usize.(current)].kind {
            paren(inner: syntax.ExprId) {
                current = inner
            }
            field(value: syntax.ExprId, name: _) {
                current = value
            }
            index(value: syntax.ExprId, index: _) {
                current = value
            }
            _ {
                return ok.(value: out)
            }
        }
    }
}

fn require_unsafe(c: inout Checker, fx: Fx, start: u32, what: Format) -> ! OutOfMemory {
    if !fx.in_unsafe {
        try report(inout c, fx.file, start, "{what} needs `unsafe`")
    }
    return ok
}

// A call to a C function or an `unsafe fn` needs `unsafe`.
fn unsafe_callee(input: Input, c: inout Checker, fx: Fx, callee: syntax.ExprId) -> ! OutOfMemory {
    match expr_res(input, fx.file, callee) {
        some(value as res: resolve.Res) {
            match res {
                decl(decl as d: maps.DeclRef) {
                    var what: []u8 = ""
                    match decl_of(input, d).kind {
                        function(is_unsafe: bool, name: _, params: _, result: _, body: _) {
                            if is_unsafe {
                                what = "the unsafe function"
                            }
                        }
                        extern_fn(name: _, params: _, variadic: _, result: _) {
                            what = "the C function"
                        }
                        _ {
                        }
                    }
                    if what.len > 0 {
                        let span: syntax.Span = expr_span(input, fx, callee)
                        let text: []u8 = file_text(input, fx.file, span)
                        try require_unsafe(inout c, fx, span.start, "calling {what} `{text}`")
                    }
                }
                _ {
                }
            }
        }
        none {
        }
    }
    return ok
}

// A use of a top-level name: a `shared` global needs its `lock`, and a C
// global needs `unsafe` unless `&` takes its address. span is the name, or
// the whole `pkg.name`.
fn use_decl(input: Input, c: inout Checker, fx: Fx, e: syntax.ExprId, decl: maps.DeclRef, span: syntax.Span) -> ! OutOfMemory {
    let shown: []u8 = file_text(input, fx.file, span)
    match decl_of(input, decl).kind {
        global(is_shared: bool, local: _) {
            if is_shared && !is_locked(fx, decl) {
                try report(inout c, fx.file, span.start, "`{shown}` is `shared`: use it inside `lock {shown} \{ ... }`")
            }
        }
        extern_var(mutable: _, name: _, ty: _) {
            if !marked(fx.addressed, u32.(e)) {
                try require_unsafe(inout c, fx, span.start, "using the C global `{shown}`")
            }
        }
        _ {
        }
    }
    return ok
}

fn is_locked(fx: Fx, decl: maps.DeclRef) -> bool {
    for let d: maps.DeclRef in fx.locked {
        if d.file == decl.file && d.index == decl.index {
            return true
        }
    }
    return false
}

// Exclusivity.

// An argument and how it is passed.
type ArgMode (e: syntax.ExprId, mode: syntax.Mode)

// Where an argument's storage starts.
type Root enum {
    local(id: u32)
    global(decl: maps.DeclRef)
}

// One step from a root to an argument's storage.
type Step enum {
    // The field's name in the file being checked.
    field(name: syntax.Span)
    // An index, when it is a constant.
    index(at: ?Wide)
    deref
}

type AccessPath (root: Root, steps: [..]Step)

// Checks that no `inout` argument overlaps another argument.
fn exclusive(input: Input, c: inout Checker, fx: Fx, args: []ArgMode) -> ! OutOfMemory {
    var paths: [..]?AccessPath = make(c.alloc)
    for let a: ArgMode in args {
        try push(inout paths, try access_path(input, c, fx, a.e))
    }
    for let i: usize in 0..args.len {
        if args[i].mode != syntax.Mode.inout_mode {
            continue
        }
        match paths[i] {
            none {
            }
            some(value as path_a: AccessPath) {
                for let j: usize in 0..args.len {
                    // A pair of `inout` arguments is reported once.
                    if j == i || (args[j].mode == syntax.Mode.inout_mode && j < i) {
                        continue
                    }
                    match paths[j] {
                        none {
                        }
                        some(value as path_b: AccessPath) {
                            if overlaps(input, fx.file, path_a, path_b) {
                                let span: syntax.Span = expr_span(input, fx, args[j].e)
                                let b_text: []u8 = file_text(input, fx.file, span)
                                let a_text: []u8 = file_text(input, fx.file, expr_span(input, fx, args[i].e))
                                try report(inout c, fx.file, span.start, "`{b_text}` overlaps `{a_text}`, which is passed `inout`; an `inout` argument must not overlap another argument")
                            }
                        }
                    }
                }
            }
        }
    }
    return ok
}

// The storage a place expression names, as a root and steps.
fn access_path(input: Input, c: Checker, fx: Fx, e: syntax.ExprId) -> ?AccessPath ! OutOfMemory {
    let ast: syntax.Ast = input.program.files[usize.(fx.file)].ast
    let res: ?resolve.Res = expr_res(input, fx.file, e)
    var global: ?maps.DeclRef = none
    match res {
        some(value as r: resolve.Res) {
            match r {
                decl(decl as d: maps.DeclRef) {
                    global = some.(value: d)
                }
                _ {
                }
            }
        }
        none {
        }
    }
    match ast.exprs[usize.(e)].kind {
        paren(inner: syntax.ExprId) {
            return access_path(input, c, fx, inner)
        }
        name(name: _) {
            match global {
                some(value as d: maps.DeclRef) {
                    return ok.(value: global_root(input, c, d))
                }
                none {
                }
            }
            match res {
                some(value as r: resolve.Res) {
                    match r {
                        local(id: u32) {
                            return ok.(value: some.(value: AccessPath.(root: Root.local.(id: id), steps: make(c.alloc))))
                        }
                        _ {
                        }
                    }
                }
                none {
                }
            }
            return ok.(value: none)
        }
        field(value: syntax.ExprId, name: syntax.Span) {
            match global {
                some(value as d: maps.DeclRef) {
                    return ok.(value: global_root(input, c, d))
                }
                none {
                }
            }
            match try access_path(input, c, fx, value) {
                some(value as var path: AccessPath) {
                    try push(inout path.steps, Step.field.(name: name))
                    return ok.(value: some.(value: path))
                }
                none {
                    return ok.(value: none)
                }
            }
        }
        index(value: syntax.ExprId, index as i: syntax.Index) {
            match try access_path(input, c, fx, value) {
                some(value as var path: AccessPath) {
                    var at: ?Wide = none
                    match i {
                        value(value as ie: syntax.ExprId) {
                            at = const_int(input, c, fx.file, ie, 0)
                        }
                        _ {
                        }
                    }
                    try push(inout path.steps, Step.index.(at: at))
                    return ok.(value: some.(value: path))
                }
                none {
                    return ok.(value: none)
                }
            }
        }
        deref(inner: syntax.ExprId) {
            match try access_path(input, c, fx, inner) {
                some(value as var path: AccessPath) {
                    try push(inout path.steps, Step.deref)
                    return ok.(value: some.(value: path))
                }
                none {
                    return ok.(value: none)
                }
            }
        }
        _ {
            return ok.(value: none)
        }
    }
}

fn global_root(input: Input, c: Checker, d: maps.DeclRef) -> ?AccessPath {
    match decl_of(input, d).kind {
        global(is_shared: _, local: _), extern_var(mutable: _, name: _, ty: _) {
            return some.(value: AccessPath.(root: Root.global.(decl: d), steps: make(c.alloc)))
        }
        _ {
            return none
        }
    }
}

fn same_root(a: Root, b: Root) -> bool {
    match a {
        local(id as x: u32) {
            return match b {
                local(id as y: u32) { x == y }
                global(decl: _) { false }
            }
        }
        global(decl as x: maps.DeclRef) {
            return match b {
                global(decl as y: maps.DeclRef) { x.file == y.file && x.index == y.index }
                local(id: _) { false }
            }
        }
    }
}

// Whether two access paths can name the same storage: the same root, and
// no step where they go to different fields or different constant
// indexes.
fn overlaps(input: Input, file: u32, a: AccessPath, b: AccessPath) -> bool {
    if !same_root(a.root, b.root) {
        return false
    }
    var n: usize = a.steps.len
    if b.steps.len < n {
        n = b.steps.len
    }
    for let i: usize in 0..n {
        match a.steps[i] {
            field(name as m: syntax.Span) {
                match b.steps[i] {
                    field(name as k: syntax.Span) {
                        if !program.bytes_equal(file_text(input, file, m), file_text(input, file, k)) {
                            return false
                        }
                    }
                    _ {
                    }
                }
            }
            index(at as m: ?Wide) {
                match b.steps[i] {
                    index(at as k: ?Wide) {
                        match m {
                            some(value as x: Wide) {
                                match k {
                                    some(value as y: Wide) {
                                        if !wide_equal(x, y) {
                                            return false
                                        }
                                    }
                                    none {
                                    }
                                }
                            }
                            none {
                            }
                        }
                    }
                    _ {
                    }
                }
            }
            deref {
            }
        }
    }
    return true
}

// One owner per buffer.

// Whether ty holds a `[..]T`, so a value of it never copies implicitly.
fn owning(c: inout Checker, ty: TyId) -> bool ! OutOfMemory {
    match maps.get_int(c.owning, u32.(ty)) {
        some(value as known: u32) {
            return ok.(value: known == 1)
        }
        none {
        }
    }
    // A type that holds itself does so through a `[..]T`, which decides
    // it before the cycle closes.
    try maps.put_int(inout c.owning, u32.(ty), 0)
    var parts: [..]TyId = make(c.alloc)
    match get(c.types, ty) {
        growable(elem: _) {
            try maps.put_int(inout c.owning, u32.(ty), 1)
            return ok.(value: true)
        }
        tuple(fields: Range) {
            for let f: TupleField in tuple_fields(c.types, fields) {
                try push(inout parts, f.ty)
            }
        }
        array(len: _, elem: TyId) {
            try push(inout parts, elem)
        }
        optional(elem: TyId) {
            try push(inout parts, elem)
        }
        result(value: ?TyId, error: TyId) {
            match value {
                some(value as v: TyId) {
                    try push(inout parts, v)
                }
                none {
                }
            }
            try push(inout parts, error)
        }
        named(id: _) {
            match info_of(c, ty) {
                some(value as info: NamedInfo) {
                    match info.def {
                        plain(underlying: TyId, pub_fields: _) {
                            try push(inout parts, underlying)
                        }
                        enum_def(info as e: EnumInfo) {
                            for let v: Variant in enum_variants(c.types, e) {
                                match v.payload {
                                    some(value as p: TyId) {
                                        try push(inout parts, p)
                                    }
                                    none {
                                    }
                                }
                            }
                        }
                        union_def(fields: Range) {
                            for let f: TupleField in tuple_fields(c.types, fields) {
                                try push(inout parts, f.ty)
                            }
                        }
                    }
                }
                none {
                }
            }
        }
        _ {
        }
    }
    var result: bool = false
    for let t: TyId in parts {
        if try owning(inout c, t) {
            result = true
            break
        }
    }
    try maps.put_int(inout c.owning, u32.(ty), if result { 1 } else { 0 })
    return ok.(value: result)
}

// Whether `take` can leave a value of ty empty: each owning part is a
// `[..]T` or an optional, which becomes `none`, or a record or tuple
// whose owning parts are.
fn emptiable(c: inout Checker, ty: TyId) -> bool ! OutOfMemory {
    if !(try owning(inout c, ty)) {
        return ok.(value: true)
    }
    var fields: [..]TyId = make(c.alloc)
    match get(c.types, ty) {
        growable(elem: _), optional(elem: _) {
            return ok.(value: true)
        }
        tuple(fields as r: Range) {
            for let f: TupleField in tuple_fields(c.types, r) {
                try push(inout fields, f.ty)
            }
        }
        named(id: _) {
            match info_of(c, ty) {
                some(value as info: NamedInfo) {
                    match info.def {
                        plain(underlying: TyId, pub_fields: _) {
                            try push(inout fields, underlying)
                        }
                        _ {
                            return ok.(value: false)
                        }
                    }
                }
                none {
                    return ok.(value: false)
                }
            }
        }
        _ {
            return ok.(value: false)
        }
    }
    for let t: TyId in fields {
        if !(try emptiable(inout c, t)) {
            return ok.(value: false)
        }
    }
    return ok.(value: true)
}

// e becomes a new home's value of type target. If target is owning, e
// must not be a place that keeps the buffer too. Inside a `return` value,
// a place that starts at one of the function's own locals is taken
// instead, once.
fn fresh(input: Input, c: inout Checker, fx: inout Fx, e: syntax.ExprId, target: TyId) -> ! OutOfMemory {
    if is_error(c.types, target) || !(try owning(inout c, target)) {
        return ok
    }
    let ast: syntax.Ast = input.program.files[usize.(fx.file)].ast
    match ast.exprs[usize.(e)].kind {
        paren(inner: syntax.ExprId) {
            try fresh(input, inout c, inout fx, inner, target)
        }
        unsafe_expr(body: syntax.ExprId) {
            try fresh(input, inout c, inout fx, body, target)
        }
        if_expr(cond: _, then: syntax.ExprId, otherwise: syntax.IfElse) {
            try fresh(input, inout c, inout fx, then, target)
            match otherwise {
                branch(value as v: syntax.ExprId) {
                    try fresh(input, inout c, inout fx, v, target)
                }
                if_expr(value as v: syntax.ExprId) {
                    try fresh(input, inout c, inout fx, v, target)
                }
            }
        }
        match_expr(value: _, arms: syntax.List) {
            for let i: u32 in syntax.items(ast.extra, arms) {
                match ast.arms[usize.(i)].body {
                    branch(value as v: syntax.ExprId) {
                        try fresh(input, inout c, inout fx, v, target)
                    }
                    block(body: _) {
                    }
                }
            }
        }
        // A raw pointer's target is trusted, as `unsafe` is.
        deref(inner: _) {
        }
        name(name: _), field(value: _, name: _), index(value: _, index: _) {
            match try access_path(input, c, fx, e) {
                some(value as var path: AccessPath) {
                    let span: syntax.Span = expr_span(input, fx, e)
                    let text: []u8 = file_text(input, fx.file, span)
                    if fx.returning {
                        match path.root {
                            local(id: u32) {
                                match local_info(fx, id) {
                                    some(value as info: LocalInfo) {
                                        if info.owned {
                                            for let d: [..]u32 in fx.defers {
                                                for let m: u32 in d {
                                                    if m == id {
                                                        let root: []u8 = file_text(input, fx.file, try root_name(input, c, fx, e))
                                                        try report(inout c, fx.file, span.start, "a `defer` uses `{root}` after this `return`; hand the value over with `take(inout {text})`")
                                                        return ok
                                                    }
                                                }
                                            }
                                            for let t: AccessPath in fx.taken {
                                                if overlaps(input, fx.file, t, path) {
                                                    try report(inout c, fx.file, span.start, "this `return` already takes `{text}` or part of it; a buffer can go to only one place")
                                                    return ok
                                                }
                                            }
                                            try push(inout fx.taken, take(inout path))
                                            return ok
                                        }
                                    }
                                    none {
                                    }
                                }
                            }
                            global(decl: _) {
                            }
                        }
                    }
                    try report(inout c, fx.file, span.start, "this would copy `{text}`, and its buffer would have two owners; hand it over with `take(inout {text})` or make a second one with `try copy(alloc, {text})`")
                }
                none {
                }
            }
        }
        _ {
        }
    }
    return ok
}

// The name a place expression starts at.
fn root_name(input: Input, c: Checker, fx: Fx, e: syntax.ExprId) -> syntax.Span ! OutOfMemory {
    let s: [..]syntax.ExprId = try spine(c.alloc, input, fx, e)
    return ok.(value: expr_span(input, fx, s[s.len - 1]))
}

// `append` and `copy` copy each element byte for byte, which an owning
// element cannot be.
fn no_owning_copy(c: inout Checker, file: u32, start: u32, name: []u8, elem: TyId) -> ! OutOfMemory {
    if try owning(inout c, elem) {
        let shown: [..]u8 = try show(inout c, elem)
        try report(inout c, file, start, "`{name}` copies each element, and a `{shown}` cannot be copied: its buffer would have two owners")
    }
    return ok
}

// The `Format` rule.

fn holds_format(input: Input, c: Checker, ty: TyId) -> bool {
    match get(c.types, ty) {
        named(id: NamedId) {
            return match id {
                builtin(which: BuiltinNamed) { which == BuiltinNamed.format || which == BuiltinNamed.panic_info }
                decl(decl: _) { false }
            }
        }
        tuple(fields: Range) {
            for let f: TupleField in tuple_fields(c.types, fields) {
                if holds_format(input, c, f.ty) {
                    return true
                }
            }
            return false
        }
        view(elem: TyId) {
            return holds_format(input, c, elem)
        }
        array(len: _, elem: TyId) {
            return holds_format(input, c, elem)
        }
        growable(elem: TyId) {
            return holds_format(input, c, elem)
        }
        pointer(elem: TyId) {
            return holds_format(input, c, elem)
        }
        optional(elem: TyId) {
            return holds_format(input, c, elem)
        }
        result(value: ?TyId, error: TyId) {
            match value {
                some(value as v: TyId) {
                    if holds_format(input, c, v) {
                        return true
                    }
                }
                none {
                }
            }
            return holds_format(input, c, error)
        }
        function(params: Range, result: ?TyId) {
            match result {
                some(value as r: TyId) {
                    if holds_format(input, c, r) {
                        return true
                    }
                }
                none {
                }
            }
            for let p: FnParam in fn_params(c.types, params) {
                if !is_format_param(c, p.ty) && holds_format(input, c, p.ty) {
                    return true
                }
            }
            return false
        }
        _ {
            return false
        }
    }
}

fn is_format_param(c: Checker, ty: TyId) -> bool {
    return is_builtin_named(c, ty, BuiltinNamed.format) || is_builtin_named(c, ty, BuiltinNamed.panic_info)
}

// ty is written somewhere other than a parameter.
fn no_format(input: Input, c: inout Checker, file: u32, start: u32, ty: TyId) -> ! OutOfMemory {
    if !holds_format(input, c, ty) {
        return ok
    }
    if is_builtin_named(c, ty, BuiltinNamed.format) {
        return report(inout c, file, start, "a `Format` can only be a parameter: it points into the frame of the call that made it")
    }
    let shown: [..]u8 = try show(inout c, ty)
    return report(inout c, file, start, "`{shown}` holds a `Format`, which can only be a parameter: it points into the frame of the call that made it")
}

// A parameter's type may be `Format` itself, but not hold one.
fn format_param(input: Input, c: inout Checker, file: u32, start: u32, ty: TyId) -> ! OutOfMemory {
    if !is_format_param(c, ty) {
        try no_format(input, inout c, file, start, ty)
    }
    return ok
}

// The fields, payloads and members of a declared type.
fn no_format_in_type(input: Input, c: inout Checker, file: u32, def: syntax.TypeDef, ty: TyId) -> ! OutOfMemory {
    let ast: syntax.Ast = input.program.files[usize.(file)].ast
    var info_def: ?NamedDef = none
    match info_of(c, ty) {
        some(value as info: NamedInfo) {
            info_def = some.(value: info.def)
        }
        none {
        }
    }
    let nothing: NamedDef = NamedDef.union_def.(fields: Range.(start: 0, len: 0))
    var d: NamedDef = nothing
    match info_def {
        some(value as x: NamedDef) {
            d = x
        }
        none {
            return ok
        }
    }
    match def {
        plain(ty as t: syntax.TypeId) {
            match d {
                plain(underlying: TyId, pub_fields: _) {
                    var done: bool = false
                    match ast.types[usize.(t)].kind {
                        tuple(fields: syntax.List) {
                            match get(c.types, underlying) {
                                tuple(fields as tys: Range) {
                                    let written: []u32 = syntax.items(ast.extra, fields)
                                    var lowered: [..]TupleField = make(c.alloc)
                                    try append(inout lowered, tuple_fields(c.types, tys))
                                    for let i: usize in 0..written.len {
                                        if i < lowered.len {
                                            let ft: syntax.TypeId = ast.fields[usize.(written[i])].ty
                                            try no_format(input, inout c, file, ast.types[usize.(ft)].span.start, lowered[i].ty)
                                        }
                                    }
                                    done = true
                                }
                                _ {
                                }
                            }
                        }
                        _ {
                        }
                    }
                    if !done {
                        try no_format(input, inout c, file, ast.types[usize.(t)].span.start, underlying)
                    }
                }
                _ {
                }
            }
        }
        enum_type(int_type: _, variants: syntax.List) {
            match d {
                enum_def(info: EnumInfo) {
                    var lowered: [..]Variant = make(c.alloc)
                    try append(inout lowered, enum_variants(c.types, info))
                    var k: usize = 0
                    for let i: u32 in syntax.items(ast.extra, variants) {
                        match ast.variants[usize.(i)] {
                            named(name: _, payload: ?syntax.TypeId, value: _) {
                                if k < lowered.len {
                                    match payload {
                                        some(value as p: syntax.TypeId) {
                                            match lowered[k].payload {
                                                some(value as pt: TyId) {
                                                    try no_format(input, inout c, file, ast.types[usize.(p)].span.start, pt)
                                                }
                                                none {
                                                }
                                            }
                                        }
                                        none {
                                        }
                                    }
                                }
                                k += 1
                            }
                            open(span: _) {
                            }
                        }
                    }
                }
                _ {
                }
            }
        }
        union_type(fields: syntax.List) {
            match d {
                union_def(fields as tys: Range) {
                    let written: []u32 = syntax.items(ast.extra, fields)
                    var lowered: [..]TupleField = make(c.alloc)
                    try append(inout lowered, tuple_fields(c.types, tys))
                    for let i: usize in 0..written.len {
                        if i < lowered.len {
                            let ft: syntax.TypeId = ast.fields[usize.(written[i])].ty
                            try no_format(input, inout c, file, ast.types[usize.(ft)].span.start, lowered[i].ty)
                        }
                    }
                }
                _ {
                }
            }
        }
    }
    return ok
}

// Constant initializers.

// A global's initializer is computed before the program runs, so it must
// be a constant.
fn constant(input: Input, c: inout Checker, file: u32, e: syntax.ExprId) -> ! OutOfMemory {
    match non_constant(input, c, file, e) {
        some(value as start: u32) {
            try report(inout c, file, start, "a global's value is computed before the program runs, so this must be a constant")
        }
        none {
        }
    }
    return ok
}

fn first_non_constant(input: Input, c: Checker, file: u32, es: []u32) -> ?u32 {
    for let e: u32 in es {
        match non_constant(input, c, file, syntax.ExprId.(e)) {
            some(value as s: u32) {
                return some.(value: s)
            }
            none {
            }
        }
    }
    return none
}

// Where the first part of e that is not a constant starts.
fn non_constant(input: Input, c: Checker, file: u32, e: syntax.ExprId) -> ?u32 {
    let ast: syntax.Ast = input.program.files[usize.(file)].ast
    let x: syntax.Expr = ast.exprs[usize.(e)]
    match x.kind {
        int, float, char {
            return none
        }
        str(parts: syntax.List) {
            for let i: u32 in syntax.items(ast.extra, parts) {
                match ast.str_parts[usize.(i)] {
                    interpolation(value: _) {
                        return some.(value: x.span.start)
                    }
                    text(span: _) {
                    }
                }
            }
            return none
        }
        paren(inner: syntax.ExprId) {
            return non_constant(input, c, file, inner)
        }
        unary(op: syntax.UnaryOp, operand: syntax.ExprId) {
            if op == syntax.UnaryOp.address_of {
                return some.(value: x.span.start)
            }
            return non_constant(input, c, file, operand)
        }
        binary(op: _, left: syntax.ExprId, right: syntax.ExprId) {
            match non_constant(input, c, file, left) {
                some(value as s: u32) {
                    return some.(value: s)
                }
                none {
                    return non_constant(input, c, file, right)
                }
            }
        }
        tuple(items: syntax.List) {
            for let i: u32 in syntax.items(ast.extra, items) {
                match non_constant(input, c, file, ast.tuple_items[usize.(i)].value) {
                    some(value as s: u32) {
                        return some.(value: s)
                    }
                    none {
                    }
                }
            }
            return none
        }
        array(elems: syntax.List) {
            return first_non_constant(input, c, file, syntax.items(ast.extra, elems))
        }
        construct(ty: _, value: syntax.ExprId) {
            return non_constant(input, c, file, value)
        }
        name(name: _) {
            return variable_use(input, file, e, x.span.start)
        }
        field(value: syntax.ExprId, name: syntax.Span) {
            match expr_res(input, file, e) {
                some(value as res: resolve.Res) {
                    match res {
                        decl(decl: _) {
                            return variable_use(input, file, e, x.span.start)
                        }
                        _ {
                        }
                    }
                }
                none {
                }
            }
            // A variant, as in `Color.red`.
            if is_type_expr(input, file, value) {
                return none
            }
            if program.bytes_equal(file_text(input, file, name), "len") {
                return non_constant(input, c, file, value)
            }
            return some.(value: x.span.start)
        }
        call(callee: syntax.ExprId, args: syntax.List) {
            var target: syntax.ExprId = callee
            match ast.exprs[usize.(callee)].kind {
                index(value: syntax.ExprId, index: _) {
                    target = value
                }
                _ {
                }
            }
            match res_builtin(expr_res(input, file, target)) {
                some(value as name: []u8) {
                    match name {
                        "from_address", "fill", "c_string", "truncate" {
                            for let i: u32 in syntax.items(ast.extra, args) {
                                match non_constant(input, c, file, ast.args[usize.(i)].value) {
                                    some(value as s: u32) {
                                        return some.(value: s)
                                    }
                                    none {
                                    }
                                }
                            }
                            return none
                        }
                        _ {
                        }
                    }
                }
                none {
                }
            }
            return some.(value: x.span.start)
        }
        _ {
            return some.(value: x.span.start)
        }
    }
}

// A name that refers to a `var` global or a C global is not a constant.
fn variable_use(input: Input, file: u32, e: syntax.ExprId, start: u32) -> ?u32 {
    match expr_res(input, file, e) {
        some(value as res: resolve.Res) {
            match res {
                decl(decl as d: maps.DeclRef) {
                    if variable_decl(input, d) {
                        return some.(value: start)
                    }
                }
                _ {
                }
            }
        }
        none {
        }
    }
    return none
}

// Whether a top-level name is not a constant: `var` globals and C globals.
// Functions are constants: their addresses are fixed.
fn variable_decl(input: Input, decl: maps.DeclRef) -> bool {
    return match decl_of(input, decl).kind {
        global(is_shared: _, local: syntax.Local) { local.mutable }
        extern_var(mutable: _, name: _, ty: _) { true }
        _ { false }
    }
}

fn is_type_expr(input: Input, file: u32, e: syntax.ExprId) -> bool {
    match expr_res(input, file, e) {
        some(value as res: resolve.Res) {
            match res {
                builtin(id as builtin_index: u32) {
                    let name: []u8 = resolve.builtin_name(builtin_index)
                    return resolve.is_builtin_type(name)
                }
                decl(decl as d: maps.DeclRef) {
                    return match decl_of(input, d).kind {
                        type_decl(name: _, def: _) { true }
                        _ { false }
                    }
                }
                _ {
                    return false
                }
            }
        }
        none {
            return false
        }
    }
}
