// Checking expressions and calls, built-in functions included.

import maps
import program
import resolve
import syntax

// Checks e against expected and returns expected, or never if e never
// finishes.
fn check_expect(input: Input, c: inout Checker, fx: inout Fx, e: syntax.ExprId, expected: TyId) -> TyId ! OutOfMemory {
    let actual: TyId = try check_value(input, inout c, inout fx, e, some.(value: expected))
    try expect_ty(inout c, fx.file, expr_span(input, fx, e).start, actual, expected)
    if is_never(c.types, actual) {
        return ok.(value: actual)
    }
    return ok.(value: expected)
}

// The type of e, which must be a value.
fn check_value(input: Input, c: inout Checker, fx: inout Fx, e: syntax.ExprId, expected: ?TyId) -> TyId ! OutOfMemory {
    let start: u32 = expr_span(input, fx, e).start
    match try check_expr(input, inout c, inout fx, e, expected) {
        value(ty: TyId) {
            return ok.(value: ty)
        }
        nothing {
            try report(inout c, fx.file, start, "this call returns nothing, so it has no value")
        }
        type_item(ty: TyId) {
            let shown: []u8 = try show(inout c, ty)
            try report(inout c, fx.file, start, try program.format_text(c.alloc, "`{shown}` is a type, not a value"))
        }
        builtin(name: []u8) {
            let message: []u8 = match name {
                "some" { "write `some.(value: x)`" }
                "err" { "write `err.(error: e)`" }
                _ { try program.format_text(c.alloc, "`{name}` is a built-in function; call it") }
            }
            try report(inout c, fx.file, start, message)
        }
        variant(ty: TyId, index: _) {
            let shown: []u8 = try show(inout c, ty)
            try report(inout c, fx.file, start, try program.format_text(c.alloc, "this variant of `{shown}` has a payload; build it with `.(...)`"))
        }
    }
    return error_ty(inout c.types)
}

fn res_builtin(res: ?resolve.Res) -> ?[]u8 {
    match res {
        some(value as r: resolve.Res) {
            match r {
                builtin(name: []u8) {
                    return some.(value: name)
                }
                _ {
                    return none
                }
            }
        }
        none {
            return none
        }
    }
}

fn builtin_is(res: ?resolve.Res, a: []u8, b: []u8, d: []u8) -> bool {
    match res_builtin(res) {
        some(value as name: []u8) {
            return program.bytes_equal(name, a) || program.bytes_equal(name, b) || program.bytes_equal(name, d)
        }
        none {
            return false
        }
    }
}

// Whether e takes its type from context: literals, `none`, `ok`,
// `some.(...)` and array literals.
fn needs_context(input: Input, c: Checker, fx: Fx, e: syntax.ExprId) -> bool {
    let ast: syntax.Ast = input.program.files[usize.(fx.file)].ast
    match ast.exprs[usize.(e)].kind {
        int, float, char {
            return true
        }
        array(elems: _) {
            return true
        }
        paren(inner: syntax.ExprId) {
            return needs_context(input, c, fx, inner)
        }
        unary(op: syntax.UnaryOp, operand: syntax.ExprId) {
            if op == syntax.UnaryOp.neg || op == syntax.UnaryOp.bit_not {
                return needs_context(input, c, fx, operand)
            }
            return false
        }
        name(name: _) {
            return builtin_is(expr_res(input, fx.file, e), "none", "ok", "ok")
        }
        construct(ty as target: syntax.ExprId, value: _) {
            return builtin_is(expr_res(input, fx.file, target), "some", "ok", "err")
        }
        _ {
            return false
        }
    }
}

fn check_expr(input: Input, c: inout Checker, fx: inout Fx, e: syntax.ExprId, expected: ?TyId) -> Item ! OutOfMemory {
    let item: Item = try expr_item(input, inout c, inout fx, e, expected)
    c.files[usize.(fx.file)].exprs[usize.(e)] = some.(value: item)
    return ok.(value: item)
}

fn value_item(_: inout Checker, ty: TyId) -> Item ! OutOfMemory {
    return ok.(value: Item.value.(ty: ty))
}

fn error_item(c: inout Checker) -> Item ! OutOfMemory {
    return ok.(value: Item.value.(ty: try error_ty(inout c.types)))
}

fn expr_item(input: Input, c: inout Checker, fx: inout Fx, e: syntax.ExprId, expected: ?TyId) -> Item ! OutOfMemory {
    let ast: syntax.Ast = input.program.files[usize.(fx.file)].ast
    let span: syntax.Span = expr_span(input, fx, e)
    match ast.exprs[usize.(e)].kind {
        name(name: syntax.Span) {
            return expr_name(input, inout c, inout fx, e, name, expected)
        }
        int {
            return value_item(inout c, try int_literal(input, inout c, fx, span, false, expected))
        }
        char {
            let v: ?Wide = char_value(file_text(input, fx.file, span))
            return value_item(inout c, try int_with_value(inout c, fx, span.start, v, expected, "a character literal"))
        }
        float {
            match expected {
                some(value as ty: TyId) {
                    if is_float(c, ty) || is_error(c.types, ty) {
                        return value_item(inout c, ty)
                    }
                    let shown: []u8 = try show(inout c, ty)
                    try report(inout c, fx.file, span.start, try program.format_text(c.alloc, "expected `{shown}`, found a float literal"))
                    return error_item(inout c)
                }
                none {
                    try unknown_literal(inout c, fx, span.start, "float")
                    return error_item(inout c)
                }
            }
        }
        str(parts: syntax.List) {
            return value_item(inout c, try string_lit(input, inout c, inout fx, parts, expected))
        }
        paren(inner: syntax.ExprId) {
            return check_expr(input, inout c, inout fx, inner, expected)
        }
        unsafe_expr(body: syntax.ExprId) {
            let outer: bool = fx.in_unsafe
            fx.in_unsafe = true
            let ty: TyId = try check_value(input, inout c, inout fx, body, expected)
            fx.in_unsafe = outer
            return value_item(inout c, ty)
        }
        tuple(items: syntax.List) {
            return value_item(inout c, try tuple_lit(input, inout c, inout fx, span.start, items, expected))
        }
        call(callee: syntax.ExprId, args: syntax.List) {
            return call_expr(input, inout c, inout fx, span.start, callee, args, expected)
        }
        field(value: syntax.ExprId, name: syntax.Span) {
            return field_access(input, inout c, inout fx, e, value, name)
        }
        construct(ty as target: syntax.ExprId, value: syntax.ExprId) {
            return construct_expr(input, inout c, inout fx, span.start, target, value, expected)
        }
        index(value: syntax.ExprId, index as i: syntax.Index) {
            return value_item(inout c, try index_expr(input, inout c, inout fx, value, i))
        }
        deref(inner: syntax.ExprId) {
            try require_unsafe(inout c, fx, span.start, "reading or writing through a pointer with `.*`")
            let ty: TyId = try check_value(input, inout c, inout fx, inner, none)
            match get(c.types, ty) {
                pointer(elem: TyId) {
                    return value_item(inout c, elem)
                }
                error {
                    return value_item(inout c, ty)
                }
                _ {
                    let shown: []u8 = try show(inout c, ty)
                    try report(inout c, fx.file, span.start, try program.format_text(c.alloc, "`.*` reads through a pointer, not a `{shown}`"))
                    return error_item(inout c)
                }
            }
        }
        unary(op: syntax.UnaryOp, operand: syntax.ExprId) {
            return value_item(inout c, try unary_expr(input, inout c, inout fx, span.start, op, operand, expected))
        }
        try_expr(operand: syntax.ExprId) {
            return try_item(input, inout c, inout fx, span.start, operand)
        }
        binary(op: syntax.BinaryOp, left: syntax.ExprId, right: syntax.ExprId) {
            return value_item(inout c, try binary_expr(input, inout c, inout fx, span.start, op, left, right, expected))
        }
        if_expr(cond: syntax.ExprId, then: syntax.ExprId, otherwise: syntax.IfElse) {
            let b: TyId = try bool_ty(inout c.types)
            let _: TyId = try check_expect(input, inout c, inout fx, cond, b)
            var other: syntax.ExprId = then
            match otherwise {
                branch(value as o: syntax.ExprId) {
                    other = o
                }
                if_expr(value as o: syntax.ExprId) {
                    other = o
                }
            }
            let bodies: [2]syntax.ExprId = [then, other]
            return value_item(inout c, try branches(input, inout c, inout fx, bodies, expected))
        }
        match_expr(value: syntax.ExprId, arms: syntax.List) {
            let scrutinee: TyId = try check_value(input, inout c, inout fx, value, none)
            let borrowed: bool = is_place(input, c, fx, value)
            var coverage: Coverage = Coverage.(variants: make(c.alloc), wildcard: false)
            var bodies: [..]syntax.ExprId = make(c.alloc)
            for let i: u32 in syntax.items(ast.extra, arms) {
                let arm: syntax.Arm = ast.arms[usize.(i)]
                try check_patterns(input, inout c, inout fx, arm.patterns, scrutinee, borrowed, inout coverage)
                match arm.body {
                    branch(value as b: syntax.ExprId) {
                        try push(inout bodies, b)
                    }
                    block(body: _) {
                    }
                }
            }
            try exhaustive(inout c, fx, expr_span(input, fx, value).start, scrutinee, coverage)
            return value_item(inout c, try branches(input, inout c, inout fx, bodies, expected))
        }
        array(elems: syntax.List) {
            return value_item(inout c, try array_lit(input, inout c, inout fx, span.start, elems, expected))
        }
    }
}

// The common type of `if` or `match` branches.
fn branches(input: Input, c: inout Checker, fx: inout Fx, bodies: []syntax.ExprId, expected: ?TyId) -> TyId ! OutOfMemory {
    match expected {
        some(value as want: TyId) {
            for let b: syntax.ExprId in bodies {
                let _: TyId = try check_expect(input, inout c, inout fx, b, want)
            }
            return ok.(value: want)
        }
        none {
        }
    }
    var result: ?TyId = none
    for let b: syntax.ExprId in bodies {
        match result {
            some(value as ty: TyId) {
                let _: TyId = try check_expect(input, inout c, inout fx, b, ty)
            }
            none {
                let ty: TyId = try check_value(input, inout c, inout fx, b, none)
                if !is_never(c.types, ty) {
                    result = some.(value: ty)
                }
            }
        }
    }
    match result {
        some(value as ty: TyId) {
            return ok.(value: ty)
        }
        none {
            return never_ty(inout c.types)
        }
    }
}

fn expr_name(input: Input, c: inout Checker, fx: inout Fx, e: syntax.ExprId, name: syntax.Span, expected: ?TyId) -> Item ! OutOfMemory {
    match expr_res(input, fx.file, e) {
        some(value as res: resolve.Res) {
            match res {
                local(id: u32) {
                    if fx.collecting {
                        try push(inout fx.mentioned, id)
                    }
                    match local_info(fx, id) {
                        some(value as info: LocalInfo) {
                            return value_item(inout c, info.ty)
                        }
                        none {
                            return error_item(inout c)
                        }
                    }
                }
                decl(decl as d: maps.DeclRef) {
                    try use_decl(input, inout c, fx, e, d, name)
                    try maybe_value_use(input, inout c, fx, e, d, name)
                    return decl_item(input, inout c, d, file_text(input, fx.file, name))
                }
                builtin(name as b: []u8) {
                    return builtin_name(input, inout c, fx, name.start, b, expected)
                }
                package(id: _) {
                    return error_item(inout c)
                }
            }
        }
        none {
            return error_item(inout c)
        }
    }
}

fn builtin_name(input: Input, c: inout Checker, fx: Fx, start: u32, name: []u8, expected: ?TyId) -> Item ! OutOfMemory {
    if resolve.is_builtin_type(name) {
        return ok.(value: Item.type_item.(ty: try builtin_type(input, inout c, name)))
    }
    match name {
        "true", "false" {
            return value_item(inout c, try bool_ty(inout c.types))
        }
        "none" {
            match expected {
                some(value as ty: TyId) {
                    match get(c.types, ty) {
                        optional(elem: _), error {
                            return value_item(inout c, ty)
                        }
                        _ {
                        }
                    }
                }
                none {
                }
            }
            try report(inout c, fx.file, start, "`none` needs a place that expects an optional")
            return error_item(inout c)
        }
        "ok" {
            match expected {
                some(value as ty: TyId) {
                    match get(c.types, ty) {
                        result(value as v: ?TyId, error: _) {
                            match v {
                                none {
                                    return value_item(inout c, ty)
                                }
                                some(value: _) {
                                    try report(inout c, fx.file, start, "this result carries a value: write `ok.(value: x)`")
                                    return error_item(inout c)
                                }
                            }
                        }
                        error {
                            return value_item(inout c, ty)
                        }
                        _ {
                        }
                    }
                }
                none {
                }
            }
            try report(inout c, fx.file, start, "`ok` needs a place that expects a result")
            return error_item(inout c)
        }
        _ {
            return ok.(value: Item.builtin.(name: name))
        }
    }
}

fn unknown_literal(c: inout Checker, fx: Fx, start: u32, what: []u8) -> ! OutOfMemory {
    return report(inout c, fx.file, start, try program.format_text(c.alloc, "the type of this {what} literal is unknown; convert it, as in `u32.(1)`"))
}

fn int_literal(input: Input, c: inout Checker, fx: Fx, span: syntax.Span, negative: bool, expected: ?TyId) -> TyId ! OutOfMemory {
    var v: ?Wide = parse_int(file_text(input, fx.file, span))
    if negative {
        match v {
            some(value as n: Wide) {
                v = some.(value: wide_neg(n))
            }
            none {
            }
        }
    }
    return int_with_value(inout c, fx, span.start, v, expected, "an integer literal")
}

fn int_with_value(c: inout Checker, fx: Fx, start: u32, v: ?Wide, expected: ?TyId, what: []u8) -> TyId ! OutOfMemory {
    match expected {
        none {
            try unknown_literal(inout c, fx, start, "integer")
            return error_ty(inout c.types)
        }
        some(value as want: TyId) {
            if is_error(c.types, want) {
                return ok.(value: want)
            }
            match int_core(c, want) {
                none {
                    let shown: []u8 = try show(inout c, want)
                    try report(inout c, fx.file, start, try program.format_text(c.alloc, "expected `{shown}`, found {what}"))
                    return error_ty(inout c.types)
                }
                some(value: _) {
                }
            }
            try int_fits(inout c, fx, start, v, want)
            return ok.(value: want)
        }
    }
}

fn int_fits(c: inout Checker, fx: Fx, start: u32, v: ?Wide, ty: TyId) -> ! OutOfMemory {
    match int_core(c, ty) {
        none {
            if !is_error(c.types, ty) {
                let shown: []u8 = try show(inout c, ty)
                try report(inout c, fx.file, start, try program.format_text(c.alloc, "expected `{shown}`, found an integer"))
            }
        }
        some(value as int: IntTy) {
            match v {
                some(value as n: Wide) {
                    if wide_less(n, int_min(int)) || wide_less(int_max(int), n) {
                        var buf: [48]u8 = fill[48](0)
                        let text: []u8 = wide_text(inout buf, n)
                        let shown: []u8 = try show(inout c, ty)
                        try report(inout c, fx.file, start, try program.format_text(c.alloc, "`{text}` does not fit in `{shown}`"))
                    }
                }
                none {
                    let shown: []u8 = try show(inout c, ty)
                    try report(inout c, fx.file, start, try program.format_text(c.alloc, "this literal does not fit in `{shown}`"))
                }
            }
        }
    }
    return ok
}

fn string_lit(input: Input, c: inout Checker, fx: inout Fx, parts: syntax.List, expected: ?TyId) -> TyId ! OutOfMemory {
    let ast: syntax.Ast = input.program.files[usize.(fx.file)].ast
    var interpolated: bool = false
    for let i: u32 in syntax.items(ast.extra, parts) {
        match ast.str_parts[usize.(i)] {
            interpolation(value as e: syntax.ExprId) {
                interpolated = true
                let ty: TyId = try check_value(input, inout c, inout fx, e, none)
                var part: ?TyId = none
                match fmt_part(input) {
                    some(value as p: maps.DeclRef) {
                        part = some.(value: try named_type(input, inout c, NamedId.decl.(decl: p)))
                    }
                    none {
                    }
                }
                let bytes: TyId = try bytes_ty(inout c.types)
                var fine: bool = same_ty(ty, bytes) || is_builtin_named(c, ty, BuiltinNamed.format)
                match as_int(c.types, ty) {
                    some(value: _) {
                        fine = true
                    }
                    none {
                    }
                }
                match get(c.types, ty) {
                    boolean, error, never {
                        fine = true
                    }
                    _ {
                    }
                }
                match part {
                    some(value as p: TyId) {
                        if same_ty(p, ty) {
                            fine = true
                        }
                    }
                    none {
                    }
                }
                if !fine {
                    let shown: []u8 = try show(inout c, ty)
                    try report(inout c, fx.file, expr_span(input, fx, e).start, try program.format_text(c.alloc, "`{shown}` cannot be interpolated; `\{}` takes integers, `bool`, `[]u8`, a `Format` and `fmt.Part`"))
                }
            }
            text(span: _) {
            }
        }
    }
    let format: TyId = try named_type(input, inout c, NamedId.builtin.(which: BuiltinNamed.format))
    var wants_format: bool = false
    match expected {
        some(value as want: TyId) {
            wants_format = same_ty(want, format)
        }
        none {
        }
    }
    if interpolated || wants_format {
        return ok.(value: format)
    }
    return bytes_ty(inout c.types)
}

fn tuple_lit(input: Input, c: inout Checker, fx: inout Fx, start: u32, items: syntax.List, expected: ?TyId) -> TyId ! OutOfMemory {
    let ast: syntax.Ast = input.program.files[usize.(fx.file)].ast
    let list: []u32 = syntax.items(ast.extra, items)
    match expected {
        some(value as want: TyId) {
            match get(c.types, want) {
                tuple(fields: Range) {
                    let wanted: []TupleField = tuple_fields(c.types, fields)
                    var same: bool = wanted.len == list.len
                    if same {
                        for let i: usize in 0..list.len {
                            let item: syntax.TupleItem = ast.tuple_items[usize.(list[i])]
                            if !program.bytes_equal(file_text(input, fx.file, item.name), wanted[i].name) {
                                same = false
                            }
                        }
                    }
                    if !same {
                        var want_names: [..]u8 = make(c.alloc)
                        for let i: usize in 0..wanted.len {
                            if i > 0 {
                                try append(inout want_names, ", ")
                            }
                            try append(inout want_names, wanted[i].name)
                        }
                        var names: [..]u8 = make(c.alloc)
                        for let i: usize in 0..list.len {
                            if i > 0 {
                                try append(inout names, ", ")
                            }
                            let item: syntax.TupleItem = ast.tuple_items[usize.(list[i])]
                            try append(inout names, file_text(input, fx.file, item.name))
                        }
                        let a: []u8 = want_names
                        let b: []u8 = names
                        try report(inout c, fx.file, start, try program.format_text(c.alloc, "expected the fields ({a}), found ({b})"))
                        return error_ty(inout c.types)
                    }
                    for let i: usize in 0..list.len {
                        let item: syntax.TupleItem = ast.tuple_items[usize.(list[i])]
                        let _: TyId = try check_expect(input, inout c, inout fx, item.value, wanted[i].ty)
                        try fresh(input, inout c, inout fx, item.value, wanted[i].ty)
                    }
                    return ok.(value: want)
                }
                _ {
                }
            }
        }
        none {
        }
    }
    var fields: [..]TupleField = make(c.alloc)
    for let i: u32 in list {
        let item: syntax.TupleItem = ast.tuple_items[usize.(i)]
        let ty: TyId = try check_value(input, inout c, inout fx, item.value, none)
        try fresh(input, inout c, inout fx, item.value, ty)
        try push(inout fields, TupleField.(name: file_text(input, fx.file, item.name), ty: ty))
    }
    return tuple_ty(inout c.types, fields)
}

fn array_lit(input: Input, c: inout Checker, fx: inout Fx, start: u32, elems: syntax.List, expected: ?TyId) -> TyId ! OutOfMemory {
    let ast: syntax.Ast = input.program.files[usize.(fx.file)].ast
    let list: []u32 = syntax.items(ast.extra, elems)
    match expected {
        none {
            try report(inout c, fx.file, start, "the type of this array literal is unknown")
            return error_ty(inout c.types)
        }
        some(value as want: TyId) {
            match get(c.types, want) {
                array(len: u64, elem: TyId) {
                    for let e: u32 in list {
                        let _: TyId = try check_expect(input, inout c, inout fx, syntax.ExprId.(e), elem)
                        try fresh(input, inout c, inout fx, syntax.ExprId.(e), elem)
                    }
                    if u64.(list.len) != len {
                        let found: usize = list.len
                        try report(inout c, fx.file, start, try program.format_text(c.alloc, "expected {len} elements, found {found}"))
                    }
                    return ok.(value: want)
                }
                error {
                    return ok.(value: want)
                }
                _ {
                    let shown: []u8 = try show(inout c, want)
                    try report(inout c, fx.file, start, try program.format_text(c.alloc, "expected `{shown}`, found an array literal"))
                    return error_ty(inout c.types)
                }
            }
        }
    }
}

fn field_access(input: Input, c: inout Checker, fx: inout Fx, e: syntax.ExprId, value: syntax.ExprId, name: syntax.Span) -> Item ! OutOfMemory {
    let text: []u8 = file_text(input, fx.file, name)
    match expr_res(input, fx.file, e) {
        some(value as res: resolve.Res) {
            match res {
                decl(decl as d: maps.DeclRef) {
                    try use_decl(input, inout c, fx, e, d, expr_span(input, fx, e))
                    try maybe_value_use(input, inout c, fx, e, d, expr_span(input, fx, e))
                    return decl_item(input, inout c, d, text)
                }
                _ {
                }
            }
        }
        none {
        }
    }
    var base: TyId = 0
    match try check_expr(input, inout c, inout fx, value, none) {
        type_item(ty: TyId) {
            return variant_item(input, inout c, fx, ty, name)
        }
        value(ty: TyId) {
            base = ty
        }
        _ {
            base = try check_value(input, inout c, inout fx, value, none)
        }
    }
    let is_len: bool = program.bytes_equal(text, "len")
    match get(c.types, base) {
        error {
            return value_item(inout c, base)
        }
        array(len: _, elem: _) {
            if is_len {
                return value_item(inout c, try usize_ty(inout c.types))
            }
        }
        view(elem: _) {
            if is_len {
                return value_item(inout c, try usize_ty(inout c.types))
            }
        }
        growable(elem: _) {
            if is_len {
                return value_item(inout c, try usize_ty(inout c.types))
            }
        }
        pointer(elem: _) {
            try report(inout c, fx.file, name.start, try program.format_text(c.alloc, "read through the pointer first: `.*.{text}`"))
            return error_item(inout c)
        }
        _ {
        }
    }
    var field: ?RecordField = none
    match try record_fields(input, c, base, fx.file) {
        some(value as fields: []RecordField) {
            field = find_field(fields, text)
        }
        none {
        }
    }
    match field {
        some(value as f: RecordField) {
            if !f.visible {
                let shown: []u8 = try show(inout c, base)
                try report(inout c, fx.file, name.start, try program.format_text(c.alloc, "field `{text}` of `{shown}` is private to its package"))
            }
            var is_union: bool = false
            match info_of(c, base) {
                some(value as info: NamedInfo) {
                    match info.def {
                        union_def(fields: _) {
                            is_union = true
                        }
                        _ {
                        }
                    }
                }
                none {
                }
            }
            if is_union && !marked(fx.written, u32.(e)) && !marked(fx.addressed, u32.(e)) {
                let what: []u8 = try program.format_text(c.alloc, "reading the union member `{text}`")
                try require_unsafe(inout c, fx, name.start, what)
            }
            return value_item(inout c, f.ty)
        }
        none {
            let shown: []u8 = try show(inout c, base)
            try report(inout c, fx.file, name.start, try program.format_text(c.alloc, "`{shown}` has no field `{text}`"))
            return error_item(inout c)
        }
    }
}

// `T.name`: a variant of the enum T.
fn variant_item(input: Input, c: inout Checker, fx: Fx, ty: TyId, name: syntax.Span) -> Item ! OutOfMemory {
    let text: []u8 = file_text(input, fx.file, name)
    var is_enum: bool = false
    match info_of(c, ty) {
        some(value as info: NamedInfo) {
            match info.def {
                enum_def(info as e: EnumInfo) {
                    is_enum = true
                    let vs: []Variant = enum_variants(c.types, e)
                    for let i: usize in 0..vs.len {
                        if program.bytes_equal(vs[i].name, text) {
                            match vs[i].payload {
                                some(value: _) {
                                    return ok.(value: Item.variant.(ty: ty, index: u32.(i)))
                                }
                                none {
                                    return value_item(inout c, ty)
                                }
                            }
                        }
                    }
                }
                _ {
                }
            }
        }
        none {
        }
    }
    if is_enum {
        let shown: []u8 = try show(inout c, ty)
        try report(inout c, fx.file, name.start, try program.format_text(c.alloc, "`{shown}` has no variant `{text}`"))
    } else if !is_error(c.types, ty) {
        let shown: []u8 = try show(inout c, ty)
        try report(inout c, fx.file, name.start, try program.format_text(c.alloc, "`{shown}` is not an enum, so it has no variant `{text}`"))
    }
    return error_item(inout c)
}

// The payload of an enum's variant, by index.
fn variant_payload(c: Checker, ty: TyId, index: u32) -> ?TyId {
    match info_of(c, ty) {
        some(value as info: NamedInfo) {
            match info.def {
                enum_def(info as e: EnumInfo) {
                    return enum_variants(c.types, e)[usize.(index)].payload
                }
                _ {
                    return none
                }
            }
        }
        none {
            return none
        }
    }
}

// `T.(value)`: construction, wrapping and numeric conversion.
fn construct_expr(input: Input, c: inout Checker, fx: inout Fx, start: u32, target: syntax.ExprId, value: syntax.ExprId, expected: ?TyId) -> Item ! OutOfMemory {
    var target_item: Item = Item.nothing
    let res: ?resolve.Res = expr_res(input, fx.file, target)
    if builtin_is(res, "some", "ok", "err") {
        match res_builtin(res) {
            some(value as name: []u8) {
                target_item = Item.builtin.(name: name)
            }
            none {
            }
        }
    } else {
        target_item = try check_expr(input, inout c, inout fx, target, none)
    }
    var ty: TyId = 0
    match target_item {
        type_item(ty as t: TyId) {
            ty = t
        }
        variant(ty as t: TyId, index: u32) {
            match variant_payload(c, t, index) {
                some(value as payload: TyId) {
                    let _: TyId = try check_expect(input, inout c, inout fx, value, payload)
                    try fresh(input, inout c, inout fx, value, payload)
                }
                none {
                }
            }
            return value_item(inout c, t)
        }
        builtin(name: []u8) {
            match name {
                "some", "ok", "err" {
                    return value_item(inout c, try construct_builtin(input, inout c, inout fx, start, name, value, expected))
                }
                _ {
                }
            }
            try report(inout c, fx.file, start, "only a type or a variant is built with `.(...)`")
            return error_item(inout c)
        }
        value(ty as t: TyId) {
            if is_error(c.types, t) {
                let _: TyId = try check_value(input, inout c, inout fx, value, none)
                return value_item(inout c, t)
            }
            try report(inout c, fx.file, start, "only a type or a variant is built with `.(...)`")
            return error_item(inout c)
        }
        nothing {
            try report(inout c, fx.file, start, "only a type or a variant is built with `.(...)`")
            return error_item(inout c)
        }
    }
    match get(c.types, ty) {
        int(int: _), float(bits: _) {
            try convert_number(input, inout c, inout fx, value, ty)
            return value_item(inout c, ty)
        }
        named(id: _) {
            var kind: u32 = 0
            var underlying: TyId = 0
            match info_of(c, ty) {
                some(value as info: NamedInfo) {
                    match info.def {
                        plain(underlying as u: TyId, pub_fields: _) {
                            kind = 1
                            underlying = u
                        }
                        enum_def(info as e: EnumInfo) {
                            match e.int {
                                some(value: _) {
                                    kind = 2
                                }
                                none {
                                }
                            }
                        }
                        union_def(fields: _) {
                        }
                    }
                }
                none {
                }
            }
            if kind == 1 {
                match try record_fields(input, c, ty, fx.file) {
                    some(value as fields: []RecordField) {
                        for let f: RecordField in fields {
                            if !f.visible {
                                let shown: []u8 = try show(inout c, ty)
                                try report(inout c, fx.file, start, try program.format_text(c.alloc, "`{shown}` cannot be built outside its package: field `{f.name}` is private"))
                                break
                            }
                        }
                    }
                    none {
                    }
                }
                let _: TyId = try check_expect(input, inout c, inout fx, value, underlying)
                try fresh(input, inout c, inout fx, value, underlying)
            } else if kind == 2 {
                // A checked conversion from an integer.
                let inner: syntax.ExprId = paren_inner(input, fx, value)
                let actual: TyId = try check_value(input, inout c, inout fx, inner, none)
                let from_int: bool = match int_core(c, actual) {
                    some(value: _) { true }
                    none { false }
                }
                if !from_int && !is_error(c.types, actual) {
                    let shown: []u8 = try show(inout c, ty)
                    try report(inout c, fx.file, start, try program.format_text(c.alloc, "`{shown}` converts only from an integer"))
                }
            } else {
                let shown: []u8 = try show(inout c, ty)
                try report(inout c, fx.file, start, try program.format_text(c.alloc, "`{shown}` is built from a variant, as in `{shown}.name`"))
            }
            return value_item(inout c, ty)
        }
        error {
            return value_item(inout c, ty)
        }
        _ {
            let shown: []u8 = try show(inout c, ty)
            try report(inout c, fx.file, start, try program.format_text(c.alloc, "`{shown}` cannot be built with `.(...)`"))
            return error_item(inout c)
        }
    }
}

fn construct_builtin(input: Input, c: inout Checker, fx: inout Fx, start: u32, name: []u8, value: syntax.ExprId, expected: ?TyId) -> TyId ! OutOfMemory {
    var field: []u8 = ""
    var payload_ty: TyId = 0
    var fits: bool = false
    match expected {
        some(value as want: TyId) {
            match get(c.types, want) {
                optional(elem: TyId) {
                    if program.bytes_equal(name, "some") {
                        field = "value"
                        payload_ty = elem
                        fits = true
                    }
                }
                result(value as v: ?TyId, error: TyId) {
                    if program.bytes_equal(name, "ok") {
                        match v {
                            some(value as t: TyId) {
                                field = "value"
                                payload_ty = t
                                fits = true
                            }
                            none {
                            }
                        }
                    } else if program.bytes_equal(name, "err") {
                        field = "error"
                        payload_ty = error
                        fits = true
                    }
                }
                error {
                    let _: TyId = try check_value(input, inout c, inout fx, value, none)
                    return error_ty(inout c.types)
                }
                _ {
                }
            }
        }
        none {
        }
    }
    if !fits {
        let what: []u8 = if program.bytes_equal(name, "some") { "an optional" } else { "a result" }
        var message: []u8 = ""
        match expected {
            some(value as want: TyId) {
                let shown: []u8 = try show(inout c, want)
                message = try program.format_text(c.alloc, "`{name}` builds {what}, but `{shown}` is expected here")
            }
            none {
                message = try program.format_text(c.alloc, "`{name}` needs a place that expects {what}")
            }
        }
        try report(inout c, fx.file, start, message)
        let _: TyId = try check_value(input, inout c, inout fx, value, none)
        return error_ty(inout c.types)
    }
    let payload: TyId = try single_field(inout c.types, field, payload_ty)
    let _: TyId = try check_expect(input, inout c, inout fx, value, payload)
    match expected {
        some(value as want: TyId) {
            return ok.(value: want)
        }
        none {
            return error_ty(inout c.types)
        }
    }
}

// The expression inside `.(...)`, for a form that takes one value.
fn paren_inner(input: Input, fx: Fx, value: syntax.ExprId) -> syntax.ExprId {
    let ast: syntax.Ast = input.program.files[usize.(fx.file)].ast
    return match ast.exprs[usize.(value)].kind {
        paren(inner: syntax.ExprId) { inner }
        _ { value }
    }
}

// `u64.(x)`: a numeric conversion.
fn convert_number(input: Input, c: inout Checker, fx: inout Fx, value: syntax.ExprId, target: TyId) -> ! OutOfMemory {
    let inner: syntax.ExprId = paren_inner(input, fx, value)
    if needs_context(input, c, fx, inner) {
        let _: TyId = try check_expect(input, inout c, inout fx, inner, target)
        return ok
    }
    let actual: TyId = try check_value(input, inout c, inout fx, inner, none)
    var numeric: bool = is_float(c, actual) || is_error(c.types, actual)
    match int_core(c, actual) {
        some(value: _) {
            numeric = true
        }
        none {
        }
    }
    match info_of(c, actual) {
        some(value as info: NamedInfo) {
            match info.def {
                plain(underlying: TyId, pub_fields: _) {
                    if is_float(c, underlying) {
                        numeric = true
                    }
                }
                enum_def(info as e: EnumInfo) {
                    match e.int {
                        some(value: _) {
                            numeric = true
                        }
                        none {
                        }
                    }
                }
                union_def(fields: _) {
                }
            }
        }
        none {
        }
    }
    if !numeric {
        let from: []u8 = try show(inout c, actual)
        let to: []u8 = try show(inout c, target)
        try report(inout c, fx.file, expr_span(input, fx, inner).start, try program.format_text(c.alloc, "cannot convert `{from}` to `{to}`"))
    }
    return ok
}

fn index_expr(input: Input, c: inout Checker, fx: inout Fx, value: syntax.ExprId, index: syntax.Index) -> TyId ! OutOfMemory {
    let base: TyId = try check_value(input, inout c, inout fx, value, none)
    var elem: TyId = base
    match get(c.types, base) {
        array(len: _, elem as e: TyId) {
            elem = e
        }
        view(elem as e: TyId) {
            elem = e
        }
        growable(elem as e: TyId) {
            elem = e
        }
        error {
        }
        _ {
            let shown: []u8 = try show(inout c, base)
            try report(inout c, fx.file, expr_span(input, fx, value).start, try program.format_text(c.alloc, "`{shown}` cannot be indexed"))
            elem = try error_ty(inout c.types)
        }
    }
    let size: TyId = try usize_ty(inout c.types)
    match index {
        value(value as i: syntax.ExprId) {
            let _: TyId = try check_expect(input, inout c, inout fx, i, size)
            return ok.(value: elem)
        }
        slice(start: ?syntax.ExprId, end: ?syntax.ExprId) {
            match start {
                some(value as s: syntax.ExprId) {
                    let _: TyId = try check_expect(input, inout c, inout fx, s, size)
                }
                none {
                }
            }
            match end {
                some(value as s: syntax.ExprId) {
                    let _: TyId = try check_expect(input, inout c, inout fx, s, size)
                }
                none {
                }
            }
            if is_error(c.types, elem) {
                return ok.(value: elem)
            }
            return intern(inout c.types, Ty.view.(elem: elem))
        }
        ty(ty as t: syntax.TypeId) {
            try report(inout c, fx.file, type_span(input, fx, t).start, "a type argument goes only on a built-in function, as in `truncate[u8](x)`")
            return error_ty(inout c.types)
        }
    }
}

fn unary_expr(input: Input, c: inout Checker, fx: inout Fx, start: u32, op: syntax.UnaryOp, operand: syntax.ExprId, expected: ?TyId) -> TyId ! OutOfMemory {
    let ast: syntax.Ast = input.program.files[usize.(fx.file)].ast
    match op {
        neg {
            match ast.exprs[usize.(operand)].kind {
                int {
                    var v: ?Wide = none
                    match parse_int(file_text(input, fx.file, expr_span(input, fx, operand))) {
                        some(value as n: Wide) {
                            v = some.(value: wide_neg(n))
                        }
                        none {
                        }
                    }
                    return int_with_value(inout c, fx, start, v, expected, "an integer literal")
                }
                _ {
                }
            }
            let ty: TyId = try check_value(input, inout c, inout fx, operand, expected)
            var fine: bool = is_float(c, ty) || is_error(c.types, ty)
            match as_int(c.types, ty) {
                some(value as int: IntTy) {
                    if int_signed(int) {
                        fine = true
                    }
                }
                none {
                }
            }
            if !fine {
                let shown: []u8 = try show(inout c, ty)
                try report(inout c, fx.file, start, try program.format_text(c.alloc, "`-` applies to signed integers and floats, not `{shown}`"))
            }
            return ok.(value: ty)
        }
        not {
            let b: TyId = try bool_ty(inout c.types)
            return check_expect(input, inout c, inout fx, operand, b)
        }
        bit_not {
            let ty: TyId = try check_value(input, inout c, inout fx, operand, expected)
            let is_int: bool = match as_int(c.types, ty) {
                some(value: _) { true }
                none { false }
            }
            if !is_int && !is_error(c.types, ty) {
                let shown: []u8 = try show(inout c, ty)
                try report(inout c, fx.file, start, try program.format_text(c.alloc, "`~` applies to integers, not `{shown}`"))
            }
            return ok.(value: ty)
        }
        address_of {
            var inner_expected: ?TyId = none
            match expected {
                some(value as t: TyId) {
                    match get(c.types, t) {
                        pointer(elem: TyId) {
                            inner_expected = some.(value: elem)
                        }
                        _ {
                        }
                    }
                }
                none {
                }
            }
            let path: []syntax.ExprId = try spine(c.alloc, input, fx, operand)
            for let e: syntax.ExprId in path {
                try mark(inout fx.addressed, u32.(e), 1)
            }
            let ty: TyId = try check_value(input, inout c, inout fx, operand, inner_expected)
            for let e: syntax.ExprId in path {
                try mark(inout fx.addressed, u32.(e), -1)
            }
            match place(input, c, fx, operand) {
                none {
                    try report(inout c, fx.file, start, "`&` takes a variable, field or element")
                }
                some(value: _) {
                }
            }
            return intern(inout c.types, Ty.pointer.(elem: ty))
        }
    }
}

fn try_item(input: Input, c: inout Checker, fx: inout Fx, start: u32, operand: syntax.ExprId) -> Item ! OutOfMemory {
    let ty: TyId = try check_value(input, inout c, inout fx, operand, none)
    match get(c.types, ty) {
        optional(elem: TyId) {
            var returns_optional: bool = false
            match fx.result {
                some(value as r: TyId) {
                    match get(c.types, r) {
                        optional(elem: _) {
                            returns_optional = true
                        }
                        _ {
                        }
                    }
                }
                none {
                }
            }
            if !returns_optional {
                try report(inout c, fx.file, start, "`try` on an optional needs a function that returns an optional")
            }
            return value_item(inout c, elem)
        }
        result(value: ?TyId, error: TyId) {
            var same: bool = false
            match fx.result {
                some(value as r: TyId) {
                    match get(c.types, r) {
                        result(value: _, error as own: TyId) {
                            same = same_ty(own, error)
                        }
                        _ {
                        }
                    }
                }
                none {
                }
            }
            if !same {
                var returns: []u8 = "nothing"
                match fx.result {
                    some(value as r: TyId) {
                        let shown: []u8 = try show(inout c, r)
                        returns = try program.format_text(c.alloc, "`{shown}`")
                    }
                    none {
                    }
                }
                let shown: []u8 = try show(inout c, error)
                try report(inout c, fx.file, start, try program.format_text(c.alloc, "`try` passes up a `{shown}` error, but this function returns {returns}"))
            }
            match value {
                some(value as v: TyId) {
                    return value_item(inout c, v)
                }
                none {
                    return ok.(value: Item.nothing)
                }
            }
        }
        error {
            return value_item(inout c, ty)
        }
        _ {
            let shown: []u8 = try show(inout c, ty)
            try report(inout c, fx.file, start, try program.format_text(c.alloc, "`try` takes an optional or a result, not `{shown}`"))
            return error_item(inout c)
        }
    }
}

// The type of two operands that must match. A literal takes the type of
// the other side.
fn operands(input: Input, c: inout Checker, fx: inout Fx, left: syntax.ExprId, right: syntax.ExprId, expected: ?TyId) -> TyId ! OutOfMemory {
    if needs_context(input, c, fx, left) && !needs_context(input, c, fx, right) {
        let ty: TyId = try check_value(input, inout c, inout fx, right, expected)
        let _: TyId = try check_expect(input, inout c, inout fx, left, ty)
        return ok.(value: ty)
    }
    let ty: TyId = try check_value(input, inout c, inout fx, left, expected)
    let _: TyId = try check_expect(input, inout c, inout fx, right, ty)
    return ok.(value: ty)
}

fn shift_amount(input: Input, c: inout Checker, fx: inout Fx, amount: syntax.ExprId, shifted: TyId) -> ! OutOfMemory {
    if needs_context(input, c, fx, amount) {
        let _: TyId = try check_expect(input, inout c, inout fx, amount, shifted)
        return ok
    }
    let ty: TyId = try check_value(input, inout c, inout fx, amount, none)
    let is_int: bool = match as_int(c.types, ty) {
        some(value: _) { true }
        none { false }
    }
    if !is_int && !is_error(c.types, ty) {
        let shown: []u8 = try show(inout c, ty)
        try report(inout c, fx.file, expr_span(input, fx, amount).start, try program.format_text(c.alloc, "a shift amount is an integer, not `{shown}`"))
    }
    return ok
}

fn binary_expr(input: Input, c: inout Checker, fx: inout Fx, start: u32, op: syntax.BinaryOp, left: syntax.ExprId, right: syntax.ExprId, expected: ?TyId) -> TyId ! OutOfMemory {
    let b: TyId = try bool_ty(inout c.types)
    let op_text: []u8 = syntax.op_text(op)
    match syntax.op_group(op) {
        and, or {
            let _: TyId = try check_expect(input, inout c, inout fx, left, b)
            let _: TyId = try check_expect(input, inout c, inout fx, right, b)
            return ok.(value: b)
        }
        comparison {
            let ty: TyId = try operands(input, inout c, inout fx, left, right, none)
            let equality: bool = op == syntax.BinaryOp.eq || op == syntax.BinaryOp.ne
            var fine: bool = false
            match get(c.types, ty) {
                int(int: _), float(bits: _), error, never {
                    fine = true
                }
                boolean, pointer(elem: _) {
                    fine = equality
                }
                named(id: _) {
                    if equality {
                        match info_of(c, ty) {
                            some(value as info: NamedInfo) {
                                match info.def {
                                    enum_def(info as e: EnumInfo) {
                                        fine = true
                                        for let v: Variant in enum_variants(c.types, e) {
                                            match v.payload {
                                                some(value: _) {
                                                    fine = false
                                                }
                                                none {
                                                }
                                            }
                                        }
                                    }
                                    _ {
                                    }
                                }
                            }
                            none {
                            }
                        }
                    }
                }
                _ {
                }
            }
            if !fine {
                let shown: []u8 = try show(inout c, ty)
                try report(inout c, fx.file, start, try program.format_text(c.alloc, "`{op_text}` does not apply to `{shown}`"))
            }
            return ok.(value: b)
        }
        shift {
            let ty: TyId = try check_value(input, inout c, inout fx, left, expected)
            try require_int(inout c, fx, start, op, ty)
            try shift_amount(input, inout c, inout fx, right, ty)
            return ok.(value: ty)
        }
        bit_and, bit_or, bit_xor {
            let ty: TyId = try operands(input, inout c, inout fx, left, right, expected)
            try require_int(inout c, fx, start, op, ty)
            return ok.(value: ty)
        }
        additive, multiplicative {
            let ty: TyId = try operands(input, inout c, inout fx, left, right, expected)
            let fine: bool = match get(c.types, ty) {
                int(int: _), float(bits: _), error, never { true }
                _ { false }
            }
            if !fine {
                let shown: []u8 = try show(inout c, ty)
                try report(inout c, fx.file, start, try program.format_text(c.alloc, "`{op_text}` does not apply to `{shown}`"))
            }
            return ok.(value: ty)
        }
    }
}

fn require_int(c: inout Checker, fx: Fx, start: u32, op: syntax.BinaryOp, ty: TyId) -> ! OutOfMemory {
    let fine: bool = match get(c.types, ty) {
        int(int: _), error, never { true }
        _ { false }
    }
    if !fine {
        let op_text: []u8 = syntax.op_text(op)
        let shown: []u8 = try show(inout c, ty)
        try report(inout c, fx.file, start, try program.format_text(c.alloc, "`{op_text}` applies to built-in integers, not `{shown}`"))
    }
    return ok
}

// Calls.

fn call_expr(input: Input, c: inout Checker, fx: inout Fx, start: u32, callee: syntax.ExprId, args: syntax.List, expected: ?TyId) -> Item ! OutOfMemory {
    let ast: syntax.Ast = input.program.files[usize.(fx.file)].ast
    try hidden_local(input, inout c, fx, callee)
    let list: []u32 = syntax.items(ast.extra, args)
    // A built-in with a type argument: truncate[u8](x).
    match ast.exprs[usize.(callee)].kind {
        index(value: syntax.ExprId, index as i: syntax.Index) {
            match res_builtin(expr_res(input, fx.file, value)) {
                some(value as name: []u8) {
                    if !resolve.is_builtin_type(name) {
                        return builtin_call(input, inout c, inout fx, start, name, some.(value: i), list, expected)
                    }
                }
                none {
                }
            }
        }
        _ {
        }
    }
    try unsafe_callee(input, inout c, fx, callee)
    try maps.put_int(inout fx.callees, u32.(callee), 1)
    match try check_expr(input, inout c, inout fx, callee, none) {
        builtin(name: []u8) {
            return builtin_call(input, inout c, inout fx, start, name, none, list, expected)
        }
        value(ty: TyId) {
            var target: TyId = ty
            match fn_underlying(c, ty) {
                some(value as u: TyId) {
                    target = u
                }
                none {
                }
            }
            match get(c.types, target) {
                function(params: Range, result: ?TyId) {
                    var values: [..]syntax.ExprId = make(c.alloc)
                    for let i: usize in 0..list.len {
                        try push(inout values, ast.args[usize.(list[i])].value)
                    }
                    try direct_call(input, inout c, fx, callee, values)
                    let ps: []FnParam = fn_params(c.types, params)
                    var modes: [..]ArgMode = make(c.alloc)
                    for let i: usize in 0..list.len {
                        if i < ps.len {
                            try push(inout modes, ArgMode.(e: ast.args[usize.(list[i])].value, mode: ps[i].mode))
                        }
                    }
                    try exclusive(input, inout c, fx, modes)
                    if ps.len != list.len {
                        let want: usize = ps.len
                        let got: usize = list.len
                        try report(inout c, fx.file, start, try program.format_text(c.alloc, "expected {want} arguments, found {got}"))
                    }
                    for let i: usize in 0..list.len {
                        let arg: syntax.Arg = ast.args[usize.(list[i])]
                        if i < ps.len {
                            try argument(input, inout c, inout fx, arg, ps[i].mode, ps[i].ty)
                        } else {
                            let _: TyId = try check_value(input, inout c, inout fx, arg.value, none)
                        }
                    }
                    match result {
                        some(value as r: TyId) {
                            return value_item(inout c, r)
                        }
                        none {
                            return ok.(value: Item.nothing)
                        }
                    }
                }
                error {
                    for let i: u32 in list {
                        let arg_value: syntax.ExprId = ast.args[usize.(i)].value
            let _: TyId = try check_value(input, inout c, inout fx, arg_value, none)
                    }
                    return value_item(inout c, ty)
                }
                _ {
                    let shown: []u8 = try show(inout c, ty)
                    try report(inout c, fx.file, start, try program.format_text(c.alloc, "`{shown}` is not a function"))
                    return error_item(inout c)
                }
            }
        }
        type_item(ty: TyId) {
            let shown: []u8 = try show(inout c, ty)
            try report(inout c, fx.file, start, try program.format_text(c.alloc, "build a `{shown}` with `{shown}.(...)`, not a call"))
            return error_item(inout c)
        }
        variant(ty: TyId, index: _) {
            return value_item(inout c, ty)
        }
        nothing {
            return error_item(inout c)
        }
    }
}

fn argument(input: Input, c: inout Checker, fx: inout Fx, arg: syntax.Arg, mode: syntax.Mode, param: TyId) -> ! OutOfMemory {
    let start: u32 = expr_span(input, fx, arg.value).start
    if arg.mode != mode {
        let message: []u8 = match mode {
            inout_mode { "this parameter is `inout`; write `inout` before the argument" }
            let_mode { "this parameter is not `inout`; remove `inout`" }
        }
        try report(inout c, fx.file, start, message)
    }
    if mode == syntax.Mode.inout_mode {
        let ty: TyId = try check_value(input, inout c, inout fx, arg.value, none)
        if !is_error(c.types, ty) && !is_error(c.types, param) && !same_ty(ty, param) {
            let want: []u8 = try show(inout c, param)
            let got: []u8 = try show(inout c, ty)
            try report(inout c, fx.file, start, try program.format_text(c.alloc, "expected `{want}`, found `{got}`"))
        }
        try require_mutable(input, inout c, fx, arg.value, "pass `inout`")
        try writes(input, inout c, fx, arg.value)
    } else {
        let _: TyId = try check_expect(input, inout c, inout fx, arg.value, param)
    }
    return ok
}

// A type argument: u8 in `truncate[u8]`, *u32 in `from_address[*u32]`.
fn type_arg(input: Input, c: inout Checker, fx: inout Fx, index: syntax.Index) -> TyId ! OutOfMemory {
    match index {
        ty(ty as t: syntax.TypeId) {
            return lower(input, inout c, fx.file, t)
        }
        value(value as e: syntax.ExprId) {
            match try check_expr(input, inout c, inout fx, e, none) {
                type_item(ty: TyId) {
                    return ok.(value: ty)
                }
                _ {
                    try report(inout c, fx.file, expr_span(input, fx, e).start, "expected a type argument")
                    return error_ty(inout c.types)
                }
            }
        }
        slice(start: _, end: _) {
            return error_ty(inout c.types)
        }
    }
}

// A call to a built-in function while a local function value has its
// name: the call means the built-in, which a reader could miss.
fn hidden_local(input: Input, c: inout Checker, fx: Fx, callee: syntax.ExprId) -> ! OutOfMemory {
    let ast: syntax.Ast = input.program.files[usize.(fx.file)].ast
    var name_expr: syntax.ExprId = callee
    match ast.exprs[usize.(callee)].kind {
        index(value: syntax.ExprId, index: _) {
            name_expr = value
        }
        _ {
        }
    }
    match ast.exprs[usize.(name_expr)].kind {
        name(name as n: syntax.Span) {
            match maps.get_int(input.names.files[usize.(fx.file)].hidden_locals, n.start) {
                some(value as id: u32) {
                    match local_info(fx, id) {
                        some(value as info: LocalInfo) {
                            var is_fn: bool = false
                            match get(c.types, info.ty) {
                                function(params: _, result: _) {
                                    is_fn = true
                                }
                                _ {
                                }
                            }
                            match fn_underlying(c, info.ty) {
                                some(value: _) {
                                    is_fn = true
                                }
                                none {
                                }
                            }
                            if is_fn {
                                let text: []u8 = file_text(input, fx.file, n)
                                try report(inout c, fx.file, n.start, try program.format_text(c.alloc, "this calls the built-in `{text}`, not the local function value `{text}`; rename the local"))
                            }
                        }
                        none {
                        }
                    }
                }
                none {
                }
            }
        }
        _ {
        }
    }
    return ok
}

fn args_values(input: Input, c: inout Checker, fx: inout Fx, list: []u32) -> ! OutOfMemory {
    let ast: syntax.Ast = input.program.files[usize.(fx.file)].ast
    for let i: u32 in list {
        let arg_value: syntax.ExprId = ast.args[usize.(i)].value
            let _: TyId = try check_value(input, inout c, inout fx, arg_value, none)
    }
    return ok
}

fn builtin_arity(name: []u8) -> usize {
    return match name {
        "make", "panic", "from_address", "cast", "truncate", "c_string" { 1 }
        "volatile_load", "fill", "free", "take", "pop", "clear" { 1 }
        _ { 2 }
    }
}

fn builtin_call(input: Input, c: inout Checker, fx: inout Fx, start: u32, name: []u8, type_index: ?syntax.Index, list: []u32, expected: ?TyId) -> Item ! OutOfMemory {
    let ast: syntax.Ast = input.program.files[usize.(fx.file)].ast
    match name {
        "volatile_load", "volatile_store", "from_pointer" {
            try require_unsafe(inout c, fx, start, try program.format_text(c.alloc, "`{name}`"))
        }
        _ {
        }
    }
    let wants_type_arg: bool = match name {
        "fill", "from_address", "cast", "truncate" { true }
        _ { false }
    }
    let has_type_arg: bool = match type_index {
        some(value: _) { true }
        none { false }
    }
    if wants_type_arg != has_type_arg {
        if wants_type_arg {
            try report(inout c, fx.file, start, try program.format_text(c.alloc, "`{name}` takes a type argument, as in `{name}[T](...)`"))
        } else {
            try report(inout c, fx.file, start, try program.format_text(c.alloc, "`{name}` takes no type argument"))
        }
        try args_values(input, inout c, inout fx, list)
        return error_item(inout c)
    }
    let arity: usize = builtin_arity(name)
    if list.len != arity {
        let found: usize = list.len
        try report(inout c, fx.file, start, try program.format_text(c.alloc, "`{name}` takes {arity} arguments, found {found}"))
        try args_values(input, inout c, inout fx, list)
        return error_item(inout c)
    }
    var modes: [2]syntax.Mode = [syntax.Mode.let_mode, syntax.Mode.let_mode]
    match name {
        "push", "append", "pop", "clear", "free", "take" {
            modes[0] = syntax.Mode.inout_mode
        }
        _ {
        }
    }
    for let i: usize in 0..list.len {
        let arg: syntax.Arg = ast.args[usize.(list[i])]
        if arg.mode != modes[i] {
            let mode: []u8 = match modes[i] {
                let_mode { "no mode" }
                inout_mode { "`inout`" }
            }
            try report(inout c, fx.file, expr_span(input, fx, arg.value).start, try program.format_text(c.alloc, "this argument of `{name}` takes {mode}"))
        }
    }
    let a: syntax.ExprId = ast.args[usize.(list[0])].value
    var second: syntax.ExprId = a
    if list.len > 1 {
        second = ast.args[usize.(list[1])].value
    }
    let size: TyId = try usize_ty(inout c.types)
    let oom: TyId = try named_type(input, inout c, NamedId.builtin.(which: BuiltinNamed.out_of_memory))
    let oom_result: TyId = try intern(inout c.types, Ty.result.(value: none, error: oom))
    match name {
        "panic" {
            let format: TyId = try named_type(input, inout c, NamedId.builtin.(which: BuiltinNamed.format))
            let _: TyId = try check_expect(input, inout c, inout fx, a, format)
            return value_item(inout c, try never_ty(inout c.types))
        }
        "make" {
            let allocator: TyId = try named_type(input, inout c, NamedId.builtin.(which: BuiltinNamed.allocator))
            let _: TyId = try check_expect(input, inout c, inout fx, a, allocator)
            match expected {
                some(value as want: TyId) {
                    match get(c.types, want) {
                        growable(elem: _), error {
                            return value_item(inout c, want)
                        }
                        _ {
                        }
                    }
                }
                none {
                }
            }
            try report(inout c, fx.file, start, "`make` needs a place that expects a `[..]T`")
            return error_item(inout c)
        }
        "push", "append" {
            let pair: [2]ArgMode = [ArgMode.(e: a, mode: syntax.Mode.inout_mode), ArgMode.(e: second, mode: syntax.Mode.let_mode)]
            try exclusive(input, inout c, fx, pair)
            let v: TyId = try check_value(input, inout c, inout fx, a, none)
            try require_mutable(input, inout c, fx, a, "pass `inout`")
            try writes(input, inout c, fx, a)
            match get(c.types, v) {
                growable(elem: TyId) {
                    if program.bytes_equal(name, "push") {
                        let _: TyId = try check_expect(input, inout c, inout fx, second, elem)
                        try fresh(input, inout c, inout fx, second, elem)
                    } else {
                        let view: TyId = try intern(inout c.types, Ty.view.(elem: elem))
                        let _: TyId = try check_expect(input, inout c, inout fx, second, view)
                        try no_owning_copy(inout c, fx.file, start, "append", elem)
                    }
                }
                error {
                }
                _ {
                    let shown: []u8 = try show(inout c, v)
                    try report(inout c, fx.file, expr_span(input, fx, a).start, try program.format_text(c.alloc, "`{name}` takes a `[..]T`, not `{shown}`"))
                }
            }
            return value_item(inout c, oom_result)
        }
        "pop", "clear" {
            let v: TyId = try check_value(input, inout c, inout fx, a, none)
            try require_mutable(input, inout c, fx, a, "pass `inout`")
            try writes(input, inout c, fx, a)
            match get(c.types, v) {
                growable(elem: TyId) {
                    if program.bytes_equal(name, "pop") {
                        return value_item(inout c, try intern(inout c.types, Ty.optional.(elem: elem)))
                    }
                    return ok.(value: Item.nothing)
                }
                error {
                    return error_item(inout c)
                }
                _ {
                    let shown: []u8 = try show(inout c, v)
                    try report(inout c, fx.file, expr_span(input, fx, a).start, try program.format_text(c.alloc, "`{name}` takes a `[..]T`, not `{shown}`"))
                    return error_item(inout c)
                }
            }
        }
        "free", "take" {
            let v: TyId = try check_value(input, inout c, inout fx, a, none)
            try require_mutable(input, inout c, fx, a, "pass `inout`")
            try writes(input, inout c, fx, a)
            let growable: bool = match get(c.types, v) {
                growable(elem: _), error { true }
                _ { false }
            }
            if program.bytes_equal(name, "free") {
                if !growable {
                    let shown: []u8 = try show(inout c, v)
                    try report(inout c, fx.file, expr_span(input, fx, a).start, try program.format_text(c.alloc, "`free` takes a `[..]T`, not `{shown}`"))
                }
                return ok.(value: Item.nothing)
            }
            if is_error(c.types, v) {
                return value_item(inout c, v)
            }
            let astart: u32 = expr_span(input, fx, a).start
            if !(try owning(inout c, v)) {
                let shown: []u8 = try show(inout c, v)
                try report(inout c, fx.file, astart, try program.format_text(c.alloc, "`take` takes a value that owns a buffer, not `{shown}`"))
                return error_item(inout c)
            }
            if !(try emptiable(inout c, v)) {
                let shown: []u8 = try show(inout c, v)
                try report(inout c, fx.file, astart, try program.format_text(c.alloc, "`take` cannot leave a `{shown}` empty: only a `[..]T`, an optional, and records and tuples of them have an empty value"))
            }
            return value_item(inout c, v)
        }
        "copy" {
            let allocator: TyId = try named_type(input, inout c, NamedId.builtin.(which: BuiltinNamed.allocator))
            let _: TyId = try check_expect(input, inout c, inout fx, a, allocator)
            let v: TyId = try check_value(input, inout c, inout fx, second, none)
            var elem: ?TyId = none
            match get(c.types, v) {
                growable(elem as e: TyId) {
                    elem = some.(value: e)
                }
                view(elem as e: TyId) {
                    elem = some.(value: e)
                }
                array(len: _, elem as e: TyId) {
                    elem = some.(value: e)
                }
                error {
                    return value_item(inout c, v)
                }
                _ {
                }
            }
            match elem {
                some(value as e: TyId) {
                    try no_owning_copy(inout c, fx.file, start, "copy", e)
                    let g: TyId = try intern(inout c.types, Ty.growable.(elem: e))
                    return value_item(inout c, try intern(inout c.types, Ty.result.(value: some.(value: g), error: oom)))
                }
                none {
                    let shown: []u8 = try show(inout c, v)
                    try report(inout c, fx.file, start, try program.format_text(c.alloc, "`copy` takes an array, view or `[..]T`, not `{shown}`"))
                    return error_item(inout c)
                }
            }
        }
        "fill" {
            var len: syntax.ExprId = a
            var has_len: bool = false
            match type_index {
                some(value as i: syntax.Index) {
                    match i {
                        value(value as e: syntax.ExprId) {
                            len = e
                            has_len = true
                        }
                        _ {
                        }
                    }
                }
                none {
                }
            }
            if !has_len {
                try report(inout c, fx.file, start, "`fill` takes a length, as in `fill[16](0)`")
                return error_item(inout c)
            }
            var n: u64 = 0
            var valid: bool = false
            match const_int(input, c, fx.file, len, 0) {
                some(value as w: Wide) {
                    if !wide_negative(w) {
                        match wide_u64(w) {
                            some(value as count: u64) {
                                n = count
                                valid = true
                            }
                            none {
                            }
                        }
                    }
                }
                none {
                }
            }
            if !valid {
                try report(inout c, fx.file, expr_span(input, fx, len).start, "`fill`'s length is a constant, non-negative integer")
                return error_item(inout c)
            }
            var elem: TyId = 0
            var known: bool = false
            match expected {
                some(value as want: TyId) {
                    match get(c.types, want) {
                        array(len as count: u64, elem as e: TyId) {
                            let _: TyId = try check_expect(input, inout c, inout fx, a, e)
                            if count != n {
                                try report(inout c, fx.file, start, try program.format_text(c.alloc, "expected {count} elements, found {n}"))
                                return error_item(inout c)
                            }
                            elem = e
                            known = true
                        }
                        _ {
                        }
                    }
                }
                none {
                }
            }
            if !known {
                elem = try check_value(input, inout c, inout fx, a, none)
            }
            return value_item(inout c, try intern(inout c.types, Ty.array.(len: n, elem: elem)))
        }
        "from_address" {
            var target: TyId = 0
            match type_index {
                some(value as i: syntax.Index) {
                    target = try type_arg(input, inout c, inout fx, i)
                }
                none {
                }
            }
            let _: TyId = try check_expect(input, inout c, inout fx, a, size)
            let fine: bool = match get(c.types, target) {
                pointer(elem: _), error { true }
                _ { false }
            }
            if !fine {
                let shown: []u8 = try show(inout c, target)
                try report(inout c, fx.file, start, try program.format_text(c.alloc, "`from_address` makes a pointer, not `{shown}`"))
            }
            return value_item(inout c, target)
        }
        "cast", "truncate" {
            var target: TyId = 0
            match type_index {
                some(value as i: syntax.Index) {
                    target = try type_arg(input, inout c, inout fx, i)
                }
                none {
                }
            }
            let v: TyId = try check_value(input, inout c, inout fx, a, none)
            if program.bytes_equal(name, "truncate") {
                let target_int: bool = match as_int(c.types, target) {
                    some(value: _) { true }
                    none { false }
                }
                let value_int: bool = match as_int(c.types, v) {
                    some(value: _) { true }
                    none { is_error(c.types, v) }
                }
                if !(target_int && value_int) && !is_error(c.types, target) {
                    let from: []u8 = try show(inout c, v)
                    let to: []u8 = try show(inout c, target)
                    try report(inout c, fx.file, start, try program.format_text(c.alloc, "`truncate` converts between integers, not `{from}` to `{to}`"))
                }
            }
            return value_item(inout c, target)
        }
        "from_pointer", "offset" {
            let p: TyId = try check_value(input, inout c, inout fx, a, none)
            let _: TyId = try check_expect(input, inout c, inout fx, second, size)
            match get(c.types, p) {
                pointer(elem: TyId) {
                    if program.bytes_equal(name, "from_pointer") {
                        return value_item(inout c, try intern(inout c.types, Ty.view.(elem: elem)))
                    }
                    return value_item(inout c, p)
                }
                error {
                    return value_item(inout c, p)
                }
                _ {
                    let shown: []u8 = try show(inout c, p)
                    try report(inout c, fx.file, expr_span(input, fx, a).start, try program.format_text(c.alloc, "`{name}` takes a pointer, not `{shown}`"))
                    return error_item(inout c)
                }
            }
        }
        "c_string" {
            var plain: bool = false
            match ast.exprs[usize.(a)].kind {
                str(parts: syntax.List) {
                    plain = true
                    for let i: u32 in syntax.items(ast.extra, parts) {
                        match ast.str_parts[usize.(i)] {
                            interpolation(value: _) {
                                plain = false
                            }
                            text(span: _) {
                            }
                        }
                    }
                }
                _ {
                }
            }
            if !plain {
                try report(inout c, fx.file, expr_span(input, fx, a).start, "`c_string` takes a string literal without interpolation")
            }
            let byte_ty: TyId = try int_ty(inout c.types, IntTy.u8)
            return value_item(inout c, try intern(inout c.types, Ty.pointer.(elem: byte_ty)))
        }
        "volatile_load", "volatile_store" {
            let p: TyId = try check_value(input, inout c, inout fx, a, none)
            var elem: TyId = p
            match get(c.types, p) {
                pointer(elem as e: TyId) {
                    elem = e
                }
                error {
                }
                _ {
                    let shown: []u8 = try show(inout c, p)
                    try report(inout c, fx.file, expr_span(input, fx, a).start, try program.format_text(c.alloc, "`{name}` takes a pointer, not `{shown}`"))
                    elem = try error_ty(inout c.types)
                }
            }
            if program.bytes_equal(name, "volatile_store") {
                let _: TyId = try check_expect(input, inout c, inout fx, second, elem)
                return ok.(value: Item.nothing)
            }
            return value_item(inout c, elem)
        }
        _ {
            // wrapping_add and its relatives.
            let ty: TyId = try operands(input, inout c, inout fx, a, second, expected)
            let fine: bool = match get(c.types, ty) {
                int(int: _), error { true }
                _ { false }
            }
            if !fine {
                let shown: []u8 = try show(inout c, ty)
                try report(inout c, fx.file, start, try program.format_text(c.alloc, "`{name}` takes built-in integers, not `{shown}`"))
            }
            return value_item(inout c, ty)
        }
    }
}
